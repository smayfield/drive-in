{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "App",
      "folder": "Drive-In",
      "interval": "1m",
      "rules": [
        {
          "uid": "app-silent",
          "title": "App stopped reporting",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "count(dotnet_process_memory_working_set_bytes{service_name=\"drive-in-web\"})",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "The web app hasn't sent metrics for 5 minutes: it's down, restarting in a loop, or can't reach VictoriaMetrics.",
            "description": "Check `docker compose ps web` and `docker compose logs web` in /opt/drive-in over SSM."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "app-5xx",
          "title": "Server errors (5xx)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "(sum(increase(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[10m])) / sum(increase(http_server_request_duration_seconds_count[10m]))) and on() sum(increase(http_server_request_duration_seconds_count[10m])) >= 20",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "More than 5% of requests failed with a 5xx in the last 10 minutes.",
            "description": "See Drive-In: Site performance → 5xx by route, then `docker compose logs web`."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "app-latency",
          "title": "Slow responses",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/_blazor.*\"}[10m])))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "95th percentile response time has been over 2 seconds for 10 minutes.",
            "description": "See Drive-In: Site performance → Slowest routes and Database query time; check CPU and memory on Drive-In: Server."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "app-errors",
          "title": "Errors logged",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "sum(increase(drivein_errors_logged_total[5m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        10
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "More than 10 errors were logged in 5 minutes.",
            "description": "See Drive-In: Site performance → Errors logged for which part of the app, then `docker compose logs web`."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "app-critical",
          "title": "Critical error logged",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "sum(increase(drivein_errors_logged_total{level=\"critical\"}[5m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "The app logged a critical error.",
            "description": "`docker compose logs web` in /opt/drive-in over SSM."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "email-failures",
          "title": "Emails failing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "sum(increase(drivein_emails_total{result=\"failed\"}[15m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "An email (receipt, invite, invoice or account email) couldn't be sent in the last 15 minutes.",
            "description": "Usually SES: check its sending status and suppression list. The app logs \"Couldn't send email\" with the subject."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "job-failures",
          "title": "Background job failing",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "sum by (job) (increase(drivein_jobs_failures_total[15m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A background job (hold expiry, billing drafts, geocoding or business gauges) failed in the last 15 minutes.",
            "description": "The `job` label says which. Logs: `docker compose logs web`."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "payment-errors",
          "title": "Payment processor errors",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "victoriametrics",
              "model": {
                "refId": "A",
                "expr": "sum(increase(drivein_payments_total{result=\"error\"}[15m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A card charge failed with an error (not a decline) in the last 15 minutes.",
            "description": "The payment processor may be down or misconfigured; buyers can't pay."
          },
          "labels": {
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "payment-stuck",
          "title": "Payment stuck unsettled",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "drivein-db",
              "model": {
                "refId": "A",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table",
                "rawSql": "SELECT (SELECT count(*) FROM tickets WHERE status = 'Paying' AND payment_started_at < now() - interval '45 minutes') + (SELECT count(*) FROM gift_card_purchases WHERE status = 'Paying' AND started_at < now() - interval '45 minutes') AS stuck"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A ticket or gift card purchase has waited over 45 minutes for its payment to be settled.",
            "description": "The reconciler gives up on charges the processor doesn't know after 30 minutes, so this is one the processor still calls pending, or the reconciler isn't running (see Background job failures). Check the charge in the processor's dashboard by its payment key (tickets.payment_key, or giftcard-{id})."
          },
          "labels": {
            "severity": "warning"
          },
          "isPaused": false
        },
        {
          "uid": "go-live-waiting",
          "title": "Go-live request waiting over a day",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "drivein-db",
              "model": {
                "refId": "A",
                "rawQuery": true,
                "editorMode": "code",
                "format": "table",
                "rawSql": "SELECT count(*) AS waiting FROM theaters WHERE mode = 'Demo' AND go_live_requested_at < now() - interval '24 hours'"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "A theater has been waiting more than 24 hours for an admin to approve going live.",
            "description": "Admin → Theaters to activate or decline it."
          },
          "labels": {
            "severity": "info"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
