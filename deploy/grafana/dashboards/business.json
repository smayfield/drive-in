    {
      "id": 14,
      "type": "stat",
      "title": "Owed to us",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "drivein-db"
      },
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drivein-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(i.total), 0) - coalesce((SELECT sum(p.amount) FROM invoice_payments p JOIN invoices i2 ON i2.id = p.invoice_id WHERE i2.status = 'Issued'), 0) FROM invoices i WHERE i.status = 'Issued'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              }
            ]
          },
