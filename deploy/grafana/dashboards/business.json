          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(t.sold_at, '1d'), CASE WHEN t.is_comp THEN 'free admission' WHEN t.sold_at_gate THEN 'gate' ELSE 'online' END AS metric, count(*) AS value FROM tickets t WHERE t.status = 'Sold' AND NOT t.is_test AND $__timeFilter(t.sold_at) GROUP BY 1, 2 ORDER BY 1"
        }
