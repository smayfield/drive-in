    {
      "id": 19,
      "type": "timeseries",
      "title": "Theaters over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "drivein-db"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
