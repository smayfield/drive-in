          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(t.sold_at, '1d'), CASE WHEN t.is_comp THEN 'free admission' WHEN t.sold_at_gate THEN 'gate' ELSE 'online' END AS metric, sum(t.total) AS value FROM tickets t WHERE t.status = 'Sold' AND NOT t.is_test AND NOT t.is_comp AND $__timeFilter(t.sold_at) GROUP BY 1, 2 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drivein-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(purchased_at, '1d'), 'gift cards' AS metric, sum(initial_amount) AS value FROM gift_cards WHERE NOT is_test AND $__timeFilter(purchased_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
