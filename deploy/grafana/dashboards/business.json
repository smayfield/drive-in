      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drivein-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT th.name AS \"Theater\", th.mode AS \"Mode\", count(*) FILTER (WHERE NOT t.is_comp) AS \"Tickets\", count(*) FILTER (WHERE t.is_comp) AS \"Free\", count(t.admitted_at) AS \"Admitted\", sum(t.total) AS \"Revenue\" FROM tickets t JOIN showtimes s ON s.id = t.showtime_id JOIN screens sc ON sc.id = s.screen_id JOIN theaters th ON th.id = sc.theater_id WHERE t.status = 'Sold' AND NOT t.is_test AND $__timeFilter(t.sold_at) GROUP BY th.id, th.name, th.mode ORDER BY \"Revenue\" DESC, \"Tickets\" DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
