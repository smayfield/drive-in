    {
      "id": 21,
      "type": "table",
      "title": "Top theaters by sales (time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "drivein-db"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
