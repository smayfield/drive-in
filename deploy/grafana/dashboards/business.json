      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drivein-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(d, '1d'), 'signed up (all)' AS metric, (SELECT count(*) FROM theaters WHERE created_at <= d + interval '1 day') AS value FROM generate_series(date_trunc('day', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 day') d ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drivein-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(d, '1d'), 'live' AS metric, (SELECT count(*) FROM theaters WHERE live_since <= d + interval '1 day' AND mode = 'Live') AS value FROM generate_series(date_trunc('day', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 day') d ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
