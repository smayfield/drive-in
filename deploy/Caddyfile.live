# Live: the app serves the apex. Caddy gets and renews Let's Encrypt certificates,
# redirects HTTP to HTTPS, sets X-Forwarded-* headers, and proxies Blazor's WebSockets.
{
	# Request counts, durations and status codes for every site (served on :2020 below).
	metrics
}

drive-in.online {
	encode zstd gzip
	# Grafana, for site admins only. Each request first asks the app (/ops/grafana-auth): admins get a 200 with
	# their email in X-WEBAUTH-USER, which Grafana's auth proxy signs them in as; anyone else gets the app's answer
	# (a redirect to sign in, or 403). Caddy drops any X-WEBAUTH-USER the client sent before copying the app's.
	@grafana path /grafana /grafana/*
	handle @grafana {
		forward_auth web:8080 {
			uri /ops/grafana-auth
			copy_headers X-WEBAUTH-USER
		}
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy web:8080
	}
}

www.drive-in.online, app.drive-in.online {
	redir https://drive-in.online{uri} permanent
}

# Caddy's Prometheus metrics, scraped by VictoriaMetrics. Port 2020 isn't published on the host.
:2020 {
	metrics
}
