# Staging (ServeApex=false): only app.drive-in.online is served (and only it gets a certificate), e.g. to
# bring up a replacement server without taking over the domain.
{
	# Request counts, durations and status codes for every site (served on :2020 below).
	metrics
}

# The web app's upstream: whichever copy (web-blue or web-green) deploy.sh last switched to, named in the file
# "upstream" next to this one (`to web-<color>:8080`). Caddy checks it every 5 s with /healthz (Host: localhost, which
# the app's AllowedHosts accepts) and stops sending requests after 3 failures in a row. On a reload (each deploy
# switches colors with one), WebSockets already open (Blazor circuits) stay on the old copy for up to 5 minutes instead
# of being cut at once; deploy.sh stops the old copy sooner, after its drain time.
(web) {
	import upstream
	health_uri /healthz
	health_interval 5s
	health_timeout 3s
	health_fails 3
	health_headers {
		Host localhost
	}
	stream_close_delay 5m
}

app.drive-in.online {
	encode zstd gzip
	# Grafana, for site admins only. Each request first asks the app (/ops/grafana-auth): admins get a 200 with
	# their email in X-WEBAUTH-USER, which Grafana's auth proxy signs them in as; anyone else gets the app's answer
	# (a redirect to sign in, or 403). Any X-WEBAUTH-USER the client sent is removed first (route keeps this order;
	# copy_headers also drops it, but this doesn't rely on that).
	@grafana path /grafana /grafana/*
	handle @grafana {
		route {
			request_header -X-WEBAUTH-USER
			forward_auth {
				import web
				uri /ops/grafana-auth
				copy_headers X-WEBAUTH-USER
			}
			reverse_proxy grafana:3000
		}
	}
	handle {
		reverse_proxy {
			import web
		}
	}
}

# Caddy's Prometheus metrics, scraped by VictoriaMetrics. Port 2020 isn't published on the host.
:2020 {
	metrics
}
