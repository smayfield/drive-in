@* Choosing a ticket option and add-ons, with the running total. The service recomputes the price when selling. *@

<fieldset class="mb-3 border-0 p-0">
    <legend class="mud-typography mud-typography-h6">Ticket</legend>
    <MudRadioGroup T="int" Value="OptionId" ValueChanged="SetOptionAsync">
        @foreach (var o in Prices.Options)
        {
            <MudRadio Value="@o.Id" Color="Color.Primary" Class="w-100 tc-line">
                <span class="d-flex justify-content-between gap-3 tc-label">
                    <span>@o.Name @if (o.Description is not null) { <span class="muted small ms-1">— @o.Description</span> }</span>
                    <span>@Money.Format(o.Price)</span>
                </span>
            </MudRadio>
        }
    </MudRadioGroup>
</fieldset>

@if (AddOns.Count > 0)
{
    <fieldset class="mb-3 border-0 p-0">
        <legend class="mud-typography mud-typography-h6">Add-ons</legend>
        @foreach (var a in AddOns)
        {
            <MudCheckBox T="bool" Value="AddOnIds.Contains(a.Id)" ValueChanged="() => ToggleAsync(a.Id)" Color="Color.Primary" Class="w-100 tc-line">
                <span class="d-flex justify-content-between gap-3 tc-label">
                    <span>@a.Name @if (a.Description is not null) { <span class="muted small ms-1">— @a.Description</span> }</span>
                    <span>@a.Display</span>
                </span>
            </MudCheckBox>
        }
    </fieldset>
}

@if (Quote(Prices, AddOns, OptionId, AddOnIds) is TicketQuote quote)
{
    <MudSimpleTable Dense Class="mb-3" Style="box-shadow: none; background: transparent">
        <tbody>
            <tr><td>@quote.Option.Name</td><td class="text-end">@Money.Format(quote.Option.Price)</td></tr>
            @foreach (var line in quote.Lines)
            {
                <tr><td>@line.AddOn.Name</td><td class="text-end">@TicketReceipt.SignedMoney(line.Effect)</td></tr>
            }
            <tr class="fw-bold"><td>Total</td><td class="text-end">@Money.Format(quote.Total)</td></tr>
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter, EditorRequired] public PriceSchedule Prices { get; set; } = default!;
    [Parameter, EditorRequired] public List<AddOn> AddOns { get; set; } = [];
    // Both two-way bound (@bind-OptionId, @bind-AddOnIds), so the parent re-renders its total and pay button.
    [Parameter] public int OptionId { get; set; }
    [Parameter] public EventCallback<int> OptionIdChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlySet<int> AddOnIds { get; set; } = new HashSet<int>();
    [Parameter] public EventCallback<IReadOnlySet<int>> AddOnIdsChanged { get; set; }

    public static TicketQuote? Quote(PriceSchedule prices, IEnumerable<AddOn> addOns, int optionId, IReadOnlySet<int> addOnIds) =>
        prices.Options.FirstOrDefault(o => o.Id == optionId) is PriceOption option
            ? TicketQuote.For(option, addOns.Where(a => addOnIds.Contains(a.Id)))
            : null;

    private Task SetOptionAsync(int id) => OptionIdChanged.InvokeAsync(id);

    private Task ToggleAsync(int id)
    {
        var ids = AddOnIds.ToHashSet();
        if (!ids.Remove(id))
            ids.Add(id);
        return AddOnIdsChanged.InvokeAsync(ids);
    }
}
