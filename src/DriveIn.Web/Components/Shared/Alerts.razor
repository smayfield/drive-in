@if (!string.IsNullOrEmpty(Error))
{
    <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@Error</MudAlert>
}
@if (!string.IsNullOrEmpty(Success))
{
    <MudAlert Severity="Severity.Success" Class="mb-3" role="status">@Success</MudAlert>
}

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Success { get; set; }
}
