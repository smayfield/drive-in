@* Profile inputs shared by the owner and admin theater forms. Place inside an EditForm. *@

<MudGrid Spacing="2">
    <MudItem xs="12" md="8">
        <MudTextField T="string" @bind-Value="Model.Name" For="() => Model.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudTextField T="string" @bind-Value="Model.TimeZone" Label="Time zone" Placeholder="America/Chicago" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="Model.AddressLine1" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="Model.AddressLine2" Label="Address line 2" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudTextField T="string" @bind-Value="Model.City" Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MudTextField T="string" @bind-Value="Model.State" Label="State" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="6" md="2">
        <MudTextField T="string" @bind-Value="Model.PostalCode" Label="Postal code" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="3">
        <MudTextField T="string" @bind-Value="Model.Country" Label="Country" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MudNumericField T="double?" @bind-Value="Model.Latitude" For="() => Model.Latitude" Label="Latitude" Min="-90" Max="90" HideSpinButtons
                         Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="6" md="3">
        <MudNumericField T="double?" @bind-Value="Model.Longitude" For="() => Model.Longitude" Label="Longitude" Min="-180" Max="180" HideSpinButtons
                         Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="6" Class="d-flex align-items-center">
        @if (Geo.Of(Model) is null && Model.Id != 0 && Geo.AddressQuery(Model) is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Warning">
                This theater isn't on the map yet, so it won't show up when customers search near them. Saving looks it up
                from the address; if it still isn't found, check the address or enter the coordinates yourself.
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="muted">
                Used for "near me" searches and the weather. Saving looks them up from the address unless you enter them yourself; clear them to look them up again.
            </MudText>
        }
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="Model.Phone" For="() => Model.Phone" Label="Phone" InputType="InputType.Telephone" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="Model.Website" For="() => Model.Website" Label="Website" Placeholder="https://" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudDatePicker @bind-Date="SeasonOpens" Label="Season opens" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable Editable />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudDatePicker @bind-Date="SeasonCloses" Label="Season closes" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable Editable />
    </MudItem>
    <MudItem xs="12" md="6" Class="d-flex align-items-center">
        <MudText Typo="Typo.body2" Class="muted">
            Showings can only be scheduled from opening day through closing day. Leave either blank for no limit.
        </MudText>
    </MudItem>
    <MudItem xs="12">
        <MudTextField T="string" @bind-Value="Model.Description" Label="Description" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public Theater Model { get; set; } = default!;

    // The date pickers work in DateTime; the model stores plain dates.
    private DateTime? SeasonOpens
    {
        get => Model.SeasonOpensOn?.ToDateTime(TimeOnly.MinValue);
        set => Model.SeasonOpensOn = value is DateTime d ? DateOnly.FromDateTime(d) : null;
    }

    private DateTime? SeasonCloses
    {
        get => Model.SeasonClosesOn?.ToDateTime(TimeOnly.MinValue);
        set => Model.SeasonClosesOn = value is DateTime d ? DateOnly.FromDateTime(d) : null;
    }
}
