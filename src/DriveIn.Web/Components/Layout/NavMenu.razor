@using DriveIn.Web.Services
@using DriveIn.Web.Authorization

@inject TheaterService Theaters
@inject NotificationService Notifications

@* The top bar for statically rendered pages (account, Invite, Error): the same look and links as the interactive
   AppLayout bar. The menu toggle is a checkbox so it works without any interactivity. *@
<header class="static-bar">
    <div class="static-bar-inner">
        <a class="app-brand" href="/">Drive-In Online</a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="static-toggle" aria-label="Toggle navigation">&#9776;</label>

        <nav class="static-nav" aria-label="Main">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="app-link" href="theaters">Theaters</NavLink>
                    <NavLink class="app-link" href="tickets">My tickets</NavLink>
                    <NavLink class="app-link" href="messages">Messages</NavLink>
                    @if (!manages && context.User.GetEmployeeTheaterId() is null)
                    {
                        <NavLink class="app-link" href="get-started">Sign up a theater</NavLink>
                    }
                    @if (manages)
                    {
                        <NavLink class="app-link" href="manage">Manage</NavLink>
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.Admin">
                <NavLink class="app-link" href="admin/theaters">Admin: Theaters</NavLink>
                <NavLink class="app-link" href="admin/users">Admin: Users</NavLink>
            </AuthorizeView>
            <span class="spacer"></span>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="app-link" href="notifications" aria-label="@(unread == 0 ? "Notifications" : $"Notifications, {unread} unread")">
                        Notifications@(unread > 0 ? $" ({unread})" : "")
                    </NavLink>
                    <NavLink class="app-link" href="Account/Manage">
                        @(context.User.FindFirst("drivein:display_name")?.Value ?? context.User.Identity?.Name)
                    </NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="app-link">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="app-link" href="Account/Login">Sign in</NavLink>
                    <NavLink class="app-link" href="Account/Register">Register</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool manages;
    private int unread;

    // Owners aren't a role and can change at any time, so ask the database. The layout renders
    // statically on each request, so this runs once per page load.
    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        manages = user?.Identity?.IsAuthenticated == true
            && (user.IsAdmin() || user.GetEmployeeTheaterId() is not null || (await Theaters.ListManagedAsync(user)).Count > 0);
        unread = user is null ? 0 : await Notifications.CountUnreadAsync(user);
    }
}
