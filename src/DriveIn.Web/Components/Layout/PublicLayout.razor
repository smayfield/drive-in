@inherits LayoutComponentBase

@* The statically rendered public pages (a theater's page, its pages and posts): the static top bar (NavMenu) over a page
   as wide as the interactive app's, styled by wwwroot/public.css and static.css rather than MudBlazor, so a visitor
   doesn't need a live connection to the server to read them. *@
<a class="skip-link" href="@(Nav.Uri.Split('#')[0])#main">Skip to content</a>

<NavMenu />

<main id="main" tabindex="-1" class="container container-wide public-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
