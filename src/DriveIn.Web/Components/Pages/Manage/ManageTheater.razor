@page "/manage/{Id:int}"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject ScreenService Screens
@inject TheaterAccess Access

<PageTitle>@(theater?.Name ?? "Theater") · Manage · Drive-In Online</PageTitle>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading theater" /> }
}
else
{
    <ManageHeader Theater="theater" Title="@theater.Name" Current="overview" />

    <Alerts Error="@Error" Success="@Success" />

    <TheaterPlanPanel Theater="theater" User="User" BaseUri="@BaseUri" OnChanged="ReloadPlanAsync" />

    @if (permissions.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            You don't have any permissions at this theater yet. Ask your manager or the owner to assign you a role.
        </MudAlert>
    }

    <section class="manage-section">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <MudText Typo="Typo.h5">Screens</MudText>
            <MudLink Href="@($"manage/{theater.Id}/lot")">Lot map</MudLink>
        </div>
        <MudSimpleTable Dense Outlined Class="manage-table">
            <thead>
                <tr>
                    @if (CanManageScreens) { <th style="width: 6rem"></th> }
                    <th>Name</th><th>Spot labels</th><th class="text-end">Rows</th><th class="text-end">Spots</th>
                    @if (CanManageScreens) { <th style="width: 14rem"></th> }
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < theater.Screens.Count; i++)
                {
                    var screen = theater.Screens[i];
                    var first = i == 0;
                    var last = i == theater.Screens.Count - 1;
                    <tr @key="screen.Id">
                        @if (CanManageScreens)
                        {
                            <td class="text-nowrap">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@first" aria-label="Move up" OnClick="() => MoveAsync(screen, -1)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@last" aria-label="Move down" OnClick="() => MoveAsync(screen, 1)" />
                            </td>
                        }
                        <td><MudLink Href="@($"manage/{theater.Id}/screens/{screen.Id}")">@screen.Name</MudLink></td>
                        <td>@SpotLabels.Example(screen.LabelScheme)</td>
                        <td class="text-end">@screen.RowSpots.Count</td>
                        <td class="text-end">@screen.SpotCount</td>
                        @if (CanManageScreens)
                        {
                            <td class="text-end text-nowrap">
                                <MudButton Href="@($"manage/{theater.Id}/screens/{screen.Id}")" Size="Size.Small" Variant="Variant.Outlined">Set up</MudButton>
                                @if (theater.Screens.Count > 1)
                                {
                                    @if (confirmDeleteId == screen.Id)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteScreenAsync(screen)">Confirm delete</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmDeleteId = screen.Id">Delete</MudButton>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
                @if (CanManageScreens && theater.Screens.Count < Screen.MaxPerTheater)
                {
                    <tr>
                        <td></td>
                        <td colspan="4">
                            <MudTextField T="string" @bind-Value="newScreenName" Placeholder="New screen name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          MaxLength="100" aria-label="New screen name" />
                        </td>
                        <td class="text-end"><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddScreenAsync">Add screen</MudButton></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (CanManageScreens)
        {
            <MudText Typo="Typo.caption" Class="muted d-block mt-1">
                A theater has 1 to @Screen.MaxPerTheater screens. The order sets where each screen sits on the lot map:
                the first two face each other across the central building, and the next two face each other at 90 degrees.
            </MudText>
        }
    </section>

    @if (Can(TheaterPermissions.EditProfile))
    {
        <section class="manage-section">
            <MudText Typo="Typo.h5">Profile</MudText>

            <MudPaper Outlined Class="pa-3 mb-3">
                <MudText Typo="Typo.h6" Class="mb-1">Logo</MudText>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    @if (theater.LogoUrl is not null)
                    {
                        <img src="@theater.LogoUrl" alt="@theater.Name logo" style="max-height: 5rem; max-width: 10rem; object-fit: contain" class="logo-preview" />
                    }
                    else
                    {
                        <span class="muted">No logo yet.</span>
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.gif" FilesChanged="UploadLogoAsync">
                        <CustomContent>
                            <MudButton OnClick="@context.OpenFilePickerAsync" Variant="Variant.Outlined" Size="Size.Small">@(theater.LogoUrl is null ? "Upload logo" : "Replace logo")</MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    @if (theater.LogoUrl is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="RemoveLogoAsync">Remove logo</MudButton>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="muted d-block mt-1">JPG, GIF or PNG, up to @(TheaterLogo.MaxBytes / (1024 * 1024)) MB. Shown on your theater's public page.</MudText>
            </MudPaper>

            <EditForm Model="profile" OnValidSubmit="SaveProfileAsync">
                <DataAnnotationsValidator />
                <TheaterProfileFields Model="profile" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Save profile</MudButton>
            </EditForm>
        </section>

        <section class="manage-section">
            <MudText Typo="Typo.h5">Free admission</MudText>
            <MudPaper Outlined Class="pa-3">
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Let employees reserve free spots for guests such as friends and family. Which employees can is set by roles
                    (Offer / Approve / View free admission), and every one is logged for managers.
                </MudText>
                <MudSwitch T="bool" @bind-Value="freeEnabled" Color="Color.Primary" Label="Allow free admission" />
                @if (freeEnabled)
                {
                    <MudSwitch T="bool" @bind-Value="freeApproval" Color="Color.Primary" Label="Require approval before the guest's ticket is issued" />
                    <MudSwitch T="bool" @bind-Value="freeReason" Color="Color.Primary" Label="Require a reason" />
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        <MudNumericField T="int?" @bind-Value="freeMaxShowing" Min="1" Label="Max per showing (blank = no limit)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="field-grow" />
                        <MudNumericField T="int?" @bind-Value="freeMaxEmployee" Min="1" Label="Max per employee per showing (blank = no limit)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="field-grow" />
                    </div>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveFreeAdmissionAsync">Save free admission settings</MudButton>
            </MudPaper>
        </section>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Theater? theater;
    private Theater profile = new();
    private IReadOnlySet<string> permissions = new HashSet<string>();
    private string newScreenName = "";
    private int? confirmDeleteId;
    private bool freeEnabled, freeApproval = true, freeReason = true;
    private int? freeMaxShowing, freeMaxEmployee;

    // UI only; every action is re-checked by the service.
    private bool Can(string permission) => permissions.Contains(permission);
    private bool CanManageScreens => Can(TheaterPermissions.ManageScreens);

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        profile = theater.CopyForEdit();
        (freeEnabled, freeApproval, freeReason) = (theater.FreeAdmissionEnabled, theater.FreeAdmissionRequiresApproval, theater.FreeAdmissionRequiresReason);
        (freeMaxShowing, freeMaxEmployee) = (theater.FreeAdmissionMaxPerShowing, theater.FreeAdmissionMaxPerEmployeePerShowing);
        permissions = await Access.GetPermissionsAsync(User, theater);
    }

    private Task SaveFreeAdmissionAsync() => RunAsync(async () =>
    {
        await Theaters.UpdateFreeAdmissionSettingsAsync(User, Id, freeEnabled, freeApproval, freeReason, freeMaxShowing, freeMaxEmployee);
        theater = await Theaters.GetForManageAsync(User, Id);
    }, "Free admission settings saved.");

    private async Task ReloadPlanAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        Success = "Thanks! We'll review your theater and email you when it's live.";
    }

    private async Task ReloadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        confirmDeleteId = null;
    }

    private Task SaveProfileAsync() => RunAsync(async () =>
    {
        await Theaters.UpdateProfileAsync(User, profile);
        // Reload: the plan panel's checklist and billing estimate depend on the profile (time zone, season).
        theater = await Theaters.GetForManageAsync(User, Id);
    }, "Profile saved.");

    private Task UploadLogoAsync(IBrowserFile file) => RunAsync(async () =>
    {
        if (file.Size > TheaterLogo.MaxBytes)
            throw new AppValidationException($"Logos can be at most {TheaterLogo.MaxBytes / (1024 * 1024)} MB.");
        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(TheaterLogo.MaxBytes))
            await stream.CopyToAsync(buffer);
        await Theaters.SetLogoAsync(User, Id, buffer.ToArray());
        theater = await Theaters.GetForManageAsync(User, Id);
    }, "Logo saved.");

    private Task RemoveLogoAsync() => RunAsync(async () =>
    {
        await Theaters.RemoveLogoAsync(User, Id);
        theater = await Theaters.GetForManageAsync(User, Id);
    }, "Logo removed.");

    private Task AddScreenAsync() => RunAsync(async () =>
    {
        var screen = await Screens.AddAsync(User, Id, newScreenName);
        newScreenName = "";
        Nav.NavigateTo($"manage/{Id}/screens/{screen.Id}");
    });

    private Task DeleteScreenAsync(Screen screen) => RunAsync(async () =>
    {
        try
        {
            await Screens.DeleteAsync(User, screen.Id);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private Task MoveAsync(Screen screen, int direction) => RunAsync(async () =>
    {
        await Screens.MoveAsync(User, screen.Id, direction);
        await ReloadAsync();
    });
}
