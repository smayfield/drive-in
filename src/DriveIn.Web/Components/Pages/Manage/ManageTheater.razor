@page "/manage/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppComponentBase
@inject TheaterService Theaters
@inject ScreenService Screens
@inject TheaterAccess Access

<PageTitle>@(theater?.Name ?? "Theater") · Manage · Drive-In Online</PageTitle>

<p><a href="manage">&larr; Manage</a></p>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <p>Loading…</p> }
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="mb-0">@theater.Name</h1>
        <div class="d-flex gap-2">
            @if (theater.IsActive)
            {
                <a class="btn btn-outline-secondary" href="theaters/@theater.Slug">View public page</a>
            }
            @if (Can(TheaterPermissions.AdmitGuests))
            {
                <a class="btn btn-outline-primary" href="manage/@theater.Id/gate">Gate</a>
            }
            <a class="btn btn-outline-primary" href="manage/@theater.Id/schedule">Schedule</a>
            <a class="btn btn-outline-primary" href="manage/@theater.Id/pricing">Pricing</a>
            @if (EmployeeService.ListingPermissions.Any(Can) || Can(TheaterPermissions.InviteEmployees))
            {
                <a class="btn btn-outline-primary" href="manage/@theater.Id/employees">Employees</a>
            }
            @if (Can(TheaterPermissions.ManageRoles))
            {
                <a class="btn btn-outline-primary" href="manage/@theater.Id/roles">Roles</a>
            }
        </div>
    </div>

    <Alerts Error="@Error" Success="@Success" />

    @if (permissions.Count == 0)
    {
        <div class="alert alert-info">
            You don't have any permissions at this theater yet. Ask your manager or the owner to assign you a role.
        </div>
    }

    @if (Can(TheaterPermissions.EditProfile))
    {
        <section class="mb-5">
            <h2 class="h4">Profile</h2>
            <EditForm Model="profile" OnValidSubmit="SaveProfileAsync">
                <DataAnnotationsValidator />
                <TheaterProfileFields Model="profile" />
                <button type="submit" class="btn btn-primary mt-3">Save profile</button>
            </EditForm>
        </section>
    }

    <section>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h2 class="h4 mb-0">Screens</h2>
            <a class="btn btn-sm btn-outline-primary" href="manage/@theater.Id/lot">Lot map</a>
        </div>
        <table class="table align-middle">
            <thead>
                <tr>
                    @if (CanManageScreens) { <th style="width: 6rem"></th> }
                    <th>Name</th><th>Spot labels</th><th class="text-end">Rows</th><th class="text-end">Spots</th>
                    @if (CanManageScreens) { <th style="width: 14rem"></th> }
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < theater.Screens.Count; i++)
                {
                    var screen = theater.Screens[i];
                    var first = i == 0;
                    var last = i == theater.Screens.Count - 1;
                    <tr @key="screen.Id">
                        @if (CanManageScreens)
                        {
                            <td>
                                <button class="btn btn-sm btn-link px-1" disabled="@first" title="Move up" aria-label="Move up" @onclick="() => MoveAsync(screen, -1)">▲</button>
                                <button class="btn btn-sm btn-link px-1" disabled="@last" title="Move down" aria-label="Move down" @onclick="() => MoveAsync(screen, 1)">▼</button>
                            </td>
                        }
                        <td><a href="manage/@theater.Id/screens/@screen.Id">@screen.Name</a></td>
                        <td>@SpotLabels.Example(screen.LabelScheme)</td>
                        <td class="text-end">@screen.RowSpots.Count</td>
                        <td class="text-end">@screen.SpotCount</td>
                        @if (CanManageScreens)
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="manage/@theater.Id/screens/@screen.Id">Set up</a>
                                @if (theater.Screens.Count > 1)
                                {
                                    @if (confirmDeleteId == screen.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteScreenAsync(screen)">Confirm delete</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteId = screen.Id">Delete</button>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
                @if (CanManageScreens && theater.Screens.Count < Screen.MaxPerTheater)
                {
                    <tr>
                        <td></td>
                        <td colspan="4"><input class="form-control form-control-sm" placeholder="New screen name" @bind="newScreenName" maxlength="100" /></td>
                        <td class="text-end"><button class="btn btn-sm btn-success" @onclick="AddScreenAsync">Add screen</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (CanManageScreens)
        {
            <p class="text-muted small">
                A theater has 1 to @Screen.MaxPerTheater screens. The order sets where each screen sits on the lot map:
                the first two face each other across the central building, and the next two face each other at 90 degrees.
            </p>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Theater? theater;
    private Theater profile = new();
    private IReadOnlySet<string> permissions = new HashSet<string>();
    private string newScreenName = "";
    private int? confirmDeleteId;

    // UI only; every action is re-checked by the service.
    private bool Can(string permission) => permissions.Contains(permission);
    private bool CanManageScreens => Can(TheaterPermissions.ManageScreens);

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        profile = theater.CopyForEdit();
        permissions = await Access.GetPermissionsAsync(User, theater);
    }

    private async Task ReloadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        confirmDeleteId = null;
    }

    private Task SaveProfileAsync() => RunAsync(async () =>
    {
        await Theaters.UpdateProfileAsync(User, profile);
        theater!.Name = profile.Name;
    }, "Profile saved.");

    private Task AddScreenAsync() => RunAsync(async () =>
    {
        var screen = await Screens.AddAsync(User, Id, newScreenName);
        newScreenName = "";
        Nav.NavigateTo($"manage/{Id}/screens/{screen.Id}");
    });

    private Task DeleteScreenAsync(Screen screen) => RunAsync(async () =>
    {
        try
        {
            await Screens.DeleteAsync(User, screen.Id);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private Task MoveAsync(Screen screen, int direction) => RunAsync(async () =>
    {
        await Screens.MoveAsync(User, screen.Id, direction);
        await ReloadAsync();
    });
}
