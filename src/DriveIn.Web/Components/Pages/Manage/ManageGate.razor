@page "/manage/{Id:int}/gate"
@attribute [Authorize]
@inherits AppComponentBase
@implements IDisposable
@inject TheaterService Theaters
@inject TheaterAccess Access
@inject TicketSalesService Sales
@inject SpotEvents Events
@inject TimeProvider Time

<PageTitle>Gate · Manage · Drive-In Online</PageTitle>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading gate" /> }
}
else
{
    <ManageHeader Theater="theater" Title="Gate" Current="gate" />

    <MudGrid Spacing="4">
        @if (canAdmit)
        {
            <MudItem xs="12" lg="@(canSell ? 4 : 8)">
                <MudPaper Outlined Class="pa-3">
                    <MudText Typo="Typo.h5" Class="mb-2">Check in</MudText>
                    @* A plain input on purpose: handheld scanners type into it and press Enter, and it gets focus after each lookup. *@
                    <form class="d-flex gap-2 mb-2" @onsubmit="FindAsync">
                        <input @ref="codeInput" class="gate-input" autocomplete="off" autocapitalize="characters"
                               placeholder="Gate code or scan" aria-label="Gate code, ticket code or scanned QR code" @bind="code" />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Find</MudButton>
                    </form>
                    <MudText Typo="Typo.body2" Class="muted mb-2">
                        Type the guest's 4-character gate code, or scan their QR code: a handheld scanner types into this
                        box, or a phone's camera app opens the ticket directly.
                    </MudText>
                    @if (section == Section.CheckIn)
                    {
                        <Alerts Error="@Error" Success="@Success" />
                    }
                    @foreach (var found in lookups)
                    {
                        var t = found.View.Ticket;
                        var s = found.View.Showing;
                        var valid = found.AdmitProblem is null;
                        <MudPaper Outlined Class="pa-3 mb-2" Style="@($"border-color: var(--mud-palette-{(valid ? "success" : "error")}); border-width: 2px")" @key="t.Id">
                            <MudText Typo="Typo.h4" Color="@(valid ? Color.Success : Color.Error)">@(valid ? "Valid" : "Not valid")</MudText>
                            @if (!valid)
                            {
                                <MudText Class="mb-2">@found.AdmitProblem</MudText>
                            }
                            <div class="mb-1"><span class="gate-spot">Spot @t.SpotLabel</span> · @s.ScreenName</div>
                            <div class="mb-1">@s.Title</div>
                            <div class="mb-1 small">@s.StartsLocal.ToString("ddd, MMM d · h:mm tt") · gate code <span class="font-monospace">@t.ShortCode</span></div>
                            <div class="mb-2 small muted">
                                @t.OptionName@foreach (var a in t.AddOns) { @($" · {a.Name}") }
                                · @(t.SoldAtGate ? "sold at the gate" : "bought online")@(t.IsTest ? " · test ticket" : "")
                            </div>
                            @if (valid)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth Disabled="@busy" OnClick="() => AdmitAsync(t.Code!)">Check in</MudButton>
                            }
                        </MudPaper>
                    }
                </MudPaper>
            </MudItem>
        }

        @if (canSell)
        {
            <MudItem xs="12" lg="@(canAdmit ? 8 : 12)">
                <MudPaper Outlined Class="pa-3">
                    <MudText Typo="Typo.h5" Class="mb-2">Sell a ticket</MudText>
                    @if (section == Section.Sell)
                    {
                        <Alerts Error="@Error" Success="@Success" />
                    }
                    @if (showings.Count == 0)
                    {
                        <MudText Class="muted">No showings are left today.</MudText>
                    }
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var g in showings)
                        {
                            var selected = g.Showing.Id == sale?.Showing.Id;
                            var showingId = g.Showing.Id;
                            <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Class="gate-showing" Disabled="@(busy || Hold is not null)"
                                       OnClick="() => SelectAsync(showingId)">
                                <span class="text-start">
                                    <strong>@g.Showing.StartsLocal.ToString("h:mm tt")</strong> @g.Showing.Title
                                    <span class="d-block small">@g.Showing.ScreenName · @g.Open open@(g.Showing.StartsLocal <= NowLocal ? " · started" : "")</span>
                                </span>
                            </MudButton>
                        }
                    </div>

                    @if (sale is not null && availability is not null)
                    {
                        @if (!sale.OnSale)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-2">@sale.NotOnSaleReason</MudAlert>
                        }
                        <MudGrid Spacing="3">
                            <MudItem xs="12" xl="7">
                                <SeatMap Screen="sale.Screen" Availability="availability" CanPick="sale.OnSale && !busy && Hold is null"
                                         OnPick="HoldAsync" MineLabel="This car" />
                            </MudItem>
                            <MudItem xs="12" xl="5">
                                @if (Hold is HoldView hold)
                                {
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <MudText Typo="Typo.h5">Spot @hold.SpotLabel</MudText>
                                        <MudChip T="string" Color="Color.Warning" role="timer" aria-live="off">held @Remaining</MudChip>
                                    </div>
                                    <TicketChoices Prices="sale.Prices" AddOns="sale.AddOns" @bind-OptionId="optionId" @bind-AddOnIds="addOnIds" />
                                    <div class="d-flex flex-wrap gap-2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" Disabled="@(busy || Quote is null)" OnClick="SellAsync">
                                            @(busy ? "Processing…" : Quote is { Total: > 0 } q ? $"Charge card {Money.Format(q.Total)}" : "Sell (no charge)")
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Large" Disabled="@busy" OnClick="ReleaseAsync">Cancel</MudButton>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="muted mt-2">
                                        Take the card on the terminal. The car is checked in when the sale goes through. Sales are final.
                                    </MudText>
                                }
                                else if (lastSale is TicketView sold)
                                {
                                    <MudAlert Severity="Severity.Success" Class="mb-2">
                                        <MudText Typo="Typo.h6">Sold and checked in</MudText>
                                        <div>Send the car to <strong>spot @sold.Ticket.SpotLabel</strong> on @sold.Showing.ScreenName.</div>
                                        <div class="small">@Money.Format(sold.Ticket.Total) · gate code <span class="font-monospace">@sold.Ticket.ShortCode</span></div>
                                    </MudAlert>
                                    <MudText Typo="Typo.body2" Class="muted">Pick a green spot for the next car.</MudText>
                                }
                                else if (sale.OnSale)
                                {
                                    <MudText Class="muted">Pick a green spot for the car. @AvailableCount of @sale.Screen.SpotCount are open.</MudText>
                                }
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private enum Section { None, CheckIn, Sell }

    private Theater? theater;
    private bool canAdmit;
    private bool canSell;
    private bool busy;
    private Section section;
    private Timer? countdown;

    // Check in
    private ElementReference codeInput;
    private bool focusCode;
    private string code = "";
    private List<TicketLookup> lookups = [];

    // Sell
    private List<GateShowing> showings = [];
    private ShowingForSale? sale;
    private SpotAvailability? availability;
    private int optionId;
    private IReadOnlySet<int> addOnIds = new HashSet<int>();
    private TicketView? lastSale;

    private HoldView? Hold => availability?.MyHold;
    private DateTime NowLocal => TheaterTime.ToLocal(theater!, Time.GetUtcNow());
    private int AvailableCount => sale!.Screen.SpotCount - availability!.Spots.Count;
    private TicketQuote? Quote => sale is null ? null : TicketChoices.Quote(sale.Prices, sale.AddOns, optionId, addOnIds);

    private string Remaining
    {
        get
        {
            var left = Hold is null ? TimeSpan.Zero : Hold.HeldUntil - Time.GetUtcNow();
            return left <= TimeSpan.Zero ? "0:00" : $"{(int)left.TotalMinutes}:{left.Seconds:00}";
        }
    }

    protected override void OnInitialized()
    {
        Events.Changed += OnSpotsChanged;
        countdown = new Timer(_ => InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        var permissions = await Access.GetPermissionsAsync(User, theater);
        canAdmit = permissions.Contains(TheaterPermissions.AdmitGuests);
        canSell = permissions.Contains(TheaterPermissions.SellAtGate);
        if (!canAdmit && !canSell)
            throw new AccessDeniedException();
        if (canSell)
            showings = await Sales.ListGateShowingsAsync(User, Id);
        focusCode = canAdmit;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusCode && theater is not null && canAdmit)
        {
            focusCode = false;
            try
            {
                await codeInput.FocusAsync();
            }
            catch (Exception)
            {
                // Not rendered yet (e.g. prerendering); the attendant can tap the box.
            }
        }
    }

    // --- Check in ---

    private Task FindAsync() => Run(Section.CheckIn, async () =>
    {
        lookups = [];
        if (string.IsNullOrWhiteSpace(code))
            return;
        try
        {
            lookups = await Sales.FindAtGateAsync(User, Id, code);
        }
        finally
        {
            focusCode = true;
        }
    });

    private Task AdmitAsync(string ticketCode) => Run(Section.CheckIn, async () =>
    {
        var found = lookups.First(l => l.View.Ticket.Code == ticketCode).View;
        try
        {
            await Sales.AdmitAsync(User, ticketCode);
            lookups = [];
            code = "";
            Success = $"Checked in: spot {found.Ticket.SpotLabel} on {found.Showing.ScreenName}.";
        }
        catch (AppValidationException)
        {
            lookups = await Sales.FindAtGateAsync(User, Id, ticketCode);
            throw;
        }
        finally
        {
            focusCode = true;
        }
    });

    // --- Sell ---

    private Task SelectAsync(int showtimeId) => Run(Section.Sell, async () =>
    {
        lastSale = null;
        sale = await Sales.GetGateShowingAsync(User, showtimeId);
        availability = await Sales.GetAvailabilityAsync(User, showtimeId);
        optionId = sale.Prices.Options.FirstOrDefault()?.Id ?? 0;
        addOnIds = new HashSet<int>();
    });

    private Task HoldAsync(LotSpot spot) => Run(Section.Sell, async () =>
    {
        lastSale = null;
        try
        {
            await Sales.HoldAtGateAsync(User, sale!.Showing.Id, spot.Row, spot.Number);
        }
        finally
        {
            await RefreshAsync();
        }
    });

    private Task ReleaseAsync() => Run(Section.Sell, async () =>
    {
        if (Hold is HoldView hold)
            await Sales.ReleaseHoldAsync(User, hold.TicketId);
        await RefreshAsync();
    });

    private Task SellAsync() => Run(Section.Sell, async () =>
    {
        if (Hold is not HoldView hold || busy)
            return;
        busy = true;
        try
        {
            lastSale = await Sales.SellAtGateAsync(User, hold.TicketId, optionId, addOnIds.ToList());
            addOnIds = new HashSet<int>();
            optionId = sale!.Prices.Options.FirstOrDefault()?.Id ?? 0;
        }
        finally
        {
            busy = false;
            await RefreshAsync();
        }
    });

    private async Task RefreshAsync()
    {
        if (sale is not null)
            availability = await Sales.GetAvailabilityAsync(User, sale.Showing.Id);
        if (canSell)
            showings = await Sales.ListGateShowingsAsync(User, Id);
    }

    // Keeps errors and confirmations next to the panel the attendant is using.
    private Task Run(Section where, Func<Task> action)
    {
        section = where;
        return RunAsync(action);
    }

    private void OnSpotsChanged(int showtimeId)
    {
        if (sale?.Showing.Id != showtimeId && showings.All(g => g.Showing.Id != showtimeId))
            return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshAsync();
                StateHasChanged();
            }
            catch (Exception)
            {
                // The circuit may be going away; the next change or action refreshes again.
            }
        });
    }

    private async Task TickAsync()
    {
        if (Hold is not HoldView hold)
            return;
        if (hold.HeldUntil <= Time.GetUtcNow() && !busy)
        {
            try
            {
                await RefreshAsync();
            }
            catch (Exception)
            {
                return;
            }
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        Events.Changed -= OnSpotsChanged;
        countdown?.Dispose();
    }
}
