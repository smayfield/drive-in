@* The editable cells of an add-on row (name, description, type, amount, active) on the pricing page. *@

<td><MudTextField T="string" @bind-Value="Draft.Name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60" Placeholder="e.g. Outside food" aria-label="Add-on name" /></td>
<td><MudTextField T="string" @bind-Value="Draft.Description" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" aria-label="Add-on description" /></td>
<td>
    <MudSelect T="AddOnKind" @bind-Value="Draft.Kind" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Add-on type">
        @foreach (var kind in Enum.GetValues<AddOnKind>())
        {
            <MudSelectItem T="AddOnKind" Value="@kind">@ManagePricing.KindName(kind)</MudSelectItem>
        }
    </MudSelect>
</td>
<td>
    @if (Draft.Kind == AddOnKind.PercentDiscount)
    {
        <MudNumericField T="decimal" @bind-Value="Draft.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="F2" HideSpinButtons
                         Adornment="Adornment.End" AdornmentText="%" aria-label="Amount" />
    }
    else
    {
        <MudNumericField T="decimal" @bind-Value="Draft.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="F2" HideSpinButtons
                         Adornment="Adornment.Start" AdornmentText="$" aria-label="Amount" />
    }
</td>
<td><MudCheckBox T="bool" @bind-Value="Draft.IsActive" Color="Color.Primary" Dense aria-label="Active" /></td>

@code {
    [Parameter, EditorRequired] public AddOnDraft Draft { get; set; } = default!;
}
