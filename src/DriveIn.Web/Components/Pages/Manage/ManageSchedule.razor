@page "/manage/{Id:int}/schedule"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject ScheduleService Schedule
@inject PricingService Pricing
@inject TheaterAccess Access
@inject TimeProvider Time

<PageTitle>Schedule · Manage · Drive-In Online</PageTitle>

<p><a href="manage/@Id">&larr; Back to theater</a> · <a href="manage/@Id/lot">Lot map</a> · <a href="manage/@Id/pricing">Pricing</a></p>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <p>Loading…</p> }
}
else
{
    <h1>Schedule <small class="text-muted fs-5">@theater.Name</small></h1>
    @if (TheaterTime.IsValidZone(theater.TimeZone))
    {
        <p class="text-muted">Times are in the theater's time zone, @theater.TimeZone.</p>
    }
    else
    {
        <div class="alert alert-warning">
            This theater's time zone isn't set or isn't recognized, so the times below are entered and shown in UTC.
            Set it in the theater's profile (e.g. America/Chicago) to use local time.
        </div>
    }

    <Alerts Error="@Error" Success="@Success" />

    @if (canManage)
    {
        <section class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 mb-0">@(draft.EditingId is null ? "Add a showing" : "Change showing")</h2>
                    <div class="d-flex align-items-center gap-2 small">
                        <label for="default-intermission" class="text-nowrap">Default intermission</label>
                        <input id="default-intermission" class="form-control form-control-sm" style="width: 5rem" type="number"
                               min="0" max="@Showtime.MaxIntermissionMinutes" @bind="defaultIntermission" />
                        <span>min</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SaveDefaultIntermissionAsync">Save</button>
                    </div>
                </div>
                @if (films.Count == 0)
                {
                    <p class="text-muted mb-0">Add a film below first.</p>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label" for="st-screen">Screen</label>
                            <select id="st-screen" class="form-select" @bind="draft.ScreenId">
                                @foreach (var s in theater.Screens)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="st-date">Date</label>
                            <input id="st-date" class="form-control" type="date" @bind="draft.Date" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="st-time">Starts</label>
                            <input id="st-time" class="form-control" type="time" @bind="draft.Time" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="st-pricing">Pricing</label>
                            <select id="st-pricing" class="form-select" @bind="draft.PriceScheduleId">
                                <option value="0">@DefaultLabel</option>
                                @foreach (var p in OtherSchedules.Concat(PinnedDefault(draft.PriceScheduleId)))
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-2" style="max-width: 36rem">
                        @for (var i = 0; i < draft.Features.Count; i++)
                        {
                            var feature = draft.Features[i];
                            var number = i + 1;
                            <div class="input-group mb-2" @key="feature">
                                <label class="input-group-text" style="width: 7rem" for="st-film-@number">
                                    @(draft.Features.Count == 1 ? "Film" : $"Feature {number}")
                                </label>
                                <select id="st-film-@number" class="form-select" @bind="feature.FilmId">
                                    @foreach (var f in films)
                                    {
                                        <option value="@f.Id">@f.Title (@f.RuntimeMinutes min)</option>
                                    }
                                </select>
                                @if (draft.Features.Count > 1)
                                {
                                    <button class="btn btn-outline-danger" title="Remove feature @number" aria-label="Remove feature @number"
                                            @onclick="() => draft.Features.Remove(feature)">✕</button>
                                }
                            </div>
                        }
                        @if (draft.Features.Count < Showtime.MaxFeatures)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AddFeature">
                                @(draft.Features.Count == 1 ? "Make it a double feature" : "Add another feature")
                            </button>
                        }
                    </div>

                    @if (draft.Features.Count > 1)
                    {
                        <div class="input-group input-group-sm mb-3" style="max-width: 20rem">
                            <label class="input-group-text" for="st-intermission">Intermission</label>
                            <input id="st-intermission" class="form-control" type="number" min="0" max="@Showtime.MaxIntermissionMinutes"
                                   @bind="draft.Intermission" @bind:event="oninput" />
                            <span class="input-group-text">min between films</span>
                        </div>
                    }

                    <p class="small text-muted mb-3">@Preview()</p>

                    <div class="d-flex gap-2">
                        @if (draft.EditingId is null)
                        {
                            <button class="btn btn-primary" @onclick="SaveShowtimeAsync">Schedule</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="SaveShowtimeAsync">Save changes</button>
                            <button class="btn btn-outline-secondary" @onclick="ResetDraft">Cancel</button>
                        }
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <p class="text-muted">Default intermission between double-feature films: @theater.DefaultIntermissionMinutes minutes.</p>
    }

    <section class="mb-5">
        <h2 class="h4">Upcoming showings</h2>
        @if (showtimes.Count == 0)
        {
            <p class="text-muted">Nothing scheduled.</p>
        }
        @foreach (var day in showtimes.GroupBy(s => DateOnly.FromDateTime(s.StartsLocal)))
        {
            <h3 class="h6 mt-3">@day.Key.ToString("dddd, MMMM d, yyyy")</h3>
            <table class="table table-sm align-middle">
                <tbody>
                    @foreach (var s in day)
                    {
                        <tr @key="s.Id" class="@(draft.EditingId == s.Id ? "table-warning" : null)">
                            <td style="width: 12rem">@s.StartsLocal.ToString("h:mm tt")–@s.EndsLocal.ToString("h:mm tt")</td>
                            <td style="width: 10rem">@s.ScreenName</td>
                            <td>
                                @if (s.IsMultiFeature)
                                {
                                    <span class="badge text-bg-warning me-1">@(s.Features.Count == 2 ? "Double feature" : $"{s.Features.Count} features")</span>
                                    @foreach (var f in s.Features)
                                    {
                                        <div class="small">
                                            <span class="text-muted">@f.StartsLocal.ToString("h:mm tt")</span> @f.Title
                                            @if (f.Rating is not null) { <span class="badge text-bg-secondary ms-1">@f.Rating</span> }
                                        </div>
                                    }
                                    <div class="small text-muted">@s.IntermissionMinutes min intermission</div>
                                }
                                else
                                {
                                    var f = s.Features[0];
                                    @f.Title
                                    @if (f.Rating is not null) { <span class="badge text-bg-secondary ms-1">@f.Rating</span> }
                                }
                            </td>
                            <td style="width: 13rem">
                                @if (canManage)
                                {
                                    <select class="form-select form-select-sm" value="@(s.PriceScheduleId ?? 0)" aria-label="Pricing for this showing"
                                            @onchange="e => SetPricingAsync(s.Id, e.Value)">
                                        <option value="0">@DefaultLabel</option>
                                        @foreach (var p in OtherSchedules.Concat(PinnedDefault(s.PriceScheduleId ?? 0)))
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                }
                                else if (s.PriceScheduleName is not null)
                                {
                                    <span class="badge text-bg-info">@s.PriceScheduleName pricing</span>
                                }
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end" style="width: 13rem">
                                    @if (s.StartsLocal > NowLocal)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(s)">Edit</button>
                                    }
                                    @if (confirmShowtimeId == s.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteShowtimeAsync(s.Id)">Confirm remove</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmShowtimeId = s.Id">Remove</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2 class="h4">Films</h2>
        <table class="table align-middle">
            <thead><tr><th style="width: 4.5rem"></th><th>Title</th><th style="width: 8rem">Rating</th><th style="width: 10rem">Runtime (min)</th>@if (canManage) { <th style="width: 14rem"></th> }</tr></thead>
            <tbody>
                @foreach (var f in films)
                {
                    <tr @key="f.Id">
                        <td>
                            @if (f.PosterUrl is not null)
                            {
                                <img src="@f.PosterUrl" alt="Poster for @f.Title" width="46" height="69" style="object-fit: cover" loading="lazy" />
                            }
                        </td>
                        @if (editingFilm?.Id == f.Id)
                        {
                            <td><input class="form-control form-control-sm" @bind="editingFilm.Title" maxlength="200" aria-label="Title" /></td>
                            <td><input class="form-control form-control-sm" @bind="editingFilm.Rating" maxlength="10" aria-label="Rating" /></td>
                            <td><input class="form-control form-control-sm" type="number" min="1" max="@Film.MaxRuntimeMinutes" @bind="editingFilm.RuntimeMinutes" aria-label="Runtime in minutes" /></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary" @onclick="SaveFilmAsync">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => editingFilm = null">Cancel</button>
                            </td>
                        }
                        else
                        {
                            <td>
                                @f.Title @if (f.ReleaseYear is not null) { <span class="text-muted">(@f.ReleaseYear)</span> }
                                @if (f.Genres is not null) { <div class="small text-muted">@f.Genres</div> }
                                @if (f.Directors is not null) { <div class="small text-muted">Directed by @f.Directors</div> }
                                @if (f.Cast is not null) { <div class="small text-muted">Starring @f.Cast</div> }
                            </td>
                            <td>@f.Rating</td>
                            <td>@f.RuntimeMinutes</td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditFilm(f)">Edit</button>
                                    @if (confirmFilmId == f.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteFilmAsync(f.Id)">Confirm delete</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => { confirmFilmId = f.Id; editingFilm = null; }">Delete</button>
                                    }
                                </td>
                            }
                        }
                    </tr>
                    @if (editingFilm?.Id == f.Id)
                    {
                        <tr @key="@($"details-{f.Id}")" class="table-warning">
                            <td></td>
                            <td colspan="4">
                                <div class="row g-2 mb-2">
                                    <div class="col-md-2">
                                        <label class="form-label small" for="film-year">Year</label>
                                        <input id="film-year" class="form-control form-control-sm" type="number" min="@Film.MinReleaseYear" @bind="editingFilm.ReleaseYear" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small" for="film-directors">Directed by</label>
                                        <input id="film-directors" class="form-control form-control-sm" @bind="editingFilm.Directors" maxlength="300" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small" for="film-genres">Genres</label>
                                        <input id="film-genres" class="form-control form-control-sm" @bind="editingFilm.Genres" maxlength="200" placeholder="Horror, Thriller" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="film-cast">Starring</label>
                                    <input id="film-cast" class="form-control form-control-sm" @bind="editingFilm.Cast" maxlength="500" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="film-overview">Description</label>
                                    <textarea id="film-overview" class="form-control form-control-sm" rows="3" @bind="editingFilm.Overview" maxlength="2000"></textarea>
                                </div>
                                <div class="mb-1">
                                    <label class="form-label small" for="film-poster">Poster</label>
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <InputFile id="film-poster" class="form-control form-control-sm w-auto" accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif"
                                                   OnChange="UploadPosterAsync" />
                                        @if (editingFilm.PosterUpdatedAt is not null)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="RemovePosterAsync">Remove poster</button>
                                        }
                                    </div>
                                    <div class="form-text">JPG, GIF or PNG, up to @(FilmPoster.MaxBytes / (1024 * 1024)) MB. Use artwork you have the right to show, such as the distributor's promotional poster. Uploads save right away; use Save for the other details.</div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (canManage)
                {
                    <tr>
                        <td></td>
                        <td><input class="form-control form-control-sm" placeholder="New film title" @bind="newFilm.Title" maxlength="200" aria-label="New film title" /></td>
                        <td><input class="form-control form-control-sm" placeholder="PG-13" @bind="newFilm.Rating" maxlength="10" aria-label="New film rating" /></td>
                        <td><input class="form-control form-control-sm" type="number" min="1" max="@Film.MaxRuntimeMinutes" @bind="newFilm.RuntimeMinutes" aria-label="New film runtime in minutes" /></td>
                        <td class="text-end"><button class="btn btn-sm btn-success" @onclick="AddFilmAsync">Add film</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (films.Count == 0 && !canManage)
        {
            <p class="text-muted">No films yet.</p>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class FeatureDraft
    {
        public int FilmId { get; set; }
    }

    // The add/change form. EditingId is set while changing an existing showing.
    private sealed class ShowtimeDraft
    {
        public int? EditingId { get; set; }
        public int ScreenId { get; set; }
        public List<FeatureDraft> Features { get; set; } = [];
        public DateOnly Date { get; set; }
        public TimeOnly Time { get; set; } = new(20, 30);
        public int Intermission { get; set; }
        public int PriceScheduleId { get; set; } // 0 = the default
    }

    private Theater? theater;
    private bool canManage;
    private List<Film> films = [];
    private List<ShowtimeView> showtimes = [];
    private List<PriceSchedule> priceSchedules = [];
    private ShowtimeDraft draft = new();
    private int defaultIntermission;
    private Film newFilm = NewFilm();
    private Film? editingFilm;
    private int? confirmFilmId;
    private int? confirmShowtimeId;

    private static Film NewFilm() => new() { RuntimeMinutes = 120 };

    private DateTime NowLocal => TheaterTime.ToLocal(theater!, Time.GetUtcNow());

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        canManage = (await Access.GetPermissionsAsync(User, theater)).Contains(TheaterPermissions.ManageSchedule);
        defaultIntermission = theater.DefaultIntermissionMinutes;
        await ReloadAsync();
        ResetDraft();
    }

    private async Task ReloadAsync()
    {
        films = await Schedule.ListFilmsAsync(User, Id);
        showtimes = await Schedule.ListUpcomingAsync(User, Id);
        priceSchedules = (await Pricing.GetAsync(User, Id)).Schedules;
        if (draft.PriceScheduleId != 0 && priceSchedules.All(p => p.Id != draft.PriceScheduleId))
            draft.PriceScheduleId = 0;
        foreach (var feature in draft.Features.Where(f => films.All(x => x.Id != f.FilmId)))
            feature.FilmId = films.FirstOrDefault()?.Id ?? 0;
        editingFilm = null;
        confirmFilmId = null;
        confirmShowtimeId = null;
    }

    // Back to a blank "add" form, keeping the screen and date so several showings can be entered quickly.
    private void ResetDraft()
    {
        draft = new ShowtimeDraft
        {
            ScreenId = draft.EditingId is null && draft.ScreenId != 0 ? draft.ScreenId : theater!.Screens.FirstOrDefault()?.Id ?? 0,
            Date = draft.EditingId is null && draft.Date != default ? draft.Date : DateOnly.FromDateTime(NowLocal),
            Features = [new FeatureDraft { FilmId = films.FirstOrDefault()?.Id ?? 0 }],
            Intermission = theater!.DefaultIntermissionMinutes,
        };
    }

    private void StartEdit(ShowtimeView s)
    {
        confirmShowtimeId = null;
        draft = new ShowtimeDraft
        {
            EditingId = s.Id,
            ScreenId = s.ScreenId,
            Date = DateOnly.FromDateTime(s.StartsLocal),
            Time = TimeOnly.FromDateTime(s.StartsLocal),
            Features = s.Features.Select(f => new FeatureDraft { FilmId = f.FilmId }).ToList(),
            Intermission = s.IntermissionMinutes,
            PriceScheduleId = s.PriceScheduleId ?? 0,
        };
    }

    private void AddFeature() =>
        draft.Features.Add(new FeatureDraft { FilmId = films.FirstOrDefault(f => draft.Features.All(x => x.FilmId != f.Id))?.Id ?? films[0].Id });

    // e.g. "8:30 PM Jaws → 10:34 PM · 15 min intermission · 10:49 PM Alien → 12:46 AM".
    private string Preview()
    {
        var runtimes = draft.Features.Select(f => films.FirstOrDefault(x => x.Id == f.FilmId)).ToList();
        if (runtimes.Any(f => f is null))
            return "";
        var at = draft.Date.ToDateTime(draft.Time);
        var parts = new List<string>();
        foreach (var film in runtimes)
        {
            if (parts.Count > 0)
            {
                parts.Add($"{draft.Intermission} min intermission");
                at = at.AddMinutes(draft.Intermission);
            }
            var end = at.AddMinutes(film!.RuntimeMinutes);
            parts.Add($"{at:h:mm tt} {film.Title} → {end:h:mm tt}");
            at = end;
        }
        return string.Join(" · ", parts);
    }

    private ShowtimeInput DraftInput() => new(draft.ScreenId, draft.Features.Select(f => f.FilmId).ToList(), draft.Date, draft.Time,
        draft.Intermission, draft.PriceScheduleId == 0 ? null : draft.PriceScheduleId);

    private Task SaveShowtimeAsync() => RunAsync(async () =>
    {
        var editing = draft.EditingId is not null;
        if (draft.EditingId is int id)
            await Schedule.UpdateShowtimeAsync(User, id, DraftInput());
        else
            await Schedule.AddShowtimeAsync(User, DraftInput());
        await ReloadAsync();
        ResetDraft();
        Success = editing ? "Showing updated." : "Showing scheduled.";
    });

    private Task SaveDefaultIntermissionAsync() => RunAsync(async () =>
    {
        await Schedule.SetDefaultIntermissionAsync(User, Id, defaultIntermission);
        theater!.DefaultIntermissionMinutes = defaultIntermission;
        if (draft.EditingId is null)
            draft.Intermission = defaultIntermission;
    }, "Default intermission saved. It applies to showings you add from now on.");

    private Task DeleteShowtimeAsync(int showtimeId) => RunAsync(async () =>
    {
        await Schedule.DeleteShowtimeAsync(User, showtimeId);
        if (draft.EditingId == showtimeId)
            ResetDraft();
        await ReloadAsync();
    });

    // Adds the film, then opens it for editing so its details and poster can be filled in.
    private Task AddFilmAsync() => RunAsync(async () =>
    {
        var film = await Schedule.AddFilmAsync(User, Id, new FilmInput(newFilm.Title, newFilm.Rating, newFilm.RuntimeMinutes));
        newFilm = NewFilm();
        await ReloadAsync();
        if (draft.EditingId is null && draft.Features.Count == 1)
            draft.Features[0].FilmId = film.Id;
        StartEditFilm(film);
    });

    private void StartEditFilm(Film film)
    {
        confirmFilmId = null;
        editingFilm = new Film
        {
            Id = film.Id, Title = film.Title, Rating = film.Rating, RuntimeMinutes = film.RuntimeMinutes,
            ReleaseYear = film.ReleaseYear, Overview = film.Overview, Directors = film.Directors, Cast = film.Cast,
            Genres = film.Genres, PosterUpdatedAt = film.PosterUpdatedAt,
        };
    }

    private Task SaveFilmAsync() => RunAsync(async () =>
    {
        var f = editingFilm!;
        await Schedule.UpdateFilmAsync(User, f.Id, new FilmInput(f.Title, f.Rating, f.RuntimeMinutes, f.ReleaseYear,
            f.Overview, f.Directors, f.Cast, f.Genres));
        await ReloadAsync();
    });

    // Posters save immediately; the edit form (and any unsaved text in it) stays open.
    private Task UploadPosterAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        var file = e.File;
        if (file.Size > FilmPoster.MaxBytes)
            throw new AppValidationException($"Posters can be at most {FilmPoster.MaxBytes / (1024 * 1024)} MB.");
        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(FilmPoster.MaxBytes))
            await stream.CopyToAsync(buffer);
        await Schedule.SetPosterAsync(User, editingFilm!.Id, buffer.ToArray());
        await RefreshPosterAsync();
    }, "Poster saved.");

    private Task RemovePosterAsync() => RunAsync(async () =>
    {
        await Schedule.RemovePosterAsync(User, editingFilm!.Id);
        await RefreshPosterAsync();
    }, "Poster removed.");

    private async Task RefreshPosterAsync()
    {
        films = await Schedule.ListFilmsAsync(User, Id);
        editingFilm!.PosterUpdatedAt = films.FirstOrDefault(x => x.Id == editingFilm.Id)?.PosterUpdatedAt;
    }

    private Task DeleteFilmAsync(int filmId) => RunAsync(async () =>
    {
        try
        {
            await Schedule.DeleteFilmAsync(User, filmId);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private string DefaultLabel => $"Default ({priceSchedules.FirstOrDefault(p => p.IsDefault)?.Name ?? "none"})";

    private IEnumerable<PriceSchedule> OtherSchedules => priceSchedules.Where(p => !p.IsDefault);

    // A showing pinned to the current default schedule by id still needs its option in the list.
    private IEnumerable<PriceSchedule> PinnedDefault(int priceScheduleId) =>
        priceSchedules.Where(p => p.IsDefault && p.Id == priceScheduleId);

    private Task SetPricingAsync(int showtimeId, object? value) => RunAsync(async () =>
    {
        var id = int.TryParse(value?.ToString(), out var parsed) && parsed != 0 ? parsed : (int?)null;
        try
        {
            await Schedule.SetShowtimePricingAsync(User, showtimeId, id);
        }
        finally
        {
            await ReloadAsync();
        }
    }, "Pricing updated.");
}
