@page "/manage/{Id:int}/schedule"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject ScheduleService Schedule
@inject PricingService Pricing
@inject TheaterAccess Access
@inject TimeProvider Time

<PageTitle>Schedule · Manage · Drive-In Online</PageTitle>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading schedule" /> }
}
else
{
    <ManageHeader Theater="theater" Title="Schedule" Current="schedule" />
    @if (TheaterTime.IsValidZone(theater.TimeZone))
    {
        <MudText Class="muted mb-3">Times are in the theater's time zone, @theater.TimeZone.</MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            This theater's time zone isn't set or isn't recognized, so the times below are entered and shown in UTC.
            Set it in the theater's profile (e.g. America/Chicago) to use local time.
        </MudAlert>
    }

    <Alerts Error="@Error" Success="@Success" />

    @if (canManage)
    {
        <MudPaper Outlined Class="pa-3 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <MudText Typo="Typo.h5">@(draft.EditingId is null ? "Add a showing" : "Change showing")</MudText>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-nowrap">Default intermission</span>
                    <MudNumericField T="int" @bind-Value="defaultIntermission" Min="0" Max="Showtime.MaxIntermissionMinutes" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" HideSpinButtons Style="width: 5rem" aria-label="Default intermission in minutes" />
                    <span class="small">min</span>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SaveDefaultIntermissionAsync">Save</MudButton>
                </div>
            </div>
            @if (films.Count == 0)
            {
                <MudText Class="muted">Add a film below first.</MudText>
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="draft.ScreenId" Label="Screen" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var s in theater.Screens)
                            {
                                <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker @bind-Date="draft.DateValue" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" Editable />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTimePicker @bind-Time="draft.TimeValue" Label="Starts" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm Editable />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="draft.PriceScheduleId" Label="Pricing" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="0">@DefaultLabel</MudSelectItem>
                            @foreach (var p in OtherSchedules.Concat(PinnedDefault(draft.PriceScheduleId)))
                            {
                                <MudSelectItem T="int" Value="@p.Id">@p.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <div class="mb-2" style="max-width: 36rem">
                    @for (var i = 0; i < draft.Features.Count; i++)
                    {
                        var feature = draft.Features[i];
                        var number = i + 1;
                        <div class="d-flex gap-2 align-items-start mb-2" @key="feature">
                            <MudSelect T="int" @bind-Value="feature.FilmId" Label="@(draft.Features.Count == 1 ? "Film" : $"Feature {number}")"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var f in films)
                                {
                                    <MudSelectItem T="int" Value="@f.Id">@f.Title (@f.RuntimeMinutes min)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (draft.Features.Count > 1)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Class="mt-2"
                                               aria-label="@($"Remove feature {number}")" OnClick="() => draft.Features.Remove(feature)" />
                            }
                        </div>
                    }
                    @if (draft.Features.Count < Showtime.MaxFeatures)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AddFeature">
                            @(draft.Features.Count == 1 ? "Make it a double feature" : "Add another feature")
                        </MudButton>
                    }
                </div>

                @if (draft.Features.Count > 1)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <MudNumericField T="int" @bind-Value="draft.Intermission" Immediate Min="0" Max="Showtime.MaxIntermissionMinutes" Label="Intermission"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons Style="width: 9rem" />
                        <span class="small">min between films</span>
                    </div>
                }

                <MudText Typo="Typo.body2" Class="muted mb-3">@Preview()</MudText>

                <div class="d-flex gap-2">
                    @if (draft.EditingId is null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveShowtimeAsync">Schedule</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveShowtimeAsync">Save changes</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="ResetDraft">Cancel</MudButton>
                    }
                </div>
            }
        </MudPaper>
    }
    else
    {
        <MudText Class="muted mb-3">Default intermission between double-feature films: @theater.DefaultIntermissionMinutes minutes.</MudText>
    }

    <section class="manage-section">
        <MudText Typo="Typo.h5">Upcoming showings</MudText>
        @if (showtimes.Count == 0)
        {
            <MudText Class="muted">Nothing scheduled.</MudText>
        }
        @foreach (var day in showtimes.GroupBy(s => DateOnly.FromDateTime(s.StartsLocal)))
        {
            <MudText Typo="Typo.h6" Class="mt-3 mb-1">@day.Key.ToString("dddd, MMMM d, yyyy")</MudText>
            <MudSimpleTable Dense Outlined Class="manage-table">
                <tbody>
                    @foreach (var s in day)
                    {
                        <tr @key="s.Id" class="@(draft.EditingId == s.Id ? "row-editing" : null)">
                            <td style="width: 12rem">@s.StartsLocal.ToString("h:mm tt")–@s.EndsLocal.ToString("h:mm tt")</td>
                            <td style="width: 10rem">@s.ScreenName</td>
                            <td>
                                @if (s.IsMultiFeature)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="me-1 my-0">@(s.Features.Count == 2 ? "Double feature" : $"{s.Features.Count} features")</MudChip>
                                    @foreach (var f in s.Features)
                                    {
                                        <div class="small">
                                            <span class="muted">@f.StartsLocal.ToString("h:mm tt")</span> @f.Title
                                            @if (f.Rating is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1 my-0">@f.Rating</MudChip> }
                                        </div>
                                    }
                                    <div class="small muted">@s.IntermissionMinutes min intermission</div>
                                }
                                else
                                {
                                    var f = s.Features[0];
                                    @f.Title
                                    @if (f.Rating is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1 my-0">@f.Rating</MudChip> }
                                }
                            </td>
                            <td style="width: 13rem">
                                @if (canManage)
                                {
                                    <MudSelect T="int" Value="@(s.PriceScheduleId ?? 0)" ValueChanged="@((int v) => SetPricingAsync(s.Id, v))" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" aria-label="Pricing for this showing">
                                        <MudSelectItem T="int" Value="0">@DefaultLabel</MudSelectItem>
                                        @foreach (var p in OtherSchedules.Concat(PinnedDefault(s.PriceScheduleId ?? 0)))
                                        {
                                            <MudSelectItem T="int" Value="@p.Id">@p.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else if (s.PriceScheduleName is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="my-0">@s.PriceScheduleName pricing</MudChip>
                                }
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end text-nowrap" style="width: 13rem">
                                    @if (s.StartsLocal > NowLocal)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => StartEdit(s)">Edit</MudButton>
                                    }
                                    @if (confirmShowtimeId == s.Id)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteShowtimeAsync(s.Id)">Confirm remove</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmShowtimeId = s.Id">Remove</MudButton>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </section>

    <section class="manage-section">
        <MudText Typo="Typo.h5">Films</MudText>
        <MudSimpleTable Dense Outlined Class="manage-table">
            <thead><tr><th style="width: 4.5rem"></th><th>Title</th><th style="width: 8rem">Rating</th><th style="width: 10rem">Runtime (min)</th>@if (canManage) { <th style="width: 14rem"></th> }</tr></thead>
            <tbody>
                @foreach (var f in films)
                {
                    <tr @key="f.Id">
                        <td>
                            @if (f.PosterUrl is not null)
                            {
                                <img src="@f.PosterUrl" alt="Poster for @f.Title" width="46" height="69" style="object-fit: cover; border-radius: 3px" loading="lazy" />
                            }
                        </td>
                        @if (editingFilm?.Id == f.Id)
                        {
                            <td><MudTextField T="string" @bind-Value="editingFilm.Title" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" aria-label="Title" /></td>
                            <td><MudTextField T="string" @bind-Value="editingFilm.Rating" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="10" aria-label="Rating" /></td>
                            <td><MudNumericField T="int" @bind-Value="editingFilm.RuntimeMinutes" Min="1" Max="Film.MaxRuntimeMinutes" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons aria-label="Runtime in minutes" /></td>
                            <td class="text-end text-nowrap">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFilmAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => editingFilm = null">Cancel</MudButton>
                            </td>
                        }
                        else
                        {
                            <td>
                                @f.Title @if (f.ReleaseYear is not null) { <span class="muted"> (@f.ReleaseYear)</span> }
                                @if (f.Genres is not null) { <div class="small muted">@f.Genres</div> }
                                @if (f.Directors is not null) { <div class="small muted">Directed by @f.Directors</div> }
                                @if (f.Cast is not null) { <div class="small muted">Starring @f.Cast</div> }
                            </td>
                            <td>@f.Rating</td>
                            <td>@f.RuntimeMinutes</td>
                            @if (canManage)
                            {
                                <td class="text-end text-nowrap">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => StartEditFilm(f)">Edit</MudButton>
                                    @if (confirmFilmId == f.Id)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteFilmAsync(f.Id)">Confirm delete</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => { confirmFilmId = f.Id; editingFilm = null; }">Delete</MudButton>
                                    }
                                </td>
                            }
                        }
                    </tr>
                    @if (editingFilm?.Id == f.Id)
                    {
                        <tr @key="@($"details-{f.Id}")" class="row-editing">
                            <td></td>
                            <td colspan="4">
                                <MudGrid Spacing="2" Class="mb-1">
                                    <MudItem xs="12" sm="4" md="2">
                                        <MudNumericField T="int?" @bind-Value="editingFilm.ReleaseYear" Min="Film.MinReleaseYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons />
                                    </MudItem>
                                    <MudItem xs="12" sm="8" md="5">
                                        <MudTextField T="string" @bind-Value="editingFilm.Directors" Label="Directed by" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="300" />
                                    </MudItem>
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string" @bind-Value="editingFilm.Genres" Label="Genres" Placeholder="Horror, Thriller" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" @bind-Value="editingFilm.Cast" Label="Starring" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" @bind-Value="editingFilm.Overview" Label="Description" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="2000" />
                                    </MudItem>
                                </MudGrid>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.gif" FilesChanged="UploadPosterAsync">
                                        <ActivatorContent>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined">@(editingFilm.PosterUpdatedAt is null ? "Upload poster" : "Replace poster")</MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    @if (editingFilm.PosterUpdatedAt is not null)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="RemovePosterAsync">Remove poster</MudButton>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="muted d-block mt-1">
                                    JPG, GIF or PNG, up to @(FilmPoster.MaxBytes / (1024 * 1024)) MB. Use artwork you have the right to show, such as the distributor's promotional poster.
                                    Uploads save right away; use Save for the other details.
                                </MudText>
                            </td>
                        </tr>
                    }
                }
                @if (canManage)
                {
                    <tr>
                        <td></td>
                        <td><MudTextField T="string" @bind-Value="newFilm.Title" Placeholder="New film title" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" aria-label="New film title" /></td>
                        <td><MudTextField T="string" @bind-Value="newFilm.Rating" Placeholder="PG-13" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="10" aria-label="New film rating" /></td>
                        <td><MudNumericField T="int" @bind-Value="newFilm.RuntimeMinutes" Min="1" Max="Film.MaxRuntimeMinutes" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons aria-label="New film runtime in minutes" /></td>
                        <td class="text-end"><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddFilmAsync">Add film</MudButton></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (films.Count == 0 && !canManage)
        {
            <MudText Class="muted">No films yet.</MudText>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private sealed class FeatureDraft
    {
        public int FilmId { get; set; }
    }

    // The add/change form. EditingId is set while changing an existing showing.
    private sealed class ShowtimeDraft
    {
        public int? EditingId { get; set; }
        public int ScreenId { get; set; }
        public List<FeatureDraft> Features { get; set; } = [];
        public DateOnly Date { get; set; }
        public TimeOnly Time { get; set; } = new(20, 30);
        public int Intermission { get; set; }
        public int PriceScheduleId { get; set; } // 0 = the default

        // The pickers work in DateTime and TimeSpan; the draft keeps a plain date and time.
        public DateTime? DateValue
        {
            get => Date.ToDateTime(TimeOnly.MinValue);
            set { if (value is DateTime d) Date = DateOnly.FromDateTime(d); }
        }

        public TimeSpan? TimeValue
        {
            get => Time.ToTimeSpan();
            set { if (value is TimeSpan t) Time = TimeOnly.FromTimeSpan(t); }
        }
    }

    private Theater? theater;
    private bool canManage;
    private List<Film> films = [];
    private List<ShowtimeView> showtimes = [];
    private List<PriceSchedule> priceSchedules = [];
    private ShowtimeDraft draft = new();
    private int defaultIntermission;
    private Film newFilm = NewFilm();
    private Film? editingFilm;
    private int? confirmFilmId;
    private int? confirmShowtimeId;

    private static Film NewFilm() => new() { RuntimeMinutes = 120 };

    private DateTime NowLocal => TheaterTime.ToLocal(theater!, Time.GetUtcNow());

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        canManage = (await Access.GetPermissionsAsync(User, theater)).Contains(TheaterPermissions.ManageSchedule);
        defaultIntermission = theater.DefaultIntermissionMinutes;
        await ReloadAsync();
        ResetDraft();
    }

    private async Task ReloadAsync()
    {
        films = await Schedule.ListFilmsAsync(User, Id);
        showtimes = await Schedule.ListUpcomingAsync(User, Id);
        priceSchedules = (await Pricing.GetAsync(User, Id)).Schedules;
        if (draft.PriceScheduleId != 0 && priceSchedules.All(p => p.Id != draft.PriceScheduleId))
            draft.PriceScheduleId = 0;
        foreach (var feature in draft.Features.Where(f => films.All(x => x.Id != f.FilmId)))
            feature.FilmId = films.FirstOrDefault()?.Id ?? 0;
        editingFilm = null;
        confirmFilmId = null;
        confirmShowtimeId = null;
    }

    // Back to a blank "add" form, keeping the screen and date so several showings can be entered quickly.
    private void ResetDraft()
    {
        draft = new ShowtimeDraft
        {
            ScreenId = draft.EditingId is null && draft.ScreenId != 0 ? draft.ScreenId : theater!.Screens.FirstOrDefault()?.Id ?? 0,
            Date = draft.EditingId is null && draft.Date != default ? draft.Date : DateOnly.FromDateTime(NowLocal),
            Features = [new FeatureDraft { FilmId = films.FirstOrDefault()?.Id ?? 0 }],
            Intermission = theater!.DefaultIntermissionMinutes,
        };
    }

    private void StartEdit(ShowtimeView s)
    {
        confirmShowtimeId = null;
        draft = new ShowtimeDraft
        {
            EditingId = s.Id,
            ScreenId = s.ScreenId,
            Date = DateOnly.FromDateTime(s.StartsLocal),
            Time = TimeOnly.FromDateTime(s.StartsLocal),
            Features = s.Features.Select(f => new FeatureDraft { FilmId = f.FilmId }).ToList(),
            Intermission = s.IntermissionMinutes,
            PriceScheduleId = s.PriceScheduleId ?? 0,
        };
    }

    private void AddFeature() =>
        draft.Features.Add(new FeatureDraft { FilmId = films.FirstOrDefault(f => draft.Features.All(x => x.FilmId != f.Id))?.Id ?? films[0].Id });

    // e.g. "8:30 PM Jaws → 10:34 PM · 15 min intermission · 10:49 PM Alien → 12:46 AM".
    private string Preview()
    {
        var runtimes = draft.Features.Select(f => films.FirstOrDefault(x => x.Id == f.FilmId)).ToList();
        if (runtimes.Any(f => f is null))
            return "";
        var at = draft.Date.ToDateTime(draft.Time);
        var parts = new List<string>();
        foreach (var film in runtimes)
        {
            if (parts.Count > 0)
            {
                parts.Add($"{draft.Intermission} min intermission");
                at = at.AddMinutes(draft.Intermission);
            }
            var end = at.AddMinutes(film!.RuntimeMinutes);
            parts.Add($"{at:h:mm tt} {film.Title} → {end:h:mm tt}");
            at = end;
        }
        return string.Join(" · ", parts);
    }

    private ShowtimeInput DraftInput() => new(draft.ScreenId, draft.Features.Select(f => f.FilmId).ToList(), draft.Date, draft.Time,
        draft.Intermission, draft.PriceScheduleId == 0 ? null : draft.PriceScheduleId);

    private Task SaveShowtimeAsync() => RunAsync(async () =>
    {
        var editing = draft.EditingId is not null;
        if (draft.EditingId is int id)
            await Schedule.UpdateShowtimeAsync(User, id, DraftInput());
        else
            await Schedule.AddShowtimeAsync(User, DraftInput());
        await ReloadAsync();
        ResetDraft();
        Success = editing ? "Showing updated." : "Showing scheduled.";
    });

    private Task SaveDefaultIntermissionAsync() => RunAsync(async () =>
    {
        await Schedule.SetDefaultIntermissionAsync(User, Id, defaultIntermission);
        theater!.DefaultIntermissionMinutes = defaultIntermission;
        if (draft.EditingId is null)
            draft.Intermission = defaultIntermission;
    }, "Default intermission saved. It applies to showings you add from now on.");

    private Task DeleteShowtimeAsync(int showtimeId) => RunAsync(async () =>
    {
        await Schedule.DeleteShowtimeAsync(User, showtimeId);
        if (draft.EditingId == showtimeId)
            ResetDraft();
        await ReloadAsync();
    });

    // Adds the film, then opens it for editing so its details and poster can be filled in.
    private Task AddFilmAsync() => RunAsync(async () =>
    {
        var film = await Schedule.AddFilmAsync(User, Id, new FilmInput(newFilm.Title, newFilm.Rating, newFilm.RuntimeMinutes));
        newFilm = NewFilm();
        await ReloadAsync();
        if (draft.EditingId is null && draft.Features.Count == 1)
            draft.Features[0].FilmId = film.Id;
        StartEditFilm(film);
    });

    private void StartEditFilm(Film film)
    {
        confirmFilmId = null;
        editingFilm = new Film
        {
            Id = film.Id, Title = film.Title, Rating = film.Rating, RuntimeMinutes = film.RuntimeMinutes,
            ReleaseYear = film.ReleaseYear, Overview = film.Overview, Directors = film.Directors, Cast = film.Cast,
            Genres = film.Genres, PosterUpdatedAt = film.PosterUpdatedAt,
        };
    }

    private Task SaveFilmAsync() => RunAsync(async () =>
    {
        var f = editingFilm!;
        await Schedule.UpdateFilmAsync(User, f.Id, new FilmInput(f.Title, f.Rating, f.RuntimeMinutes, f.ReleaseYear,
            f.Overview, f.Directors, f.Cast, f.Genres));
        await ReloadAsync();
    });

    // Posters save immediately; the edit form (and any unsaved text in it) stays open.
    private Task UploadPosterAsync(IBrowserFile file) => RunAsync(async () =>
    {
        if (file.Size > FilmPoster.MaxBytes)
            throw new AppValidationException($"Posters can be at most {FilmPoster.MaxBytes / (1024 * 1024)} MB.");
        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(FilmPoster.MaxBytes))
            await stream.CopyToAsync(buffer);
        await Schedule.SetPosterAsync(User, editingFilm!.Id, buffer.ToArray());
        await RefreshPosterAsync();
    }, "Poster saved.");

    private Task RemovePosterAsync() => RunAsync(async () =>
    {
        await Schedule.RemovePosterAsync(User, editingFilm!.Id);
        await RefreshPosterAsync();
    }, "Poster removed.");

    private async Task RefreshPosterAsync()
    {
        films = await Schedule.ListFilmsAsync(User, Id);
        editingFilm!.PosterUpdatedAt = films.FirstOrDefault(x => x.Id == editingFilm.Id)?.PosterUpdatedAt;
    }

    private Task DeleteFilmAsync(int filmId) => RunAsync(async () =>
    {
        try
        {
            await Schedule.DeleteFilmAsync(User, filmId);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private string DefaultLabel => $"Default ({priceSchedules.FirstOrDefault(p => p.IsDefault)?.Name ?? "none"})";

    private IEnumerable<PriceSchedule> OtherSchedules => priceSchedules.Where(p => !p.IsDefault);

    // A showing pinned to the current default schedule by id still needs its option in the list.
    private IEnumerable<PriceSchedule> PinnedDefault(int priceScheduleId) =>
        priceSchedules.Where(p => p.IsDefault && p.Id == priceScheduleId);

    private Task SetPricingAsync(int showtimeId, object? value) => RunAsync(async () =>
    {
        var id = int.TryParse(value?.ToString(), out var parsed) && parsed != 0 ? parsed : (int?)null;
        try
        {
            await Schedule.SetShowtimePricingAsync(User, showtimeId, id);
        }
        finally
        {
            await ReloadAsync();
        }
    }, "Pricing updated.");
}
