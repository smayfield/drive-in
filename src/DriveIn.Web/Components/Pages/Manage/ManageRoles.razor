@page "/manage/{Id:int}/roles"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject TheaterAccess Access
@inject RoleService RoleManager

<PageTitle>Roles · Manage · Drive-In Online</PageTitle>

@if (theater is not null)
{
    <ManageHeader Theater="theater" Title="Roles" Current="roles" />
}
<MudText Class="muted mb-3">
    A role is a set of actions. Employees can have several roles and can do anything any of their roles allows.
    Employees with no roles can't do anything. Owners always have every action.
    @if (!fullAccess)
    {
        <span>You can only grant, change or remove actions you have yourself.</span>
    }
</MudText>

<Alerts Error="@Error" Success="@Success" />

@if (roles is not null)
{
    @if (editor is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="StartNew">New role</MudButton>
    }

    @if (editor is not null)
    {
        <MudPaper Outlined Class="pa-4 mb-4">
            <MudText Typo="Typo.h5" Class="mb-2">@(editor.Id is null ? "New role" : $"Edit {editor.OriginalName}")</MudText>
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="editor.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField T="string" @bind-Value="editor.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="300" />
                </MudItem>
            </MudGrid>
            @foreach (var group in TheaterPermissions.All.GroupBy(p => p.Group))
            {
                <fieldset class="mb-2 border-0 p-0">
                    <legend class="mud-typography mud-typography-h6">@group.Key</legend>
                    @foreach (var p in group)
                    {
                        var key = p.Key;
                        var allowed = permissions.Contains(key);
                        <MudCheckBox T="bool" Value="editor.Permissions.Contains(key)" ValueChanged="on => Toggle(key, on)"
                                     Disabled="@(!allowed)" Color="Color.Primary" Dense>
                            @p.Name <span class="muted small">— @p.Description</span>
                            @if (!allowed) { <span class="muted small">(you don't have this)</span> }
                        </MudCheckBox>
                    }
                </fieldset>
            }
            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@(editor.Id is null ? "Create role" : "Save role")</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => editor = null">Cancel</MudButton>
            </div>
        </MudPaper>
    }

    @if (roles.Count == 0)
    {
        <MudText Class="muted">No roles yet.</MudText>
    }
    <MudPaper Outlined>
        @foreach (var role in roles)
        {
            var mine = role.Permissions.All(permissions.Contains);
            <div class="role-row" @key="role.Id">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">
                            @role.Name
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1 my-0">@role.MemberCount employee@(role.MemberCount == 1 ? "" : "s")</MudChip>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(role.Description))
                        {
                            <div class="small muted">@role.Description</div>
                        }
                        <div class="mt-1">
                            @if (role.Permissions.Count == 0)
                            {
                                <span class="small muted">No actions</span>
                            }
                            @foreach (var key in role.Permissions)
                            {
                                <MudChip T="string" Size="Size.Small" Class="my-0">@NameOf(key)</MudChip>
                            }
                        </div>
                    </div>
                    <div class="text-nowrap">
                        @if (mine)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => StartEdit(role)">Edit</MudButton>
                            @if (confirmDeleteId == role.Id)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteAsync(role)">
                                    @(role.MemberCount > 0 ? $"Delete and remove from {role.MemberCount}" : "Confirm delete")
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => confirmDeleteId = null">Cancel</MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmDeleteId = role.Id">Delete</MudButton>
                            }
                        }
                        else
                        {
                            <span class="small muted">Has actions you don't have</span>
                        }
                    </div>
                </div>
            </div>
        }
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private Theater? theater;
    private bool fullAccess;
    private IReadOnlySet<string> permissions = new HashSet<string>();
    private List<RoleSummary>? roles;
    private RoleEditor? editor;
    private int? confirmDeleteId;

    private sealed class RoleEditor
    {
        public int? Id { get; init; }
        public string? OriginalName { get; init; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public HashSet<string> Permissions { get; init; } = [];
    }

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        fullAccess = TheaterAccess.HasFullAccess(User, theater);
        permissions = await Access.GetPermissionsAsync(User, theater);
        roles = await RoleManager.ListAsync(User, Id); // requires ManageRoles
        confirmDeleteId = null;
    }

    private static string NameOf(string key) => TheaterPermissions.All.FirstOrDefault(p => p.Key == key)?.Name ?? key;

    private void StartNew() => editor = new RoleEditor();

    private void StartEdit(RoleSummary role)
    {
        confirmDeleteId = null;
        editor = new RoleEditor
        {
            Id = role.Id, OriginalName = role.Name, Name = role.Name, Description = role.Description,
            Permissions = role.Permissions.ToHashSet(),
        };
    }

    private void Toggle(string key, bool on)
    {
        if (on) editor!.Permissions.Add(key); else editor!.Permissions.Remove(key);
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var e = editor!;
        if (e.Id is int roleId)
            await RoleManager.UpdateAsync(User, roleId, e.Name, e.Description, e.Permissions);
        else
            await RoleManager.CreateAsync(User, Id, e.Name, e.Description, e.Permissions);
        editor = null;
        await LoadAsync();
    }, editor?.Id is null ? "Role created." : "Role saved.");

    private Task DeleteAsync(RoleSummary role) => RunAsync(async () =>
    {
        await RoleManager.DeleteAsync(User, role.Id);
        await LoadAsync();
    }, $"Deleted the {role.Name} role.");
}
