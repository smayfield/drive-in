@page "/manage/{Id:int}/lot"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters

<PageTitle>Lot map · Manage · Drive-In Online</PageTitle>

@if (theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading lot map" /> }
}
else
{
    <ManageHeader Theater="theater" Title="Lot map" Current="lot" />
    <Alerts Error="@Error" Success="@Success" />

    <MudText Class="muted mb-3">
        @theater.Screens.Count screen@(theater.Screens.Count == 1 ? "" : "s") ·
        @theater.Screens.Sum(s => s.SpotCount) spots.
        Each screen's rows face it from the central building. Click a screen's name to set it up.
    </MudText>

    <LotMap Screens="theater.Screens" Theater="true" ScreenHref="@(s => $"manage/{Id}/screens/{s.Id}")" />

    <MudSimpleTable Dense Outlined Class="manage-table mt-4" Style="max-width: 40rem">
        <thead><tr><th>Screen</th><th>Position</th><th class="text-end">Rows</th><th class="text-end">Spots</th></tr></thead>
        <tbody>
            @for (var i = 0; i < theater.Screens.Count; i++)
            {
                var s = theater.Screens[i];
                <tr>
                    <td><MudLink Href="@($"manage/{Id}/screens/{s.Id}")">@s.Name</MudLink></td>
                    <td>@Positions.ElementAtOrDefault(i)</td>
                    <td class="text-end">@s.RowSpots.Count</td>
                    <td class="text-end">@s.SpotCount</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter] public int Id { get; set; }

    // Matches LotPlan.Angles.
    private static readonly string[] Positions = ["North", "South", "East", "West"];

    private Theater? theater;

    protected override async Task LoadAsync() => theater = await Theaters.GetForManageAsync(User, Id);
}
