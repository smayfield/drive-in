@* On a theater's manage page: for a demo theater, the setup checklist and the request to go live; for a live one, its
   subscription and a link to its Billing page. *@
@using System.Security.Claims
@using Microsoft.Extensions.Options
@inject OnboardingService Onboarding
@inject BillingService Billing
@inject IOptions<PlanOptions> Plans

@if (Theater.IsDemo)
{
    <MudPaper Outlined Class="pa-3 mb-4" Style="border-color: var(--mud-palette-info)">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <MudText Typo="Typo.h5"><MudChip T="string" Size="Size.Small" Color="Color.Info" Class="me-2 my-0">Demo</MudChip>Set up your theater</MudText>
            <span class="muted small">@steps.Count(s => s.Done && !s.Optional) of @steps.Count(s => !s.Optional) required steps done</span>
        </div>
        <MudText Typo="Typo.body2" Class="muted mb-2">
            Your theater is private: only you and your staff can see it. Sales are test sales (no money is charged), so try the
            whole thing, from buying a ticket to checking it in at the gate.
        </MudText>
        <ol class="list-unstyled mb-3">
            @foreach (var step in steps)
            {
                <li class="d-flex gap-2 mb-2">
                    <span aria-hidden="true" class="@(step.Done ? "step-done" : "muted")">@(step.Done ? "✔" : "○")</span>
                    <span>
                        <MudLink Href="@step.Href">@step.Title</MudLink>@if (step.Optional) { <span class="muted small"> (optional)</span> }
                        <span class="visually-hidden">@(step.Done ? "done" : "to do")</span>
                        <span class="d-block small muted">@step.Detail</span>
                    </span>
                </li>
            }
        </ol>

        <MudText Typo="Typo.h6" Class="mb-1">Go live</MudText>
        @if (Theater.GoLiveRequestedAt is DateTimeOffset asked)
        {
            <MudAlert Severity="Severity.Warning">
                You asked to go live on @TheaterTime.ToLocal(Theater, asked).ToString("MMM d, h:mm tt"). We'll review your theater
                and email the owner when it's live.
            </MudAlert>
        }
        else if (!isOwner)
        {
            <MudText Typo="Typo.body2" Class="muted">When everything's ready, the theater's owner can take it live.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                Going live lists your theater publicly and starts real sales, on the Standard plan: @QuoteText
                Your demo test tickets are cleared out.
            </MudText>
            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@error</MudAlert>
            }
            <MudCheckBox T="bool" @bind-Value="acceptBilling" Color="Color.Primary" Class="mb-1">
                I agree to the Standard plan's billing as described on the <MudLink Href="pricing" Target="_blank">Pricing</MudLink> page
                and in the <MudLink Href="legal/terms" Target="_blank">Terms of Service</MudLink>.
            </MudCheckBox>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@busy" OnClick="RequestAsync">Ask to go live</MudButton>
        }
    </MudPaper>
}
else if (isOwner)
{
    <MudPaper Outlined Class="px-3 py-2 mb-4">
        <MudText Typo="Typo.body2">
            <strong>@(subscription?.Plan ?? "Standard") plan</strong>@if (Theater.LiveSince is DateTimeOffset since) { <text> · live since @TheaterTime.ToLocal(Theater, since).ToString("MMM d, yyyy")</text> }
            @if (subscription is null)
            {
                <text> · not billed</text>
            }
            else
            {
                <text> · @Theater.Screens.Count screen@(Theater.Screens.Count == 1 ? "" : "s") × @Money.Format(subscription.PricePerScreenPerMonth) = @Money.Format(Theater.Screens.Count * subscription.PricePerScreenPerMonth) a month in season@(subscription.IsActive ? "" : " (cancelled)")</text>
            }
            · <MudLink Href="@($"manage/{Theater.Id}/billing")" Typo="Typo.body2">Billing and invoices</MudLink>
        </MudText>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public Theater Theater { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
    [Parameter, EditorRequired] public string BaseUri { get; set; } = "";
    // Raised after the owner asks to go live, so the page reloads the theater.
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<SetupStep> steps = [];
    private Subscription? subscription;
    private bool isOwner;
    private bool acceptBilling;
    private bool busy;
    private string? error;

    // e.g. "2 screens × $49 = $98 a month, billed for the 5 months of your season (May–Sep): about $490."
    private string QuoteText
    {
        get
        {
            var q = Onboarding.Quote(Theater, Theater.Screens.Count);
            var monthly = q.MonthlyTotal is decimal m ? Money.Format(m) : "$__";
            var text = $"{q.Screens} screen{(q.Screens == 1 ? "" : "s")} × {Plans.Value.PriceDisplay} = {monthly} a month";
            return q.BilledMonths is int months
                ? $"{text}, billed for the {months} month{(months == 1 ? "" : "s")} of your season " +
                  $"({Theater.SeasonOpensOn:MMM yyyy} – {Theater.SeasonClosesOn:MMM yyyy})" +
                  (q.SeasonTotal is decimal total ? $": {Money.Format(total)} a season." : ".")
                : $"{text}, every month (set your operating season in the profile to be billed only in season).";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isOwner = TheaterAccess.HasFullAccess(User, Theater);
        steps = Theater.IsDemo ? await Onboarding.GetSetupStepsAsync(User, Theater.Id) : [];
        subscription = !Theater.IsDemo && isOwner ? (await Billing.GetTheaterBillingAsync(User, Theater.Id)).Subscription : null;
    }

    private async Task RequestAsync()
    {
        error = null;
        busy = true;
        try
        {
            await Onboarding.RequestGoLiveAsync(User, Theater.Id, acceptBilling, BaseUri);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is AppValidationException or AccessDeniedException or NotFoundException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
