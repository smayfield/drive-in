@page "/manage/{Id:int}/employees"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject TheaterAccess Access
@inject EmployeeService Employees
@inject InvitationService Invitations
@inject RoleService RoleManager

<PageTitle>Employees · Manage · Drive-In Online</PageTitle>

@if (theater is not null)
{
    <ManageHeader Theater="theater" Title="Employees" Current="employees" />
}

<Alerts Error="@Error" Success="@Success" />

@if (loaded)
{
    @if (Can(TheaterPermissions.InviteEmployees))
    {
        <section class="manage-section">
            <MudText Typo="Typo.h5">Invite an employee</MudText>
            <MudText Typo="Typo.body2" Class="muted mb-2">
                They'll get an email link to create an account for this theater, with a password or with Google.
                New employees have no roles, so they can't do anything until someone assigns them one.
            </MudText>
            <form class="d-flex flex-wrap gap-2 align-items-start" @onsubmit="InviteAsync">
                <MudTextField T="string" @bind-Value="inviteEmail" InputType="InputType.Email" Label="Email" Placeholder="name@example.com"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required Class="field-grow" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1">Send invite</MudButton>
            </form>
        </section>
    }

    @if (employees is not null)
    {
        <section class="manage-section">
            <div class="d-flex justify-content-between align-items-baseline">
                <MudText Typo="Typo.h5">Employees</MudText>
                @if (Can(TheaterPermissions.ManageRoles))
                {
                    <MudLink Href="@($"manage/{Id}/roles")">Manage roles</MudLink>
                }
            </div>
            @if (employees.Count == 0)
            {
                <MudText Class="muted">No employees yet.</MudText>
            }
            else
            {
                <MudSimpleTable Dense Hover Class="manage-table" Outlined>
                    <thead><tr><th>Employee</th><th>Roles</th><th>Sign-in</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in employees)
                        {
                            <tr @key="e.Id">
                                <td>
                                    <div>@(e.DisplayName ?? e.Email)</div>
                                    @if (e.DisplayName is not null) { <div class="small muted">@e.Email</div> }
                                    @if (e.IsLockedOut) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="my-0">Locked</MudChip> }
                                </td>
                                <td>
                                    @if (editingRolesFor == e.Id)
                                    {
                                        @foreach (var role in roles!)
                                        {
                                            var grantable = WithinMyAuthority(role);
                                            var roleId = role.Id;
                                            <div title="@(grantable ? role.Description : "This role has permissions you don't have.")">
                                                <MudCheckBox T="bool" Value="selectedRoles.Contains(roleId)" ValueChanged="on => ToggleRole(roleId, on)"
                                                             Disabled="@(!grantable)" Color="Color.Primary" Dense>
                                                    @role.Name
                                                    @if (!grantable) { <span class="muted small">(can't change)</span> }
                                                </MudCheckBox>
                                            </div>
                                        }
                                        @if (roles!.Count == 0)
                                        {
                                            <span class="muted small">No roles yet. <MudLink Href="@($"manage/{Id}/roles")">Create one</MudLink>.</span>
                                        }
                                        <div class="mt-2 d-flex gap-2">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveRolesAsync(e)">Save roles</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => editingRolesFor = null">Cancel</MudButton>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (e.Roles.Count == 0)
                                        {
                                            <span class="muted small">No roles</span>
                                        }
                                        @foreach (var r in e.Roles)
                                        {
                                            <MudChip T="string" Size="Size.Small" Class="my-0">@r.Name</MudChip>
                                        }
                                        @if (Can(TheaterPermissions.ManageRoles))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartEditRoles(e)">Edit</MudButton>
                                        }
                                    }
                                </td>
                                <td class="small">@(e.HasPassword ? "Password" : "Google only")</td>
                                <td class="text-end text-nowrap">
                                    @if (Can(TheaterPermissions.ManageEmployees))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResetAsync(e)">Send password reset</MudButton>
                                        @if (confirmDeleteId == e.Id)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteAsync(e)">Confirm delete</MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmDeleteId = e.Id">Delete</MudButton>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </section>
    }

    @if (pending is not null)
    {
        <section class="manage-section">
            <MudText Typo="Typo.h5">Pending invitations</MudText>
            @if (pending.Count == 0)
            {
                <MudText Class="muted">None.</MudText>
            }
            else
            {
                <MudSimpleTable Dense Hover Class="manage-table" Outlined>
                    <thead><tr><th>Email</th><th>Type</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in pending)
                        {
                            <tr @key="i.Id">
                                <td>@i.Email</td>
                                <td>@i.Kind</td>
                                <td>@(i.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : i.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy"))</td>
                                <td class="text-end text-nowrap">
                                    @if (Can(TheaterPermissions.InviteEmployees) && (i.Kind == InvitationKind.Employee || User.IsAdmin()))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResendAsync(i)">Resend</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => RevokeAsync(i)">Revoke</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </section>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private bool loaded;
    private Theater? theater;
    private IReadOnlySet<string> permissions = new HashSet<string>();
    private List<EmployeeSummary>? employees;
    private List<Invitation>? pending;
    private List<RoleSummary>? roles;
    private string inviteEmail = "";
    private string? confirmDeleteId;
    private string? editingRolesFor;
    private HashSet<int> selectedRoles = [];

    // UI only; every action is re-checked by the service.
    private bool Can(string permission) => permissions.Contains(permission);

    private bool WithinMyAuthority(RoleSummary role) => role.Permissions.All(permissions.Contains);

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        permissions = await Access.GetPermissionsAsync(User, theater);
        if (!EmployeeService.ListingPermissions.Any(Can) && !Can(TheaterPermissions.InviteEmployees))
            throw new AccessDeniedException();

        employees = EmployeeService.ListingPermissions.Any(Can) ? await Employees.ListAsync(User, Id) : null;
        pending = Can(TheaterPermissions.ViewEmployees) || Can(TheaterPermissions.InviteEmployees)
            ? await Invitations.ListPendingAsync(User, Id) : null;
        roles = Can(TheaterPermissions.ManageRoles) ? await RoleManager.ListAsync(User, Id) : null;
        confirmDeleteId = null;
        editingRolesFor = null;
        loaded = true;
    }

    private void StartEditRoles(EmployeeSummary e)
    {
        confirmDeleteId = null;
        editingRolesFor = e.Id;
        selectedRoles = e.Roles.Select(r => r.Id).ToHashSet();
    }

    private void ToggleRole(int roleId, bool on)
    {
        if (on) selectedRoles.Add(roleId); else selectedRoles.Remove(roleId);
    }

    private Task SaveRolesAsync(EmployeeSummary e) => RunAsync(async () =>
    {
        await Employees.SetRolesAsync(User, Id, e.Id, selectedRoles);
        await LoadAsync();
    }, $"Roles updated for {e.DisplayName ?? e.Email}.");

    private Task InviteAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(inviteEmail))
            throw new AppValidationException("Enter an email address.");
        await Invitations.InviteAsync(User, Id, inviteEmail, InvitationKind.Employee, BaseUri);
        inviteEmail = "";
        await LoadAsync();
    }, "Invitation sent.");

    private Task ResetAsync(EmployeeSummary e) =>
        RunAsync(() => Employees.SendPasswordResetAsync(User, Id, e.Id, BaseUri), $"Password reset email sent to {e.Email}.");

    private Task DeleteAsync(EmployeeSummary e) => RunAsync(async () =>
    {
        await Employees.DeleteAsync(User, Id, e.Id);
        await LoadAsync();
    }, $"Deleted {e.Email}.");

    private Task ResendAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.ResendAsync(User, i.Id, BaseUri);
        await LoadAsync();
    }, $"Invitation re-sent to {i.Email}.");

    private Task RevokeAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.RevokeAsync(User, i.Id);
        await LoadAsync();
    }, $"Invitation to {i.Email} revoked.");
}
