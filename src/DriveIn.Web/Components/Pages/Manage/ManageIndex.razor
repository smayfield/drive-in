@page "/manage"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters

<PageTitle>Manage · Drive-In Online</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Manage</MudText>

@if (theaters is null)
{
    <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading theaters" />
}
else if (theaters.Count == 0)
{
    <MudText Class="muted mb-2">You don't own or work at any theaters yet. If you've been invited, use the link in your invitation email.</MudText>
    @if (User.GetEmployeeTheaterId() is null)
    {
        <MudButton Href="get-started" Variant="Variant.Filled" Color="Color.Primary">Sign up your theater: start a free demo</MudButton>
    }
}
else
{
    <MudPaper Outlined>
        <MudList T="string" Dense>
            @foreach (var t in theaters)
            {
                <MudListItem Href="@($"manage/{t.Id}")" @key="t.Id">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span>
                            @t.Name
                            @if (!t.IsActive) { <MudChip T="string" Size="Size.Small" Class="ms-2 my-0">Inactive</MudChip> }
                            @if (t.IsDemo) { <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2 my-0">Demo</MudChip> }
                        </span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="my-0">@Role(t)</MudChip>
                    </div>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
    @if (User.GetEmployeeTheaterId() is null)
    {
        <MudText Class="mt-3"><MudLink Href="get-started">+ Sign up another theater</MudLink></MudText>
    }
    @if (!User.IsAdmin())
    {
        <MudText Class="mt-1">Questions? <MudLink Href="messages/new">Message Drive-In Online</MudLink>.</MudText>
    }
}

@code {
    private List<Theater>? theaters;

    protected override async Task LoadAsync() => theaters = await Theaters.ListManagedAsync(User);

    private string Role(Theater t) =>
        t.OwnerId == User.GetUserId() ? "Owner"
        : User.GetEmployeeTheaterId() == t.Id ? "Employee"
        : "Admin";
}
