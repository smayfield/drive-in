@page "/manage"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters

<PageTitle>Manage · Drive-In Online</PageTitle>

<h1>Manage</h1>

@if (theaters is null)
{
    <p>Loading…</p>
}
else if (theaters.Count == 0)
{
    <p class="text-muted">You don't own or work at any theaters yet. If you've been invited, use the link in your invitation email.</p>
}
else
{
    <div class="list-group">
        @foreach (var t in theaters)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="manage/@t.Id">
                <span>@t.Name @if (!t.IsActive) { <span class="badge text-bg-secondary ms-2">Inactive</span> }</span>
                <span class="badge text-bg-light">@Role(t)</span>
            </a>
        }
    </div>
}

@code {
    private List<Theater>? theaters;

    protected override async Task LoadAsync() => theaters = await Theaters.ListManagedAsync(User);

    private string Role(Theater t) =>
        t.OwnerId == User.GetUserId() ? "Owner"
        : User.GetEmployeeTheaterId() == t.Id ? "Employee"
        : "Admin";
}
