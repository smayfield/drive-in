@page "/manage/{Id:int}/pricing"
@attribute [Authorize]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject PricingService Pricing
@inject TheaterAccess Access

<PageTitle>Pricing · Manage · Drive-In Online</PageTitle>

@if (pricing is null || theater is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading pricing" /> }
}
else
{
    <ManageHeader Theater="theater" Title="Pricing" Current="pricing" />
    <MudText Class="muted mb-3">
        A price schedule lists the ways a spot can be bought, such as 1 occupant, 2 occupants or a car load.
        Showtimes use the default schedule unless you pick another one for them on the <MudLink Href="@($"manage/{Id}/schedule")">schedule</MudLink>,
        e.g. for 3D movies or special showings.
    </MudText>

    <Alerts Error="@Error" Success="@Success" />

    <section class="manage-section">
        <MudText Typo="Typo.h5">Price schedules</MudText>
        @foreach (var schedule in pricing.Schedules)
        {
            <MudPaper Outlined Class="pa-3 mb-3" @key="schedule.Id">
                @if (editor?.Id == schedule.Id)
                {
                    <MudTextField T="string" @bind-Value="editor.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60"
                                  Style="max-width: 24rem" Class="mb-3" />
                    <MudSimpleTable Dense Outlined Class="manage-table mb-2">
                        <thead><tr><th style="width: 6rem"></th><th>Option</th><th>Description</th><th style="width: 9rem">Price</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < editor.Options.Count; i++)
                            {
                                var option = editor.Options[i];
                                var index = i;
                                <tr @key="option">
                                    <td class="text-nowrap">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)" aria-label="Move up" OnClick="() => editor.Move(index, -1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == editor.Options.Count - 1)" aria-label="Move down" OnClick="() => editor.Move(index, 1)" />
                                    </td>
                                    <td><MudTextField T="string" @bind-Value="option.Name" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60" Placeholder="e.g. 2 occupants" aria-label="Option name" /></td>
                                    <td><MudTextField T="string" @bind-Value="option.Description" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" aria-label="Option description" /></td>
                                    <td><MudNumericField T="decimal" @bind-Value="option.Price" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="F2" HideSpinButtons Adornment="Adornment.Start" AdornmentText="$" aria-label="Price" /></td>
                                    <td class="text-end"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" aria-label="Remove option" OnClick="() => editor.Options.Remove(option)" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mb-3" Disabled="@(editor.Options.Count >= PriceOption.MaxPerSchedule)"
                               OnClick="() => editor.Options.Add(new OptionDraft())">Add option</MudButton>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveScheduleAsync">Save</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="() => editor = null">Cancel</MudButton>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <MudText Typo="Typo.h6">
                            @schedule.Name
                            @if (schedule.IsDefault) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ms-1 my-0">Default</MudChip> }
                        </MudText>
                        @if (canManage)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => StartEdit(schedule)">Edit</MudButton>
                                @if (!schedule.IsDefault)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => MakeDefaultAsync(schedule)">Make default</MudButton>
                                    @if (confirmDeleteScheduleId == schedule.Id)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteScheduleAsync(schedule)">Confirm delete</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmDeleteScheduleId = schedule.Id">Delete</MudButton>
                                    }
                                }
                            </div>
                        }
                    </div>
                    @if (schedule.Options.Count == 0)
                    {
                        <MudText Class="muted">No prices yet.@if (canManage) { <span> Choose Edit to add options such as "1 occupant" or "Car load".</span> }</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense Style="box-shadow: none; background: transparent">
                            <tbody>
                                @foreach (var option in schedule.Options)
                                {
                                    <tr>
                                        <td>@option.Name @if (option.Description is not null) { <span class="muted small ms-1">@option.Description</span> }</td>
                                        <td class="text-end" style="width: 8rem">@Money.Format(option.Price)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            </MudPaper>
        }

        @if (canManage)
        {
            <div class="d-flex flex-wrap gap-2 align-items-start" style="max-width: 44rem">
                <MudTextField T="string" @bind-Value="newScheduleName" Label="New schedule" Placeholder="e.g. 3D" Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="60" Class="field-grow" />
                <MudSelect T="int" @bind-Value="copyFromId" Label="Start from" Variant="Variant.Outlined" Margin="Margin.Dense" Class="field-grow">
                    <MudSelectItem T="int" Value="0">Nothing</MudSelectItem>
                    @foreach (var s in pricing.Schedules)
                    {
                        <MudSelectItem T="int" Value="@s.Id">Copy of @s.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-1" OnClick="CreateScheduleAsync">Create</MudButton>
            </div>
        }
    </section>

    <section class="manage-section">
        <MudText Typo="Typo.h5">Add-ons</MudText>
        <MudText Class="muted mb-2">Fees (such as bringing in outside food) and discounts (such as for veterans or seniors) that can be added to a ticket.</MudText>
        <MudSimpleTable Dense Outlined Class="manage-table">
            <thead>
                <tr>
                    <th>Name</th><th>Description</th><th style="width: 11rem">Type</th><th style="width: 9rem">Amount</th><th style="width: 5rem">Active</th>
                    @if (canManage) { <th style="width: 13rem"></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var addOn in pricing.AddOns)
                {
                    <tr @key="addOn.Id" class="@(addOn.IsActive ? null : "muted")">
                        @if (editingAddOn?.Id == addOn.Id)
                        {
                            <AddOnFields Draft="editingAddOn" />
                            <td class="text-end text-nowrap">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddOnAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => editingAddOn = null">Cancel</MudButton>
                            </td>
                        }
                        else
                        {
                            <td>@addOn.Name</td>
                            <td class="small">@addOn.Description</td>
                            <td>@KindName(addOn.Kind)</td>
                            <td>@addOn.Display</td>
                            <td>@(addOn.IsActive ? "Yes" : "No")</td>
                            @if (canManage)
                            {
                                <td class="text-end text-nowrap">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => StartEditAddOn(addOn)">Edit</MudButton>
                                    @if (confirmDeleteAddOnId == addOn.Id)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteAddOnAsync(addOn)">Confirm delete</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => { confirmDeleteAddOnId = addOn.Id; editingAddOn = null; }">Delete</MudButton>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
                @if (canManage)
                {
                    <tr>
                        <AddOnFields Draft="newAddOn" />
                        <td class="text-end"><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAddOnAsync">Add</MudButton></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (pricing.AddOns.Count == 0 && !canManage)
        {
            <MudText Class="muted">No add-ons.</MudText>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    internal sealed class OptionDraft
    {
        public int? Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public decimal Price { get; set; }
    }

    private sealed class ScheduleDraft
    {
        public int Id { get; init; }
        public string Name { get; set; } = "";
        public List<OptionDraft> Options { get; set; } = [];

        public void Move(int index, int direction)
        {
            var target = index + direction;
            if (target >= 0 && target < Options.Count)
                (Options[index], Options[target]) = (Options[target], Options[index]);
        }
    }

    private TheaterPricing? pricing;
    private Theater? theater;
    private bool canManage;
    private ScheduleDraft? editor;
    private string newScheduleName = "";
    private int copyFromId;
    private int? confirmDeleteScheduleId;
    private AddOnDraft newAddOn = new();
    private AddOnDraft? editingAddOn;
    private int? confirmDeleteAddOnId;

    internal static string KindName(AddOnKind kind) => kind switch
    {
        AddOnKind.Fee => "Fee",
        AddOnKind.Discount => "Discount ($)",
        AddOnKind.PercentDiscount => "Discount (%)",
        _ => kind.ToString(),
    };

    protected override async Task LoadAsync()
    {
        theater = await Theaters.GetForManageAsync(User, Id);
        canManage = (await Access.GetPermissionsAsync(User, theater)).Contains(TheaterPermissions.ManagePricing);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        pricing = await Pricing.GetAsync(User, Id);
        editor = null;
        editingAddOn = null;
        confirmDeleteScheduleId = null;
        confirmDeleteAddOnId = null;
    }

    private void StartEdit(PriceSchedule schedule)
    {
        confirmDeleteScheduleId = null;
        editor = new ScheduleDraft
        {
            Id = schedule.Id,
            Name = schedule.Name,
            Options = schedule.Options.Select(o => new OptionDraft { Id = o.Id, Name = o.Name, Description = o.Description, Price = o.Price }).ToList(),
        };
    }

    private Task SaveScheduleAsync() => RunAsync(async () =>
    {
        await Pricing.UpdateScheduleAsync(User, editor!.Id, editor.Name,
            editor.Options.Select(o => new PriceOptionInput(o.Id, o.Name, o.Description, o.Price)).ToList());
        await ReloadAsync();
    }, "Price schedule saved.");

    private Task CreateScheduleAsync() => RunAsync(async () =>
    {
        var schedule = await Pricing.CreateScheduleAsync(User, Id, newScheduleName, copyFromId == 0 ? null : copyFromId);
        newScheduleName = "";
        copyFromId = 0;
        await ReloadAsync();
        StartEdit(pricing!.Schedules.Single(s => s.Id == schedule.Id));
    });

    private Task MakeDefaultAsync(PriceSchedule schedule) => RunAsync(async () =>
    {
        await Pricing.SetDefaultScheduleAsync(User, schedule.Id);
        await ReloadAsync();
    }, $"{schedule.Name} is now the default.");

    private Task DeleteScheduleAsync(PriceSchedule schedule) => RunAsync(async () =>
    {
        try
        {
            await Pricing.DeleteScheduleAsync(User, schedule.Id);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private void StartEditAddOn(AddOn addOn)
    {
        confirmDeleteAddOnId = null;
        editingAddOn = AddOnDraft.From(addOn);
    }

    private Task AddAddOnAsync() => RunAsync(async () =>
    {
        await Pricing.AddAddOnAsync(User, Id, newAddOn.ToInput());
        newAddOn = new();
        await ReloadAsync();
    });

    private Task SaveAddOnAsync() => RunAsync(async () =>
    {
        await Pricing.UpdateAddOnAsync(User, editingAddOn!.Id, editingAddOn.ToInput());
        await ReloadAsync();
    });

    private Task DeleteAddOnAsync(AddOn addOn) => RunAsync(async () =>
    {
        await Pricing.DeleteAddOnAsync(User, addOn.Id);
        await ReloadAsync();
    });
}
