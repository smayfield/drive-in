@page "/manage/{Id:int}/pricing"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AppComponentBase
@inject TheaterService Theaters
@inject PricingService Pricing
@inject TheaterAccess Access

<PageTitle>Pricing · Manage · Drive-In Online</PageTitle>

<p><a href="manage/@Id">&larr; Back to theater</a> · <a href="manage/@Id/schedule">Schedule</a></p>

@if (pricing is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <p>Loading…</p> }
}
else
{
    <h1>Pricing <small class="text-muted fs-5">@theaterName</small></h1>
    <p class="text-muted">
        A price schedule lists the ways a spot can be bought, such as 1 occupant, 2 occupants or a car load.
        Showtimes use the default schedule unless you pick another one for them on the <a href="manage/@Id/schedule">schedule</a>,
        e.g. for 3D movies or special showings.
    </p>

    <Alerts Error="@Error" Success="@Success" />

    <section class="mb-5">
        <h2 class="h4">Price schedules</h2>
        @foreach (var schedule in pricing.Schedules)
        {
            <div class="card mb-3" @key="schedule.Id">
                <div class="card-body">
                    @if (editor?.Id == schedule.Id)
                    {
                        <div class="mb-3" style="max-width: 24rem">
                            <label class="form-label" for="schedule-name">Name</label>
                            <input id="schedule-name" class="form-control" @bind="editor.Name" maxlength="60" />
                        </div>
                        <table class="table table-sm align-middle">
                            <thead><tr><th style="width: 5rem"></th><th>Option</th><th>Description</th><th style="width: 9rem">Price</th><th></th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < editor.Options.Count; i++)
                                {
                                    var option = editor.Options[i];
                                    var index = i;
                                    <tr @key="option">
                                        <td>
                                            <button class="btn btn-sm btn-link px-1" disabled="@(index == 0)" title="Move up" aria-label="Move up" @onclick="() => editor.Move(index, -1)">▲</button>
                                            <button class="btn btn-sm btn-link px-1" disabled="@(index == editor.Options.Count - 1)" title="Move down" aria-label="Move down" @onclick="() => editor.Move(index, 1)">▼</button>
                                        </td>
                                        <td><input class="form-control form-control-sm" @bind="option.Name" maxlength="60" placeholder="e.g. 2 occupants" aria-label="Option name" /></td>
                                        <td><input class="form-control form-control-sm" @bind="option.Description" maxlength="200" aria-label="Option description" /></td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">$</span>
                                                <input class="form-control" type="number" min="0" step="0.01" @bind="option.Price" aria-label="Price" />
                                            </div>
                                        </td>
                                        <td class="text-end"><button class="btn btn-sm btn-link text-danger px-1" title="Remove option" aria-label="Remove option" @onclick="() => editor.Options.Remove(option)">✕</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button class="btn btn-sm btn-outline-secondary mb-3" disabled="@(editor.Options.Count >= PriceOption.MaxPerSchedule)"
                                @onclick="() => editor.Options.Add(new OptionDraft())">Add option</button>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveScheduleAsync">Save</button>
                            <button class="btn btn-outline-secondary" @onclick="() => editor = null">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <h3 class="h5 mb-0">
                                @schedule.Name
                                @if (schedule.IsDefault) { <span class="badge text-bg-primary ms-1">Default</span> }
                            </h3>
                            @if (canManage)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(schedule)">Edit</button>
                                    @if (!schedule.IsDefault)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => MakeDefaultAsync(schedule)">Make default</button>
                                        @if (confirmDeleteScheduleId == schedule.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteScheduleAsync(schedule)">Confirm delete</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteScheduleId = schedule.Id">Delete</button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (schedule.Options.Count == 0)
                        {
                            <p class="text-muted mb-0">No prices yet.@if (canManage) { <span> Choose Edit to add options such as "1 occupant" or "Car load".</span> }</p>
                        }
                        else
                        {
                            <table class="table table-sm mb-0">
                                <tbody>
                                    @foreach (var option in schedule.Options)
                                    {
                                        <tr>
                                            <td>@option.Name @if (option.Description is not null) { <span class="text-muted small ms-1">@option.Description</span> }</td>
                                            <td class="text-end" style="width: 8rem">@Money.Format(option.Price)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        }

        @if (canManage)
        {
            <div class="row g-2 align-items-end" style="max-width: 44rem">
                <div class="col-sm-5">
                    <label class="form-label" for="new-schedule">New schedule</label>
                    <input id="new-schedule" class="form-control" @bind="newScheduleName" maxlength="60" placeholder="e.g. 3D" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="copy-from">Start from</label>
                    <select id="copy-from" class="form-select" @bind="copyFromId">
                        <option value="0">Nothing</option>
                        @foreach (var s in pricing.Schedules)
                        {
                            <option value="@s.Id">Copy of @s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <button class="btn btn-success w-100" @onclick="CreateScheduleAsync">Create</button>
                </div>
            </div>
        }
    </section>

    <section>
        <h2 class="h4">Add-ons</h2>
        <p class="text-muted">Fees (such as bringing in outside food) and discounts (such as for veterans or seniors) that can be added to a ticket.</p>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th><th>Description</th><th style="width: 11rem">Type</th><th style="width: 9rem">Amount</th><th style="width: 5rem">Active</th>
                    @if (canManage) { <th style="width: 13rem"></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var addOn in pricing.AddOns)
                {
                    <tr @key="addOn.Id" class="@(addOn.IsActive ? null : "text-muted")">
                        @if (editingAddOn?.Id == addOn.Id)
                        {
                            <AddOnFields Draft="editingAddOn" />
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary" @onclick="SaveAddOnAsync">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => editingAddOn = null">Cancel</button>
                            </td>
                        }
                        else
                        {
                            <td>@addOn.Name</td>
                            <td class="small">@addOn.Description</td>
                            <td>@KindName(addOn.Kind)</td>
                            <td>@addOn.Display</td>
                            <td>@(addOn.IsActive ? "Yes" : "No")</td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditAddOn(addOn)">Edit</button>
                                    @if (confirmDeleteAddOnId == addOn.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAddOnAsync(addOn)">Confirm delete</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => { confirmDeleteAddOnId = addOn.Id; editingAddOn = null; }">Delete</button>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
                @if (canManage)
                {
                    <tr>
                        <AddOnFields Draft="newAddOn" />
                        <td class="text-end"><button class="btn btn-sm btn-success" @onclick="AddAddOnAsync">Add</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (pricing.AddOns.Count == 0 && !canManage)
        {
            <p class="text-muted">No add-ons.</p>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    internal sealed class OptionDraft
    {
        public int? Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public decimal Price { get; set; }
    }

    private sealed class ScheduleDraft
    {
        public int Id { get; init; }
        public string Name { get; set; } = "";
        public List<OptionDraft> Options { get; set; } = [];

        public void Move(int index, int direction)
        {
            var target = index + direction;
            if (target >= 0 && target < Options.Count)
                (Options[index], Options[target]) = (Options[target], Options[index]);
        }
    }

    private TheaterPricing? pricing;
    private string? theaterName;
    private bool canManage;
    private ScheduleDraft? editor;
    private string newScheduleName = "";
    private int copyFromId;
    private int? confirmDeleteScheduleId;
    private AddOnDraft newAddOn = new();
    private AddOnDraft? editingAddOn;
    private int? confirmDeleteAddOnId;

    internal static string KindName(AddOnKind kind) => kind switch
    {
        AddOnKind.Fee => "Fee",
        AddOnKind.Discount => "Discount ($)",
        AddOnKind.PercentDiscount => "Discount (%)",
        _ => kind.ToString(),
    };

    protected override async Task LoadAsync()
    {
        var theater = await Theaters.GetForManageAsync(User, Id);
        theaterName = theater.Name;
        canManage = (await Access.GetPermissionsAsync(User, theater)).Contains(TheaterPermissions.ManagePricing);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        pricing = await Pricing.GetAsync(User, Id);
        editor = null;
        editingAddOn = null;
        confirmDeleteScheduleId = null;
        confirmDeleteAddOnId = null;
    }

    private void StartEdit(PriceSchedule schedule)
    {
        confirmDeleteScheduleId = null;
        editor = new ScheduleDraft
        {
            Id = schedule.Id,
            Name = schedule.Name,
            Options = schedule.Options.Select(o => new OptionDraft { Id = o.Id, Name = o.Name, Description = o.Description, Price = o.Price }).ToList(),
        };
    }

    private Task SaveScheduleAsync() => RunAsync(async () =>
    {
        await Pricing.UpdateScheduleAsync(User, editor!.Id, editor.Name,
            editor.Options.Select(o => new PriceOptionInput(o.Id, o.Name, o.Description, o.Price)).ToList());
        await ReloadAsync();
    }, "Price schedule saved.");

    private Task CreateScheduleAsync() => RunAsync(async () =>
    {
        var schedule = await Pricing.CreateScheduleAsync(User, Id, newScheduleName, copyFromId == 0 ? null : copyFromId);
        newScheduleName = "";
        copyFromId = 0;
        await ReloadAsync();
        StartEdit(pricing!.Schedules.Single(s => s.Id == schedule.Id));
    });

    private Task MakeDefaultAsync(PriceSchedule schedule) => RunAsync(async () =>
    {
        await Pricing.SetDefaultScheduleAsync(User, schedule.Id);
        await ReloadAsync();
    }, $"{schedule.Name} is now the default.");

    private Task DeleteScheduleAsync(PriceSchedule schedule) => RunAsync(async () =>
    {
        try
        {
            await Pricing.DeleteScheduleAsync(User, schedule.Id);
        }
        finally
        {
            await ReloadAsync();
        }
    });

    private void StartEditAddOn(AddOn addOn)
    {
        confirmDeleteAddOnId = null;
        editingAddOn = AddOnDraft.From(addOn);
    }

    private Task AddAddOnAsync() => RunAsync(async () =>
    {
        await Pricing.AddAddOnAsync(User, Id, newAddOn.ToInput());
        newAddOn = new();
        await ReloadAsync();
    });

    private Task SaveAddOnAsync() => RunAsync(async () =>
    {
        await Pricing.UpdateAddOnAsync(User, editingAddOn!.Id, editingAddOn.ToInput());
        await ReloadAsync();
    });

    private Task DeleteAddOnAsync(AddOn addOn) => RunAsync(async () =>
    {
        await Pricing.DeleteAddOnAsync(User, addOn.Id);
        await ReloadAsync();
    });
}
