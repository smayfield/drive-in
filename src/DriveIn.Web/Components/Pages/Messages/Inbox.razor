@page "/messages"
@attribute [Authorize]
@inherits AppComponentBase
@inject MessagingService Messaging

<PageTitle>Messages · Drive-In Online</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1">Messages</MudText>
    <MudButton Href="messages/new" Variant="Variant.Outlined" Color="Color.Primary">Contact Drive-In Online</MudButton>
</div>
<MudText Class="muted mb-3">
    Your conversations with theaters and with us. To message a theater, use "Message the theater" on its page.
</MudText>

<Alerts Error="@Error" />

@if (items is null)
{
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading messages" /> }
}
else
{
    <ConversationList Items="items" Href="@(c => $"messages/{c.Id}")" Show="theater"
                      Empty="No messages yet. Message a theater from its page, or contact us with the button above." />
}

@code {
    private List<ConversationSummary>? items;

    protected override async Task LoadAsync() => items = await Messaging.ListMineAsync(User);
}
