@page "/get-started"
@rendermode InteractiveServer
@inherits AppComponentBase
@inject OnboardingService Onboarding

<PageTitle>Start your free demo · Drive-In Online</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1>Start your free demo</h1>
        <p class="lead">
            Set up your drive-in in demo mode: it's private and free, and you can try everything, including test ticket sales,
            before you go live.
        </p>

        @if (!signedIn)
        {
            <section class="card">
                <div class="card-body">
                    <h2 class="h5">First, your account</h2>
                    <p>Create a free account (or sign in) and come back here to set up your theater.</p>
                    <a class="btn btn-primary" href="Account/Register?ReturnUrl=%2Fget-started">Create account</a>
                    <a class="btn btn-outline-secondary" href="Account/Login?ReturnUrl=%2Fget-started">Sign in</a>
                </div>
            </section>
        }
        else if (User.GetEmployeeTheaterId() is not null)
        {
            <div class="alert alert-info">
                You're signed in with an employee account, which belongs to one theater. To sign up your own theater,
                sign out and create a personal account.
            </div>
        }
        else
        {
            <Alerts Error="@Error" />
            <section class="card">
                <div class="card-body">
                    <EditForm Model="form" OnSubmit="CreateAsync" FormName="get-started">
                        <div class="mb-3">
                            <label class="form-label" for="gs-name">Theater name</label>
                            <InputText id="gs-name" class="form-control" @bind-Value="form.Name" @bind-Value:after="NameChanged" maxlength="200" placeholder="Starlight Drive-In" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="gs-slug">Web address</label>
                            <div class="input-group">
                                <span class="input-group-text">drive-in.online/theaters/</span>
                                <InputText id="gs-slug" class="form-control" @bind-Value="form.Slug" @bind-Value:after="() => slugEdited = true" maxlength="100" />
                            </div>
                            <div class="form-text">Lowercase letters, digits and hyphens. You can ask us to change it later.</div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-7">
                                <label class="form-label" for="gs-city">City</label>
                                <InputText id="gs-city" class="form-control" @bind-Value="form.City" maxlength="100" />
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label" for="gs-state">State</label>
                                <InputText id="gs-state" class="form-control" @bind-Value="form.State" maxlength="100" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-7">
                                <label class="form-label" for="gs-tz">Time zone</label>
                                <InputSelect id="gs-tz" class="form-select" @bind-Value="form.TimeZone">
                                    <option value="">Choose…</option>
                                    @foreach (var (id, label) in TimeZones)
                                    {
                                        <option value="@id">@label</option>
                                    }
                                </InputSelect>
                                <div class="form-text">Outside these? Pick the closest; you can enter any time zone in your profile.</div>
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label" for="gs-screens">Screens</label>
                                <InputSelect id="gs-screens" class="form-select" @bind-Value="form.Screens">
                                    @for (var n = 1; n <= OnboardingService.MaxScreens; n++)
                                    {
                                        <option value="@n">@n</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="form-check mb-3">
                            <InputCheckbox id="gs-terms" class="form-check-input" @bind-Value="form.AcceptTerms" />
                            <label class="form-check-label" for="gs-terms">
                                I agree to the <a href="legal/terms" target="_blank">Terms of Service</a> and
                                <a href="legal/privacy" target="_blank">Privacy Policy</a>.
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@busy">@(busy ? "Setting up…" : "Create my demo theater")</button>
                    </EditForm>
                </div>
            </section>
            <p class="text-muted small mt-3">
                We'll start you with sample screens and prices so you can try a sale right away; you'll change them as you set up.
                Going live (and billing) only happens when you ask. See <a href="pricing">Pricing</a>.
            </p>
        }
    </div>
</div>

@code {
    private sealed class Form
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string? City { get; set; }
        public string? State { get; set; }
        public string TimeZone { get; set; } = "";
        public int Screens { get; set; } = 1;
        public bool AcceptTerms { get; set; }
    }

    private static readonly (string Id, string Label)[] TimeZones =
    [
        ("America/New_York", "Eastern (New York)"),
        ("America/Chicago", "Central (Chicago)"),
        ("America/Denver", "Mountain (Denver)"),
        ("America/Phoenix", "Mountain, no DST (Phoenix)"),
        ("America/Los_Angeles", "Pacific (Los Angeles)"),
        ("America/Anchorage", "Alaska (Anchorage)"),
        ("Pacific/Honolulu", "Hawaii (Honolulu)"),
        ("America/Halifax", "Atlantic (Halifax)"),
        ("America/St_Johns", "Newfoundland (St. John's)"),
    ];

    private Form form = new();
    private bool signedIn;
    private bool slugEdited;
    private bool busy;

    protected override Task LoadAsync()
    {
        signedIn = User.Identity?.IsAuthenticated == true;
        return Task.CompletedTask;
    }

    private void NameChanged()
    {
        if (!slugEdited)
            form.Slug = string.IsNullOrWhiteSpace(form.Name) ? "" : OnboardingService.Slugify(form.Name);
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        if (busy)
            return;
        busy = true;
        try
        {
            var theater = await Onboarding.CreateDemoTheaterAsync(User, new NewTheaterInput(
                form.Name, form.City, form.State, form.TimeZone, form.Screens, form.AcceptTerms, slugEdited ? form.Slug : null));
            // A full load, so the nav bar picks up the new Manage link.
            Nav.NavigateTo($"manage/{theater.Id}", forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    });
}
