@page "/get-started"
@inherits AppComponentBase
@inject OnboardingService Onboarding

<PageTitle>Start your free demo · Drive-In Online</PageTitle>

<div class="mx-auto" style="max-width: 44rem">
    <MudText Typo="Typo.h3" HtmlTag="h1" Class="mb-2">Start your free demo</MudText>
    <MudText Class="muted mb-4">
        Set up your drive-in in demo mode: it's private and free, and you can try everything, including test ticket sales,
        before you go live.
    </MudText>

    @if (!signedIn)
    {
        <MudPaper Outlined Class="pa-4">
            <MudText Typo="Typo.h5" Class="mb-1">First, your account</MudText>
            <MudText Class="mb-3">Create a free account (or sign in) and come back here to set up your theater.</MudText>
            <MudButton Href="Account/Register?ReturnUrl=%2Fget-started" Variant="Variant.Filled" Color="Color.Primary" Class="me-2">Create account</MudButton>
            <MudButton Href="Account/Login?ReturnUrl=%2Fget-started" Variant="Variant.Outlined">Sign in</MudButton>
        </MudPaper>
    }
    else if (User.GetEmployeeTheaterId() is not null)
    {
        <MudAlert Severity="Severity.Info">
            You're signed in with an employee account, which belongs to one theater. To sign up your own theater,
            sign out and create a personal account.
        </MudAlert>
    }
    else
    {
        <Alerts Error="@Error" />
        <MudPaper Outlined Class="pa-4">
            <EditForm Model="form" OnSubmit="CreateAsync" FormName="get-started">
                <MudTextField T="string" @bind-Value="form.Name" @bind-Value:after="NameChanged" Immediate Label="Theater name" Variant="Variant.Outlined"
                              MaxLength="200" Placeholder="Starlight Drive-In" Class="mb-3" />
                <MudTextField T="string" @bind-Value="form.Slug" @bind-Value:after="() => slugEdited = true" Label="Web address" Variant="Variant.Outlined"
                              MaxLength="100" Adornment="Adornment.Start" AdornmentText="drive-in.online/theaters/"
                              HelperText="Lowercase letters, digits and hyphens. You can ask us to change it later." Class="mb-3" />
                <MudGrid Spacing="2" Class="mb-1">
                    <MudItem xs="12" sm="7">
                        <MudTextField T="string" @bind-Value="form.City" Label="City" Variant="Variant.Outlined" MaxLength="100" />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudTextField T="string" @bind-Value="form.State" Label="State" Variant="Variant.Outlined" MaxLength="100" />
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudSelect T="string" @bind-Value="form.TimeZone" Label="Time zone" Variant="Variant.Outlined"
                                   HelperText="Outside these? Pick the closest; you can enter any time zone in your profile.">
                            @foreach (var (id, label) in TimeZones)
                            {
                                <MudSelectItem T="string" Value="@id">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="int" @bind-Value="form.Screens" Label="Screens" Variant="Variant.Outlined">
                            @for (var n = 1; n <= OnboardingService.MaxScreens; n++)
                            {
                                var count = n; // a copy: the item's content is rendered later
                                <MudSelectItem T="int" Value="@count">@count</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudCheckBox T="bool" @bind-Value="form.AcceptTerms" Color="Color.Primary" Class="mb-3">
                    I agree to the <MudLink Href="legal/terms" Target="_blank">Terms of Service</MudLink> and
                    <MudLink Href="legal/privacy" Target="_blank">Privacy Policy</MudLink>.
                </MudCheckBox>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@busy">
                    @(busy ? "Setting up…" : "Create my demo theater")
                </MudButton>
            </EditForm>
        </MudPaper>
        <MudText Typo="Typo.body2" Class="muted mt-3">
            We'll start you with sample screens and prices so you can try a sale right away; you'll change them as you set up.
            Going live (and billing) only happens when you ask. See <MudLink Href="pricing">Pricing</MudLink>.
            Questions first? <MudLink Href="messages/new">Message us</MudLink>.
        </MudText>
    }
</div>

@code {
    private sealed class Form
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string? City { get; set; }
        public string? State { get; set; }
        public string TimeZone { get; set; } = "";
        public int Screens { get; set; } = 1;
        public bool AcceptTerms { get; set; }
    }

    private static readonly (string Id, string Label)[] TimeZones =
    [
        ("America/New_York", "Eastern (New York)"),
        ("America/Chicago", "Central (Chicago)"),
        ("America/Denver", "Mountain (Denver)"),
        ("America/Phoenix", "Mountain, no DST (Phoenix)"),
        ("America/Los_Angeles", "Pacific (Los Angeles)"),
        ("America/Anchorage", "Alaska (Anchorage)"),
        ("Pacific/Honolulu", "Hawaii (Honolulu)"),
        ("America/Halifax", "Atlantic (Halifax)"),
        ("America/St_Johns", "Newfoundland (St. John's)"),
    ];

    private Form form = new();
    private bool signedIn;
    private bool slugEdited;
    private bool busy;

    protected override Task LoadAsync()
    {
        signedIn = User.Identity?.IsAuthenticated == true;
        return Task.CompletedTask;
    }

    private void NameChanged()
    {
        if (!slugEdited)
            form.Slug = string.IsNullOrWhiteSpace(form.Name) ? "" : OnboardingService.Slugify(form.Name);
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        if (busy)
            return;
        busy = true;
        try
        {
            var theater = await Onboarding.CreateDemoTheaterAsync(User, new NewTheaterInput(
                form.Name, form.City, form.State, form.TimeZone, form.Screens, form.AcceptTerms, slugEdited ? form.Slug : null));
            // A full load, so the nav bar picks up the new Manage link.
            Nav.NavigateTo($"manage/{theater.Id}", forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    });
}
