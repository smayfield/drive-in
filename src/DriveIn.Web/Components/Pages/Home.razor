@page "/"
@attribute [ExcludeFromInteractiveRouting]
@layout MarketingLayout

<PageTitle>Drive-In Online · Software for drive-in theaters</PageTitle>
<HeadContent>
    <meta name="description" content="Turn-key software for drive-in theaters: sell tickets by the spot online and at the gate, schedule showtimes, and manage staff. Free demo; billed only in season." />
</HeadContent>

<header class="hero">
    <canvas class="stars" aria-hidden="true"></canvas>
    <div class="beam" aria-hidden="true"></div>

    <div class="topbar">
        <a class="cta" href="features">Features</a>
        <a class="cta" href="pricing">Pricing</a>
        <AuthorizeView>
            <Authorized>
                <a class="cta" href="theaters">Open the app</a>
            </Authorized>
            <NotAuthorized>
                <a class="cta" href="Account/Login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="wrap hero-inner">
        <div class="marquee reveal">
            <p class="eyebrow">Now showing</p>
            <h1 class="title"><span class="shade">Drive-In</span> Online</h1>
            <p class="tagline">Turn-key software for drive-in theaters</p>
        </div>

        <p class="lede reveal">Sell tickets by the carload, fill the lot, and keep the concession stand humming. Everything your drive-in needs, all in one place.</p>
        <div class="cta-row reveal">
            <a class="cta cta-bulb" href="get-started">Start your free demo</a>
            <a class="cta" href="pricing">See pricing</a>
        </div>
    </div>

    <svg class="cars" viewBox="0 0 1200 120" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#05060f">
            <rect x="0" y="104" width="1200" height="16"/>
            <path d="M40 104v-22c0-6 4-10 10-11l30-4 24-20c4-3 8-5 13-5h58c6 0 11 3 14 7l17 20 34 5c6 1 10 5 10 11v19z"/>
            <path d="M300 104v-18c0-5 4-9 9-10l40-6 30-22c4-3 9-4 14-4h70c6 0 11 3 15 7l20 22 30 4c5 1 9 5 9 10v17z"/>
            <path d="M600 104v-24c0-6 4-10 10-11h20l12-26c2-5 7-8 12-8h86c5 0 10 3 12 8l12 26h24c6 1 10 5 10 11v24z"/>
            <path d="M880 104v-20c0-6 4-10 10-11l34-5 26-22c4-3 8-4 13-4h62c6 0 11 3 14 7l18 21 30 4c6 1 10 5 10 11v19z"/>
            <circle cx="75" cy="106" r="12"/><circle cx="215" cy="106" r="12"/>
            <circle cx="345" cy="106" r="12"/><circle cx="505" cy="106" r="12"/>
            <circle cx="640" cy="106" r="13"/><circle cx="790" cy="106" r="13"/>
            <circle cx="915" cy="106" r="12"/><circle cx="1065" cy="106" r="12"/>
        </g>
    </svg>
</header>

<main class="wrap">
    <h2 class="reveal">What's Playing</h2>
    <p class="section-lede reveal">One system for the whole night, from the box office to the last reel.</p>

    <div class="grid">
        <article class="card reveal">
            <span class="icon" aria-hidden="true">🎟️</span>
            <h3>Online ticket sales</h3>
            <p>Guests pick their exact spot on a live map of your lot and pay by card. A spot is held while they check out, so it's never sold twice.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">🚦</span>
            <h3>The gate</h3>
            <p>Scan the QR code or type a 4-character gate code to check cars in, and sell tickets to drive-ups from the same screen.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">🎬</span>
            <h3>Showtimes &amp; screens</h3>
            <p>Lay out each screen's rows of spots, and schedule single films or double features with intermissions.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">💵</span>
            <h3>Your prices</h3>
            <p>Price by the car or by the carload, with add-ons like outside-food fees and senior or veteran discounts.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">👥</span>
            <h3>Staff &amp; roles</h3>
            <p>Invite your crew and choose exactly what each role can do, from the box office to the schedule.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">🍿</span>
            <h3>Concessions <span class="soon">Coming soon</span></h3>
            <p>Let guests order snacks from their car and pick up without missing the show.</p>
        </article>
    </div>

    <h2 class="reveal" style="margin-top: 56px">How it works</h2>
    <p class="section-lede reveal">Try everything free. Pay only for the months your gates are open.</p>
    <div class="grid">
        <article class="card reveal">
            <span class="icon" aria-hidden="true">1</span>
            <h3>Sign up free</h3>
            <p>Create an account and your theater in a couple of minutes. No card needed.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">2</span>
            <h3>Set it up in demo mode</h3>
            <p>Add your screens, films, showtimes and prices, invite staff, and run test sales end to end. It's private until you go live.</p>
        </article>
        <article class="card reveal">
            <span class="icon" aria-hidden="true">3</span>
            <h3>Go live for the season</h3>
            <p>Flip the switch when you're ready. You're billed per screen, only for months your season is open, with no per-ticket fees.</p>
        </article>
    </div>
    <p class="reveal" style="margin-top: 28px"><a class="cta cta-outline" href="get-started">Start your free demo</a></p>
</main>

<MarketingFooter />
