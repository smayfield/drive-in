@page "/tickets/{Code}"
@attribute [Authorize]
@inherits AppComponentBase
@inject TicketSalesService Sales
@inject WeatherService Weather

<PageTitle>Ticket · Drive-In Online</PageTitle>

@if (lookup is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading ticket" /> }
}
else
{
    var v = lookup.View;
    var t = v.Ticket;
    var s = v.Showing;

    @if (lookup.IsBuyer)
    {
        <MudLink Href="tickets" Class="d-inline-block mb-3">&larr; My tickets</MudLink>
    }

    @if (New == "sent")
    {
        <MudAlert Severity="Severity.Success" Class="mb-3" role="status">You're all set! We've emailed your receipt to @t.Email.</MudAlert>
    }
    else if (New == "unsent")
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" role="status">
            You're all set, but we couldn't email your receipt just now. This page has everything you need at the gate,
            and you can try sending the receipt again below.
        </MudAlert>
    }
    <Alerts Error="@Error" Success="@Success" />

    @if (lookup.CanAdmit)
    {
        var ok = t.AdmittedAt is null && lookup.AdmitProblem is null;
        <MudPaper Outlined Class="pa-4 mb-4 mx-auto" Style="@($"max-width: 32rem; border-color: var(--mud-palette-{(ok ? "success" : "error")})")">
            <MudText Typo="Typo.h5" Class="mb-1">Gate check</MudText>
            @if (lookup.AdmitProblem is string problem)
            {
                <MudText Typo="Typo.h4" Color="Color.Error">Don't admit</MudText>
                <MudText>@problem</MudText>
            }
            else
            {
                <MudText Typo="Typo.h4" Color="Color.Success">Valid: spot @t.SpotLabel</MudText>
                <MudText Class="mb-3">@s.Title · @s.StartsLocal.ToString("ddd, MMM d h:mm tt") · @s.ScreenName · @(t.IsComp ? $"Free admission for {t.GuestName}" : t.OptionName)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth OnClick="AdmitAsync">Admit car</MudButton>
            }
        </MudPaper>
    }

    <MudPaper Outlined Class="mx-auto overflow-hidden" Style="max-width: 32rem">
        <div class="theater-card-sign text-center">
            <h1 class="theater-card-name">@v.Theater.Name</h1>
            <p class="marquee-sub mb-0">@TicketReceipt.Address(v.Theater)</p>
        </div>
        <div class="pa-4 text-center">
            @if (t.IsTest)
            {
                <MudChip T="string" Color="Color.Warning" Class="mb-2">Test ticket (demo theater): no money was charged</MudChip>
            }
            <MudText Typo="Typo.h5" Class="mb-1">@s.Title</MudText>
            <MudText><strong>@s.StartsLocal.ToString("dddd, MMMM d, yyyy · h:mm tt")</strong></MudText>
            <MudText>@s.ScreenName</MudText>
            @if (weather is not null && v.AdmittedLocal is null)
            {
                <div class="d-flex justify-center"><WeatherLine Weather="@weather.GetValueOrDefault(s.Id)" BeyondForecast="@Weather.IsBeyondForecast(v.Theater, s)" /></div>
            }
            <MudText Typo="Typo.caption" Class="muted d-block mt-2">Spot</MudText>
            <div class="ticket-spot @(t.VehicleSize == VehicleSize.Large ? "mb-1" : "mb-3")">@t.SpotLabel</div>
            @if (t.VehicleSize == VehicleSize.Large)
            {
                <MudText Typo="Typo.body2" Class="mb-3">For a large vehicle</MudText>
            }
            @if (lookup.IsBuyer)
            {
                <img class="ticket-qr mb-2" src="@qr" alt="Ticket QR code for the gate" />
                <MudText Typo="Typo.caption" Class="muted d-block">Gate code</MudText>
                <div class="gate-code mb-2">@t.ShortCode</div>
                <MudText Typo="Typo.body2" Class="muted mb-3">Show the QR code at the gate, or tell the attendant your gate code.</MudText>
            }
            @if (v.AdmittedLocal is DateTime admitted)
            {
                <MudChip T="string" Class="mb-2">Used: admitted @admitted.ToString("MMM d h:mm tt")</MudChip>
            }

            <MudSimpleTable Dense Class="text-start mb-2" Style="box-shadow: none; background: transparent">
                <tbody>
                    <tr><td>@t.OptionName</td><td class="text-end">@Money.Format(t.OptionPrice)</td></tr>
                    @foreach (var a in t.AddOns)
                    {
                        <tr><td>@a.Name</td><td class="text-end">@TicketReceipt.SignedMoney(a.Effect)</td></tr>
                    }
                    <tr class="fw-bold"><td>Total</td><td class="text-end">@Money.Format(t.Total)</td></tr>
                    @if (t.GiftCardAmount > 0)
                    {
                        <tr><td>Gift card ending @t.GiftCardLast4</td><td class="text-end">@TicketReceipt.SignedMoney(-t.GiftCardAmount)</td></tr>
                        <tr><td>Charged to card</td><td class="text-end">@Money.Format(t.CardAmount)</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption" Class="muted d-block text-start mb-3">
                @TicketReceipt.PaidWith(t) · Purchased @v.SoldLocal.ToString("MMM d, yyyy h:mm tt")<br />
                Admits one car to this showing only; it can't be used on a later date. All sales are final: no refunds or
                exchanges for any reason, including bad weather.
            </MudText>
            @if (lookup.IsBuyer)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@sending" OnClick="ResendAsync">Email my receipt again</MudButton>
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    // Set by checkout: "sent" or "unsent" (the receipt email failed).
    [SupplyParameterFromQuery(Name = "new")] public string? New { get; set; }

    private TicketLookup? lookup;
    private string? qr;
    private bool sending;
    private Dictionary<int, ShowingWeather>? weather;
    private string? weatherFor;

    protected override async Task LoadAsync()
    {
        lookup = await Sales.GetByCodeAsync(User, Code);
        qr = lookup.IsBuyer ? QrCodes.PngDataUri(TicketLinks.Ticket(BaseUri, Code)) : null;
    }

    // The forecast for an upcoming showing, once the page is interactive so a slow weather service doesn't hold it up.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (lookup is null || weatherFor == Code)
            return;
        weatherFor = Code;
        weather = await Weather.ForShowingsAsync(User, lookup.View.Theater, [lookup.View.Showing]);
        StateHasChanged();
    }

    private Task AdmitAsync() => RunAsync(async () =>
    {
        try
        {
            await Sales.AdmitAsync(User, Code);
        }
        finally
        {
            lookup = await Sales.GetByCodeAsync(User, Code);
        }
    }, "Admitted. Enjoy the show!");

    private Task ResendAsync() => RunAsync(async () =>
    {
        sending = true;
        try
        {
            New = null;
            if (!await Sales.ResendReceiptAsync(User, Code, BaseUri))
                throw new AppValidationException("We couldn't send the email just now. Please try again later.");
        }
        finally
        {
            sending = false;
        }
    }, $"Receipt sent to {lookup?.View.Ticket.Email}.");
}
