@page "/tickets"
@attribute [Authorize]
@inject TicketSalesService Sales
@inject TimeProvider Time

<PageTitle>My tickets · Drive-In Online</PageTitle>

<MudText Typo="Typo.h3" Component="h1" Class="mb-4">My tickets</MudText>

@if (tickets is null || giftCards is null)
{
    <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading tickets" />
}
else if (tickets.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
        You haven't bought any tickets yet. <MudLink Href="theaters">Find a showing</MudLink>
    </MudAlert>
}
else
{
    var now = Time.GetUtcNow();
    var upcoming = tickets.Where(t => t.Ticket.Showtime!.EndsAt > now).ToList();
    var past = tickets.Except(upcoming).OrderByDescending(t => t.Ticket.Showtime!.StartsAt).ToList();

    <MudText Typo="Typo.h4" Class="mb-2">Upcoming</MudText>
    @if (upcoming.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mb-4">
            No upcoming showings. <MudLink Href="theaters">Find a showing</MudLink>
        </MudAlert>
    }
    @foreach (var t in upcoming)
    {
        <Stub>
            <Poster>
                @foreach (var f in t.Showing.Features.Where(f => f.PosterUrl is not null))
                {
                    <img src="@f.PosterUrl" alt="Poster for @f.Title" loading="lazy" />
                }
            </Poster>
            <ChildContent>
                <h2 class="stub-title">
                    @t.Showing.Title
                    @if (t.Ticket.IsTest) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1 my-0">Test</MudChip> }
                </h2>
                <p class="stub-meta">@t.Theater.Name · @t.Showing.ScreenName</p>
                <p class="stub-meta">@t.Showing.StartsLocal.ToString("dddd, MMM d · h:mm tt")</p>
            </ChildContent>
            <Aside>
                <span class="stub-note">Spot</span>
                <span class="ticket-spot">@t.Ticket.SpotLabel</span>
                <span class="stub-note">Gate code <strong class="font-monospace">@t.Ticket.ShortCode</strong></span>
                <MudButton Href="@($"tickets/{t.Code}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Show ticket</MudButton>
            </Aside>
        </Stub>
    }

    @if (past.Count > 0)
    {
        <MudText Typo="Typo.h4" Class="mt-6 mb-2">Past</MudText>
        <MudPaper Outlined>
            <MudList T="string" Dense>
                @foreach (var t in past)
                {
                    <MudListItem Href="@($"tickets/{t.Code}")" Class="muted">
                        @t.Showing.Title · @t.Theater.Name · @t.Showing.StartsLocal.ToString("MMM d, yyyy") · spot @t.Ticket.SpotLabel
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
}

@if (giftCards is { Count: > 0 })
{
    <MudText Typo="Typo.h4" Class="mt-6 mb-2">My gift cards</MudText>
    <MudPaper Outlined>
        <MudSimpleTable Dense Style="box-shadow: none; background: transparent">
            <thead><tr><th>Theater</th><th>Code</th><th>Bought</th><th class="text-end">Value</th><th class="text-end">Balance</th></tr></thead>
            <tbody>
                @foreach (var g in giftCards)
                {
                    <tr>
                        <td><MudLink Href="@($"theaters/{g.TheaterSlug}")">@g.TheaterName</MudLink>@(g.Card.IsTest ? " (test)" : "")</td>
                        <td class="font-monospace">@GiftCardCodes.Format(g.Card.Code)</td>
                        <td>@g.PurchasedLocal.ToString("MMM d, yyyy")</td>
                        <td class="text-end">@Money.Format(g.Card.InitialAmount)</td>
                        <td class="text-end">@Money.Format(g.Card.Balance)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<TicketView>? tickets;
    private List<MyGiftCard>? giftCards;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        tickets = await Sales.ListMyTicketsAsync(user);
        giftCards = await Sales.ListMyGiftCardsAsync(user);
    }
}
