@page "/admin/users"
@attribute [Authorize(Policy = Policies.Admin)]
@inherits AppComponentBase
@inject UserAdminService Users

<PageTitle>Users · Admin · Drive-In Online</PageTitle>

<AdminHeader Title="Users" Current="users" />

<Alerts Error="@Error" Success="@Success" />

<MudExpansionPanels Class="mb-4" Elevation="0" Outlined>
    <MudExpansionPanel Text="Create a user">
        <MudText Typo="Typo.body2" Class="muted mb-2">
            Creates a confirmed account and emails a link to set a password. They can also link Google afterwards.
            To create an owner, create the theater and assign its owner there; employees are invited by their theater's owner.
        </MudText>
        <form class="d-flex flex-wrap gap-2 align-items-start" @onsubmit="CreateAsync">
            <MudTextField T="string" @bind-Value="newEmail" InputType="InputType.Email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" Required Class="field-grow" />
            <MudTextField T="string" @bind-Value="newName" Label="Display name (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" Class="field-grow" />
            <MudCheckBox T="bool" @bind-Value="newAdmin" Color="Color.Primary" Class="mt-1">Admin</MudCheckBox>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1">Create</MudButton>
        </form>
    </MudExpansionPanel>
</MudExpansionPanels>

<form class="d-flex flex-wrap gap-2 align-items-start mb-3" @onsubmit="SearchAsync">
    <MudTextField T="string" @bind-Value="search" Placeholder="Search by email or name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="field-grow" aria-label="Search users" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Class="mt-1">Search</MudButton>
</form>

@if (users is not null)
{
    <MudSimpleTable Dense Hover Outlined Class="manage-table">
        <thead>
            <tr><th>Email</th><th>Name</th><th>Access</th><th>Sign-in</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                var self = u.Id == User.GetUserId();
                <tr @key="u.Id">
                    <td>
                        @u.Email
                        @if (!u.EmailConfirmed) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1 my-0">Unconfirmed</MudChip> }
                        @if (u.IsLockedOut) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1 my-0">Locked</MudChip> }
                    </td>
                    <td>
                        @if (editingNameId == u.Id)
                        {
                            <div class="d-flex gap-1 align-items-center">
                                <MudTextField T="string" @bind-Value="editingName" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" aria-label="Display name" />
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveNameAsync(u)">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => editingNameId = null">Cancel</MudButton>
                            </div>
                        }
                        else
                        {
                            @u.DisplayName
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => { editingNameId = u.Id; editingName = u.DisplayName; }">Edit</MudButton>
                        }
                    </td>
                    <td class="small">
                        @if (u.IsAdmin) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="me-1 my-0">Admin</MudChip> }
                        @if (u.EmployeeTheaterName is not null) { <div>Employee: @u.EmployeeTheaterName</div> }
                        @if (u.OwnedTheaters.Count > 0) { <div>Owner: @string.Join(", ", u.OwnedTheaters)</div> }
                    </td>
                    <td class="small">@string.Join(", ", (u.HasPassword ? new[] { "Password" } : []).Concat(u.Logins))</td>
                    <td class="small">@u.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td class="text-end text-nowrap">
                        @if (u.EmployeeTheaterName is null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(self && u.IsAdmin)"
                                       OnClick="() => SetAdminAsync(u, !u.IsAdmin)">@(u.IsAdmin ? "Remove admin" : "Make admin")</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@self"
                                   OnClick="() => SetLockedAsync(u, !u.IsLockedOut)">@(u.IsLockedOut ? "Unlock" : "Lock")</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResetAsync(u)">Reset password</MudButton>
                        @if (confirmDeleteId == u.Id)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteAsync(u)">Confirm delete</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@self" OnClick="() => confirmDeleteId = u.Id">Delete</MudButton>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (users.Count == 0)
    {
        <MudText Class="muted mt-2">No users match.</MudText>
    }
}

@code {
    private List<UserSummary>? users;
    private string? search;
    private string? confirmDeleteId;
    private string? editingNameId;
    private string? editingName;

    private string newEmail = "";
    private string? newName;
    private bool newAdmin;

    protected override async Task LoadAsync()
    {
        users = await Users.ListAsync(User, search);
        confirmDeleteId = null;
        editingNameId = null;
    }

    private Task SearchAsync() => RunAsync(LoadAsync);

    private Task CreateAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(newEmail))
            throw new AppValidationException("Enter an email address.");
        await Users.CreateAsync(User, newEmail, newName, newAdmin, BaseUri);
        newEmail = "";
        newName = null;
        newAdmin = false;
        await LoadAsync();
    }, "User created and emailed a link to set their password.");

    private Task SaveNameAsync(UserSummary u) => RunAsync(async () =>
    {
        await Users.UpdateDisplayNameAsync(User, u.Id, editingName);
        await LoadAsync();
    });

    private Task SetAdminAsync(UserSummary u, bool isAdmin) => RunAsync(async () =>
    {
        await Users.SetAdminAsync(User, u.Id, isAdmin);
        await LoadAsync();
    }, isAdmin ? $"{u.Email} is now an admin." : $"{u.Email} is no longer an admin.");

    private Task SetLockedAsync(UserSummary u, bool locked) => RunAsync(async () =>
    {
        await Users.SetLockedAsync(User, u.Id, locked);
        await LoadAsync();
    }, locked ? $"{u.Email} is locked out." : $"{u.Email} is unlocked.");

    private Task ResetAsync(UserSummary u) =>
        RunAsync(() => Users.SendPasswordResetAsync(User, u.Id, BaseUri), $"Password reset email sent to {u.Email}.");

    private Task DeleteAsync(UserSummary u) => RunAsync(async () =>
    {
        await Users.DeleteAsync(User, u.Id);
        await LoadAsync();
    }, $"Deleted {u.Email}.");
}
