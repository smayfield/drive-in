@page "/admin/theaters/new"
@page "/admin/theaters/{Id:int}"
@attribute [Authorize(Policy = Policies.Admin)]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject InvitationService Invitations
@inject BillingService Billing

<PageTitle>@Title · Admin · Drive-In Online</PageTitle>

<AdminHeader Title="@Title" Current="theaters" Parent="@(("admin/theaters", "Theaters"))" />

<Alerts Error="@Error" Success="@Success" />

@if (loaded)
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" class="manage-section">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="model.Slug" For="() => model.Slug" Label="Slug (public URL)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentText="/theaters/" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-items-center">
                <MudCheckBox T="bool" @bind-Value="model.IsActive" Color="Color.Primary">Active (listed for users)</MudCheckBox>
            </MudItem>
        </MudGrid>
        <TheaterProfileFields Model="model" />
        <div class="d-flex flex-wrap gap-2 mt-3">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@(Id is null ? "Create theater" : "Save")</MudButton>
            @if (Id is not null)
            {
                <MudButton Href="@($"manage/{Id}")" Variant="Variant.Outlined">Screens &amp; employees</MudButton>
            }
        </div>
    </EditForm>

    @if (Id is not null)
    {
        <section class="manage-section">
            <MudText Typo="Typo.h5">Billing</MudText>
            <MudText Typo="Typo.body2">
                @if (subscription is null)
                {
                    <text>No subscription: this theater isn't billed.</text>
                }
                else
                {
                    <text>@subscription.Plan plan, @Money.Format(subscription.PricePerScreenPerMonth) per screen, since @subscription.StartedOn.ToString("MMM d, yyyy")</text>
                    @if (!subscription.IsActive) { <text> · cancelled, last month billed @subscription.EndsAfterMonth?.ToString("MMM yyyy")</text> }
                }
                · <MudLink Href="admin/billing/subscriptions" Typo="Typo.body2">Subscriptions</MudLink>
                · <MudLink Href="@($"manage/{Id}/billing")" Typo="Typo.body2">Invoices</MudLink>
            </MudText>
        </section>

        <section class="manage-section">
            <MudText Typo="Typo.h5">Owner</MudText>
            <MudText>Current owner: <strong>@(ownerEmail ?? "none")</strong></MudText>
            <MudText Typo="Typo.body2" Class="muted mb-2">
                Enter an email to assign a new owner. If they already have an account they become the owner right away;
                otherwise they're emailed an invitation. Employee accounts can't own theaters.
            </MudText>
            <form class="d-flex flex-wrap gap-2 align-items-start" @onsubmit="AssignOwnerAsync">
                <MudTextField T="string" @bind-Value="ownerInviteEmail" InputType="InputType.Email" Label="Email" Placeholder="owner@example.com"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required Class="field-grow" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-1">Assign owner</MudButton>
            </form>
        </section>

        @if (pending.Count > 0)
        {
            <section class="manage-section">
                <MudText Typo="Typo.h5">Pending invitations</MudText>
                <MudSimpleTable Dense Hover Outlined Class="manage-table">
                    <thead><tr><th>Email</th><th>Type</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in pending)
                        {
                            <tr @key="i.Id">
                                <td>@i.Email</td>
                                <td>@i.Kind</td>
                                <td>@(i.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : i.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy"))</td>
                                <td class="text-end text-nowrap">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResendAsync(i)">Resend</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => RevokeAsync(i)">Revoke</MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </section>
        }
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool loaded;
    private Theater model = new();
    private string? ownerEmail;
    private string ownerInviteEmail = "";
    private List<Invitation> pending = [];
    private Subscription? subscription;

    private string Title => Id is null ? "New theater" : model.Name;

    protected override async Task LoadAsync()
    {
        if (Id is int id)
        {
            var theater = await Theaters.AdminGetAsync(User, id);
            model = theater.CopyForEdit();
            ownerEmail = theater.Owner?.Email;
            pending = await Invitations.ListPendingAsync(User, id);
            subscription = await Billing.GetSubscriptionAsync(User, id);
        }
        loaded = true;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        if (Id is null)
        {
            var created = await Theaters.CreateAsync(User, model);
            Nav.NavigateTo($"admin/theaters/{created.Id}");
            return;
        }
        await Theaters.AdminUpdateAsync(User, model);
    }, "Saved.");

    private Task AssignOwnerAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(ownerInviteEmail))
            throw new AppValidationException("Enter an email address.");
        var email = ownerInviteEmail.Trim();
        var outcome = await Invitations.InviteAsync(User, Id!.Value, email, InvitationKind.Owner, BaseUri);
        ownerInviteEmail = "";
        await LoadAsync();
        Success = outcome == InviteOutcome.AssignedExistingOwner
            ? $"{email} is now the owner."
            : $"Invitation sent to {email}. They'll become the owner when they accept.";
    });

    private Task ResendAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.ResendAsync(User, i.Id, BaseUri);
        await LoadAsync();
    }, $"Invitation re-sent to {i.Email}.");

    private Task RevokeAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.RevokeAsync(User, i.Id);
        await LoadAsync();
    }, $"Invitation to {i.Email} revoked.");
}
