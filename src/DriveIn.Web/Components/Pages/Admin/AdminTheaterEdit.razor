@page "/admin/theaters/new"
@page "/admin/theaters/{Id:int}"
@attribute [Authorize(Policy = Policies.Admin)]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject InvitationService Invitations

<PageTitle>@Title · Admin · Drive-In Online</PageTitle>

<p><a href="admin/theaters">&larr; Theaters</a></p>
<h1>@Title</h1>

<Alerts Error="@Error" Success="@Success" />

@if (loaded)
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" class="mb-5">
        <DataAnnotationsValidator />
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label" for="slug">Slug (public URL)</label>
                <div class="input-group">
                    <span class="input-group-text">/theaters/</span>
                    <InputText id="slug" class="form-control" @bind-Value="model.Slug" />
                </div>
                <ValidationMessage For="() => model.Slug" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <InputCheckbox id="active" class="form-check-input" @bind-Value="model.IsActive" />
                    <label class="form-check-label" for="active">Active (listed for users)</label>
                </div>
            </div>
        </div>
        <TheaterProfileFields Model="model" />
        <button type="submit" class="btn btn-primary mt-3">@(Id is null ? "Create theater" : "Save")</button>
        @if (Id is not null)
        {
            <a class="btn btn-outline-secondary mt-3 ms-2" href="manage/@Id">Screens &amp; employees</a>
        }
    </EditForm>

    @if (Id is not null)
    {
        <section class="mb-4">
            <h2 class="h4">Owner</h2>
            <p>Current owner: <strong>@(ownerEmail ?? "none")</strong></p>
            <p class="text-muted small">
                Enter an email to assign a new owner. If they already have an account they become the owner right away;
                otherwise they're emailed an invitation. Employee accounts can't own theaters.
            </p>
            <form class="row g-2" @onsubmit="AssignOwnerAsync">
                <div class="col-sm-8 col-md-6">
                    <input type="email" class="form-control" placeholder="owner@example.com" @bind="ownerInviteEmail" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Assign owner</button>
                </div>
            </form>
        </section>

        @if (pending.Count > 0)
        {
            <section>
                <h2 class="h5">Pending invitations</h2>
                <table class="table align-middle">
                    <thead><tr><th>Email</th><th>Type</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in pending)
                        {
                            <tr @key="i.Id">
                                <td>@i.Email</td>
                                <td>@i.Kind</td>
                                <td>@(i.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : i.ExpiresAt.ToLocalTime().ToString("MMM d, yyyy"))</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResendAsync(i)">Resend</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeAsync(i)">Revoke</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool loaded;
    private Theater model = new();
    private string? ownerEmail;
    private string ownerInviteEmail = "";
    private List<Invitation> pending = [];

    private string Title => Id is null ? "New theater" : model.Name;

    protected override async Task LoadAsync()
    {
        if (Id is int id)
        {
            var theater = await Theaters.AdminGetAsync(User, id);
            model = theater.CopyForEdit();
            ownerEmail = theater.Owner?.Email;
            pending = await Invitations.ListPendingAsync(User, id);
        }
        loaded = true;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        if (Id is null)
        {
            var created = await Theaters.CreateAsync(User, model);
            Nav.NavigateTo($"admin/theaters/{created.Id}");
            return;
        }
        await Theaters.AdminUpdateAsync(User, model);
    }, "Saved.");

    private Task AssignOwnerAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(ownerInviteEmail))
            throw new AppValidationException("Enter an email address.");
        var email = ownerInviteEmail.Trim();
        var outcome = await Invitations.InviteAsync(User, Id!.Value, email, InvitationKind.Owner, BaseUri);
        ownerInviteEmail = "";
        await LoadAsync();
        Success = outcome == InviteOutcome.AssignedExistingOwner
            ? $"{email} is now the owner."
            : $"Invitation sent to {email}. They'll become the owner when they accept.";
    });

    private Task ResendAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.ResendAsync(User, i.Id, BaseUri);
        await LoadAsync();
    }, $"Invitation re-sent to {i.Email}.");

    private Task RevokeAsync(Invitation i) => RunAsync(async () =>
    {
        await Invitations.RevokeAsync(User, i.Id);
        await LoadAsync();
    }, $"Invitation to {i.Email} revoked.");
}
