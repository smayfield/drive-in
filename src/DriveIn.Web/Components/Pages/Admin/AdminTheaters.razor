@page "/admin/theaters"
@attribute [Authorize(Policy = Policies.Admin)]
@inherits AppComponentBase
@inject TheaterService Theaters
@inject OnboardingService Onboarding

<PageTitle>Theaters · Admin · Drive-In Online</PageTitle>

<AdminHeader Title="Theaters" Current="theaters" />

<div class="mb-3">
    <MudButton Href="admin/theaters/new" Variant="Variant.Filled" Color="Color.Primary">New theater</MudButton>
</div>

<Alerts Error="@Error" Success="@Success" />

@if (requests.Count > 0)
{
    <MudPaper Outlined Class="pa-3 mb-4" Style="border-color: var(--mud-palette-warning)">
        <MudText Typo="Typo.h5">Go-live requests</MudText>
        <MudText Typo="Typo.body2" Class="muted mb-1">Activating lists the theater publicly, starts real sales and billing, and deletes its demo test tickets.</MudText>
        @foreach (var r in requests)
        {
            <div class="role-row" @key="r.Id">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <MudLink Href="@($"admin/theaters/{r.Id}")"><strong>@r.Name</strong></MudLink>
                        <span class="muted small">
                            · @(r.Owner?.Email ?? "no owner") · asked @TheaterTime.ToLocal(r, r.GoLiveRequestedAt!.Value).ToString("MMM d, h:mm tt")
                            · @r.Screens.Count screen@(r.Screens.Count == 1 ? "" : "s")
                        </span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Href="@($"manage/{r.Id}")" Size="Size.Small" Variant="Variant.Outlined">Review setup</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => ActivateAsync(r)">Activate</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => decliningId = decliningId == r.Id ? null : r.Id">Decline…</MudButton>
                    </div>
                </div>
                @if (decliningId == r.Id)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-start mt-2">
                        <MudTextField T="string" @bind-Value="declineNote" Placeholder="Note to the owner (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="1000" Class="field-grow" aria-label="Note to the owner" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-1" OnClick="() => DeclineAsync(r)">Decline and email owner</MudButton>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

@if (theaters is not null)
{
    <MudSimpleTable Dense Hover Outlined Class="manage-table">
        <thead>
            <tr><th>Name</th><th>Slug</th><th>Location</th><th>Owner</th><th>Payouts</th><th class="text-end">Screens</th><th class="text-end">Employees</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in theaters)
            {
                <tr @key="t.Id">
                    <td>
                        <MudLink Href="@($"admin/theaters/{t.Id}")">@t.Name</MudLink>
                        @if (!t.IsActive) { <MudChip T="string" Size="Size.Small" Class="ms-1 my-0">Inactive</MudChip> }
                        @if (t.Mode == TheaterMode.Demo) { <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-1 my-0">Demo</MudChip> }
                        @if (t.GoLiveRequestedAt is not null) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-1 my-0">Wants to go live</MudChip> }
                    </td>
                    <td><code>@t.Slug</code></td>
                    <td>@string.Join(", ", new[] { t.City, t.State }.Where(s => !string.IsNullOrWhiteSpace(s)))</td>
                    <td>@(t.OwnerEmail ?? "—")</td>
                    <td>@(t.PayoutStatus switch { PayoutStatus.Enabled => "Ready", PayoutStatus.Pending => "Setup not finished", _ => "—" })</td>
                    <td class="text-end">@t.ScreenCount</td>
                    <td class="text-end">@t.EmployeeCount</td>
                    <td class="text-end text-nowrap">
                        <MudButton Href="@($"manage/{t.Id}")" Size="Size.Small" Variant="Variant.Outlined">Manage</MudButton>
                        @if (confirmDeleteId == t.Id)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteAsync(t)">@DeleteLabel(t)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => confirmDeleteId = null">Cancel</MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => confirmDeleteId = t.Id">Delete</MudButton>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (theaters.Count == 0)
    {
        <MudText Class="muted mt-2">No theaters yet.</MudText>
    }
}

@code {
    private List<TheaterSummary>? theaters;
    private int? confirmDeleteId;

    private List<Theater> requests = [];
    private int? decliningId;
    private string declineNote = "";

    protected override async Task LoadAsync()
    {
        theaters = await Theaters.AdminListAsync(User);
        requests = await Onboarding.ListGoLiveRequestsAsync(User);
        confirmDeleteId = null;
        decliningId = null;
        declineNote = "";
    }

    private Task ActivateAsync(Theater theater) => RunAsync(async () =>
    {
        await Onboarding.ActivateAsync(User, theater.Id, BaseUri);
        await LoadAsync();
    }, $"{theater.Name} is live. The owner has been emailed.");

    private Task DeclineAsync(Theater theater) => RunAsync(async () =>
    {
        await Onboarding.DeclineGoLiveAsync(User, theater.Id, declineNote);
        await LoadAsync();
    }, $"Declined {theater.Name}'s request. The owner has been emailed.");

    private static string DeleteLabel(TheaterSummary t) => t.EmployeeCount == 0
        ? "Confirm delete"
        : $"Delete theater and {t.EmployeeCount} employee account{(t.EmployeeCount == 1 ? "" : "s")}";

    private Task DeleteAsync(TheaterSummary t) => RunAsync(async () =>
    {
        await Theaters.DeleteAsync(User, t.Id);
        await LoadAsync();
    }, $"Deleted {t.Name}.");
}
