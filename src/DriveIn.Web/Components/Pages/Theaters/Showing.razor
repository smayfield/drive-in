@page "/theaters/{Slug}/showings/{ShowtimeId:int}"
@attribute [Authorize]
@inherits AppComponentBase
@implements IDisposable
@inject TicketSalesService Sales
@inject SpotEvents Events
@inject TimeProvider Time

<PageTitle>@(sale?.Showing.Title ?? "Showing") · Tickets · Drive-In Online</PageTitle>

<MudLink Href="@($"theaters/{Slug}")" Class="d-inline-block mb-3">&larr; @(sale?.Theater.Name ?? "Theater")</MudLink>

@if (sale is null || availability is null)
{
    <Alerts Error="@Error" />
    @if (Error is null) { <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading showing" /> }
}
else
{
    var s = sale.Showing;
    <div class="d-flex gap-3 mb-4">
        @foreach (var f in s.Features.Where(f => f.PosterUrl is not null))
        {
            <img src="@f.PosterUrl" alt="Poster for @f.Title" width="80" height="120" style="object-fit: cover; border-radius: 4px" />
        }
        <div>
            <MudText Typo="Typo.h3" Component="h1">@s.Title</MudText>
            <MudText Class="muted ">
                @s.StartsLocal.ToString("dddd, MMMM d · h:mm tt") · @s.ScreenName · ends about @s.EndsLocal.ToString("h:mm tt")
                @if (s.IsMultiFeature)
                {
                    <br />
                    @string.Join(" · ", s.Features.Select(f => $"{f.StartsLocal:h:mm tt} {f.Title}{(f.Rating is null ? "" : $" ({f.Rating})")}"))
                    @($" · {s.IntermissionMinutes} min intermission")
                }
                else if (s.Features.FirstOrDefault()?.Rating is string rating)
                {
                    @($" · {rating}")
                }
            </MudText>
        </div>
    </div>

    <Alerts Error="@Error" Success="@Success" />
    @if (notice is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@notice</MudAlert>
    }
    @if (!sale.OnSale)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">@sale.NotOnSaleReason</MudAlert>
    }

    <MudGrid Spacing="4">
        <MudItem xs="12" md="7">
            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                <MudText Typo="Typo.h4">@(Hold is null ? "Choose your spot" : $"Spot {Hold.SpotLabel}")</MudText>
                <MudText Typo="Typo.body2" Class="muted ">@AvailableCount of @sale.Screen.SpotCount available</MudText>
            </div>
            <SeatMap Screen="sale.Screen" Availability="availability" CanPick="sale.OnSale && !busy" OnPick="HoldAsync" />
            <MudText Typo="Typo.caption" Class="muted d-block mt-2">
                The screen is at the top; the first row is nearest it. Spots update live as others buy.
                Spots on hold come back if the buyer doesn't finish within @Ticket.HoldMinutes minutes.
            </MudText>
        </MudItem>

        <MudItem xs="12" md="5">
            @if (Hold is null)
            {
                <MudPaper Outlined Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-2">Tickets</MudText>
                    @if (sale.Prices.Options.Count == 0)
                    {
                        <MudText Class="muted ">Prices haven't been set for this showing yet.</MudText>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-2">
                            @foreach (var o in sale.Prices.Options)
                            {
                                <li><strong>@Money.Format(o.Price)</strong> @o.Name @if (o.Description is not null) { <span class="muted small ms-1">— @o.Description</span> }</li>
                            }
                        </ul>
                        <MudText Typo="Typo.body2" Class="muted ">
                            @(sale.OnSale ? "Pick a green spot on the map to hold it while you pay." : "")
                            A ticket admits one car to this showing only.
                        </MudText>
                    }
                </MudPaper>
            }
            else
            {
                <MudPaper Outlined Class="pa-4" Style="border-color: var(--mud-palette-warning)">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <MudText Typo="Typo.h5">Spot @Hold.SpotLabel is yours for</MudText>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Medium" role="timer" aria-live="off">@Remaining</MudChip>
                    </div>
                    <MudText Typo="Typo.body2" Class="muted mb-3">Finish before the timer runs out or the spot goes back on sale.</MudText>

                    <TicketChoices Prices="sale.Prices" AddOns="sale.AddOns" @bind-OptionId="optionId" @bind-AddOnIds="addOnIds" />

                    @if (Quote is TicketQuote { Total: > 0 })
                    {
                        <GiftCardEntry @bind-Code="giftCode" Balance="gift" OnApply="ApplyGiftAsync" OnRemove="RemoveGift" Disabled="busy" Total="Quote.Total" />
                    }

                    @if (DueByCard > 0)
                    {
                        <CardFields Form="card" />
                    }

                    <MudText Typo="Typo.body2" Class="muted mb-3">
                        This ticket is good only for this showing on @s.StartsLocal.ToString("MMMM d") and can't be used on a later date.
                        <strong>All sales are final:</strong> no refunds or exchanges for any reason, including bad weather.
                    </MudText>
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy || Quote is null)" OnClick="PayAsync">
                            @(busy ? "Processing…" : Quote is { Total: > 0 } ? (DueByCard > 0 ? $"Pay {Money.Format(DueByCard)}" : "Pay with gift card") : "Get ticket")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@busy" OnClick="ReleaseAsync">Choose a different spot</MudButton>
                    </div>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int ShowtimeId { get; set; }

    private ShowingForSale? sale;
    private SpotAvailability? availability;
    private string? notice;
    private bool busy;
    private Timer? countdown;

    private int optionId;
    private IReadOnlySet<int> addOnIds = new HashSet<int>();
    private readonly CardForm card = new();
    private string giftCode = "";
    private GiftCardBalance? gift;

    private HoldView? Hold => availability?.MyHold;
    private int AvailableCount => sale!.Screen.SpotCount - availability!.Spots.Count;

    private TicketQuote? Quote => sale is null ? null : TicketChoices.Quote(sale.Prices, sale.AddOns, optionId, addOnIds);

    // What's left for the card after the gift card, if one is applied.
    private decimal DueByCard => Quote is null ? 0m : Quote.Total - GiftCardEntry.Covers(gift, Quote.Total);

    private string Remaining
    {
        get
        {
            var left = Hold is null ? TimeSpan.Zero : Hold.HeldUntil - Time.GetUtcNow();
            return left <= TimeSpan.Zero ? "0:00" : $"{(int)left.TotalMinutes}:{left.Seconds:00}";
        }
    }

    protected override void OnInitialized()
    {
        Events.Changed += OnSpotsChanged;
        countdown = new Timer(_ => InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task LoadAsync()
    {
        sale = await Sales.GetShowingAsync(User, ShowtimeId);
        if (sale.Theater.Slug != Slug)
            throw new NotFoundException("Showing not found.");
        optionId = sale.Prices.Options.FirstOrDefault()?.Id ?? 0;
        availability = await Sales.GetAvailabilityAsync(User, ShowtimeId);
    }

    private Task HoldAsync(LotSpot spot) => RunAsync(async () =>
    {
        notice = null;
        try
        {
            await Sales.HoldAsync(User, ShowtimeId, spot.Row, spot.Number);
        }
        finally
        {
            // Either way the map should show what just happened (including a spot someone else got first).
            await RefreshAsync();
        }
    });

    private Task ReleaseAsync() => RunAsync(async () =>
    {
        notice = null;
        if (Hold is HoldView hold)
            await Sales.ReleaseHoldAsync(User, hold.TicketId);
        await RefreshAsync();
    });

    private Task PayAsync() => RunAsync(async () =>
    {
        if (Hold is not HoldView hold || busy)
            return;
        busy = true;
        try
        {
            var input = new PurchaseInput(optionId, addOnIds.ToList(), card.ToInput(), gift is null ? null : giftCode);
            var result = await Sales.PurchaseAsync(User, hold.TicketId, input, BaseUri);
            card.Clear();
            Nav.NavigateTo($"tickets/{Uri.EscapeDataString(result.Code)}?new={(result.ReceiptSent ? "sent" : "unsent")}");
        }
        finally
        {
            busy = false;
            await RefreshAsync();
            await RefreshGiftAsync();
        }
    });

    private Task ApplyGiftAsync() => RunAsync(async () => gift = await Sales.CheckGiftCardAsync(User, ShowtimeId, giftCode));

    private void RemoveGift()
    {
        gift = null;
        giftCode = "";
    }

    // After a failed payment the card's balance may have changed (e.g. it was spent elsewhere): show what's there now.
    private async Task RefreshGiftAsync()
    {
        if (gift is null)
            return;
        try
        {
            gift = await Sales.CheckGiftCardAsync(User, ShowtimeId, giftCode);
        }
        catch (AppValidationException)
        {
            gift = null; // used up, or no longer valid; the buyer can pay another way
        }
    }

    private async Task RefreshAsync()
    {
        var had = Hold;
        availability = await Sales.GetAvailabilityAsync(User, ShowtimeId);
        if (had is not null && Hold is null && !busy && notice is null && Error is null)
            notice = $"Your hold on spot {had.SpotLabel} ran out, so it went back on sale. Please choose a spot again.";
    }

    // Another buyer (or the hold sweeper) changed this showing's spots.
    private void OnSpotsChanged(int showtimeId)
    {
        if (showtimeId != ShowtimeId || availability is null)
            return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshAsync();
                StateHasChanged();
            }
            catch (Exception)
            {
                // The circuit may be going away; the next change or action refreshes again.
            }
        });
    }

    // Redraws the countdown; once the hold runs out, reloads (expired holds count as available).
    private async Task TickAsync()
    {
        if (Hold is not HoldView hold)
            return;
        if (hold.HeldUntil <= Time.GetUtcNow() && !busy)
        {
            try
            {
                await RefreshAsync();
            }
            catch (Exception)
            {
                return;
            }
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        Events.Changed -= OnSpotsChanged;
        countdown?.Dispose();
    }
}
