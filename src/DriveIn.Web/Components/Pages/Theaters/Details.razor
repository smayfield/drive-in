@page "/theaters/{Slug}"
@attribute [Authorize]
@inject TheaterService Theaters
@inject TicketSalesService Sales
@inject WeatherService Weather

@if (theater is null)
{
    <PageTitle>Theater not found · Drive-In Online</PageTitle>
    <MudText Typo="Typo.h3" HtmlTag="h1" Class="mb-2">Theater not found</MudText>
    <MudLink Href="theaters">Back to all theaters</MudLink>
}
else
{
    <PageTitle>@theater.Name · Drive-In Online</PageTitle>

    <MudLink Href="theaters" Class="d-inline-block mb-3">&larr; All theaters</MudLink>

    <header class="marquee-header">
        <div class="marquee-body">
            @if (theater.LogoUrl is not null)
            {
                <img class="marquee-logo" src="@theater.LogoUrl" alt="@theater.Name logo" />
            }
            <div>
                <h1 class="marquee-title">@theater.Name</h1>
                <p class="marquee-sub">
                    @Index.Location(theater)
                    @if (theater.SeasonOpensOn is not null || theater.SeasonClosesOn is not null)
                    {
                        <span> · Season: @Seasons.Describe(theater)</span>
                    }
                </p>
            </div>
        </div>
    </header>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            @if (!string.IsNullOrWhiteSpace(theater.Description))
            {
                <MudText Class="mb-4" Style="white-space: pre-line">@theater.Description</MudText>
            }

            <MudText Typo="Typo.h4" Class="mb-2">Showings</MudText>
            @if (showings.Count == 0)
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No upcoming showings are scheduled. Check back soon.</MudAlert>
            }
            @foreach (var day in showings.GroupBy(s => s.StartsLocal.Date))
            {
                <MudText Typo="Typo.h5" Class="mt-4 mb-2">@day.Key.ToString("dddd, MMMM d")</MudText>
                @foreach (var s in day)
                {
                    <Stub>
                        <Poster>
                            @foreach (var f in s.Features.Where(f => f.PosterUrl is not null))
                            {
                                <img src="@f.PosterUrl" alt="Poster for @f.Title" loading="lazy" />
                            }
                        </Poster>
                        <ChildContent>
                            @foreach (var f in s.Features)
                            {
                                <div class="stub-feature">
                                <h2 class="stub-title">
                                    @f.Title
                                    @if (f.Year is not null) { <span class="stub-year"> (@f.Year)</span> }
                                    @if (!string.IsNullOrWhiteSpace(f.Rating)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1 my-0">@f.Rating</MudChip> }
                                </h2>
                                @if (s.IsMultiFeature)
                                {
                                    <p class="stub-meta">@f.StartsLocal.ToString("h:mm tt")</p>
                                }
                                @if (f.Genres is not null || f.Directors is not null || f.Cast is not null || f.Overview is not null)
                                {
                                    <div class="stub-detail">
                                        @if (f.Genres is not null) { <div>@f.Genres</div> }
                                        @if (f.Directors is not null) { <div>Directed by @f.Directors</div> }
                                        @if (f.Cast is not null) { <div>Starring @f.Cast</div> }
                                        @if (f.Overview is not null)
                                        {
                                            <details>
                                                <summary>About this film</summary>
                                                <p>@f.Overview</p>
                                            </details>
                                        }
                                    </div>
                                }
                                </div>
                            }
                            <p class="stub-meta mt-2">
                                @s.ScreenName
                                @if (s.IsMultiFeature)
                                {
                                    @($" · {s.Features.Count} films, {s.IntermissionMinutes} min intermission")
                                }
                            </p>
                            @if (weather is not null)
                            {
                                <WeatherLine Weather="@weather.GetValueOrDefault(s.Id)" BeyondForecast="@Weather.IsBeyondForecast(theater, s)" />
                            }
                        </ChildContent>
                        <Aside>
                            <span class="stub-time">@s.StartsLocal.ToString("h:mm tt")</span>
                            <span class="stub-note">ends @s.EndsLocal.ToString("h:mm tt")</span>
                            <MudButton Href="@($"theaters/{theater.Slug}/showings/{s.Id}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">Choose a spot</MudButton>
                        </Aside>
                    </Stub>
                }
            }
            @if (showings.Count > 0 && !TheaterTime.IsValidZone(theater.TimeZone))
            {
                <MudText Typo="Typo.caption" Class="muted">Times are UTC.</MudText>
            }
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Outlined Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">Find us</MudText>
                <address class="mb-2">
                    @if (!string.IsNullOrWhiteSpace(theater.AddressLine1)) { @theater.AddressLine1<br /> }
                    @if (!string.IsNullOrWhiteSpace(theater.AddressLine2)) { @theater.AddressLine2<br /> }
                    @string.Join(" ", new[] { Index.Location(theater), theater.PostalCode }.Where(s => !string.IsNullOrWhiteSpace(s)))
                </address>
                @if (!string.IsNullOrWhiteSpace(theater.Phone))
                {
                    <div>Phone: <MudLink Href="@($"tel:{theater.Phone}")">@theater.Phone</MudLink></div>
                }
                @if (Uri.TryCreate(theater.Website, UriKind.Absolute, out var site) && (site.Scheme == "https" || site.Scheme == "http"))
                {
                    <div><MudLink Href="@site.ToString()" Target="_blank" rel="noopener">@site.Host</MudLink></div>
                }
            </MudPaper>

            @if (theater.GiftCardsEnabled)
            {
                <MudPaper Outlined Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-1">Gift cards</MudText>
                    <MudText Class="muted mb-2">Give a night at the drive-in. It pays toward tickets, and the rest stays on the card.</MudText>
                    <MudButton Href="@($"theaters/{theater.Slug}/giftcards")" Variant="Variant.Outlined" Color="Color.Primary">Buy a gift card</MudButton>
                </MudPaper>
            }

            <MudPaper Outlined Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Screens</MudText>
                @if (theater.Screens.Count == 0)
                {
                    <MudText Class="muted">No screens listed.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense Style="box-shadow: none; background: transparent">
                        <thead><tr><th>Screen</th><th class="text-end">Spots</th></tr></thead>
                        <tbody>
                            @foreach (var s in theater.Screens)
                            {
                                <tr><td>@s.Name</td><td class="text-end">@s.SpotCount</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Theater? theater;
    private List<ShowtimeView> showings = [];
    private Dictionary<int, ShowingWeather>? weather;
    private List<ShowtimeView>? weatherFor;

    protected override async Task OnParametersSetAsync()
    {
        theater = await Theaters.GetBySlugAsync((await AuthState).User, Slug);
        showings = theater is null ? [] : (await Sales.ListOnSaleAsync((await AuthState).User, Slug)).Showings;
    }

    // The forecast comes once the page is interactive, so a slow weather service never holds up the showings.
    // Keyed on the loaded showings, not the route, so navigating to another theater mid-load can't leave it without one.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (theater is null || ReferenceEquals(weatherFor, showings))
            return;
        var (forTheater, forShowings) = (theater, showings);
        (weatherFor, weather) = (forShowings, null);
        var found = await Weather.ForShowingsAsync((await AuthState).User, forTheater, forShowings);
        if (ReferenceEquals(showings, forShowings))
        {
            weather = found;
            StateHasChanged();
        }
    }
}
