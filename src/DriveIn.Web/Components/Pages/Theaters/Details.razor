@page "/theaters/{Slug}"
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@* Public: anyone can see a live theater's page, signed in or not (buying a ticket asks them to sign in). Statically
   rendered, so visitors and crawlers don't hold a live connection; "Choose a spot" opens the interactive showing page. *@
@inject TheaterService Theaters
@inject ContentService Content
@inject TicketSalesService Sales
@inject WeatherService Weather
@inject ILogger<Details> Log

@if (theater is null)
{
    <PageTitle>Theater not found · Drive-In Online</PageTitle>
    <h1 class="mb-2">Theater not found</h1>
    <a href="theaters">Back to all theaters</a>
}
else
{
    <PageTitle>@theater.Name · Drive-In Online</PageTitle>
    @if (!string.IsNullOrWhiteSpace(theater.Description))
    {
        <HeadContent><meta name="description" content="@theater.Description" /></HeadContent>
    }

    <a href="theaters" class="d-inline-block mb-3">&larr; All theaters</a>

    <TheaterMasthead Theater="theater" Current="@($"theaters/{theater.Slug}")" />

    <div class="row public-columns">
        <div class="col-md-8">
            @if (!string.IsNullOrWhiteSpace(theater.Description))
            {
                <p class="mb-4" style="white-space: pre-line">@theater.Description</p>
            }

            @if (news.Count > 0)
            {
                <section class="mb-5" aria-labelledby="news-heading">
                    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
                        <h2 class="h4" id="news-heading">News &amp; events</h2>
                        @if (newsTotal > news.Count)
                        {
                            <a href="@($"theaters/{theater.Slug}/news")">All news &amp; events</a>
                        }
                    </div>
                    <NewsCards Theater="theater" Posts="news" />
                </section>
            }

            <section aria-labelledby="showings-heading">
                <h2 class="h4" id="showings-heading">Showings</h2>
                @if (showings.Count == 0)
                {
                    <p class="public-note">No upcoming showings are scheduled. Check back soon.</p>
                }
                @foreach (var day in showings.GroupBy(s => s.StartsLocal.Date))
                {
                    <h3 class="h5 mt-4 mb-2">@day.Key.ToString("dddd, MMMM d")</h3>
                    @foreach (var s in day)
                    {
                        <Stub>
                            <Poster>
                                @foreach (var f in s.Features.Where(f => f.PosterUrl is not null))
                                {
                                    <img src="@f.PosterUrl" alt="Poster for @f.Title" loading="lazy" />
                                }
                            </Poster>
                            <ChildContent>
                                @foreach (var f in s.Features)
                                {
                                    <div class="stub-feature">
                                        <h4 class="stub-title">
                                            @f.Title
                                            @if (f.Year is not null) { <span class="stub-year"> (@f.Year)</span> }
                                            @if (!string.IsNullOrWhiteSpace(f.Rating)) { <span class="stub-rating"><span class="visually-hidden">Rated </span>@f.Rating</span> }
                                        </h4>
                                        @if (s.IsMultiFeature)
                                        {
                                            <p class="stub-meta">@f.StartsLocal.ToString("h:mm tt")</p>
                                        }
                                        @if (f.Genres is not null || f.Directors is not null || f.Cast is not null || f.Overview is not null)
                                        {
                                            <div class="stub-detail">
                                                @if (f.Genres is not null) { <div>@f.Genres</div> }
                                                @if (f.Directors is not null) { <div>Directed by @f.Directors</div> }
                                                @if (f.Cast is not null) { <div>Starring @f.Cast</div> }
                                                @if (f.Overview is not null)
                                                {
                                                    <details>
                                                        <summary>About this film</summary>
                                                        <p>@f.Overview</p>
                                                    </details>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <p class="stub-meta mt-2">
                                    @s.ScreenName
                                    @if (s.IsMultiFeature)
                                    {
                                        @($" · {s.Features.Count} films, {s.IntermissionMinutes} min intermission")
                                    }
                                </p>
                                <StreamedWeatherLine Forecasts="weather" ShowingId="s.Id" />
                            </ChildContent>
                            <Aside>
                                <span class="stub-time">@s.StartsLocal.ToString("h:mm tt")</span>
                                <span class="stub-note">ends @s.EndsLocal.ToString("h:mm tt")</span>
                                <a href="@($"theaters/{theater.Slug}/showings/{s.Id}")" class="btn btn-primary">@(signedIn ? "Choose a spot" : "Sign in to buy")</a>
                            </Aside>
                        </Stub>
                    }
                }
                @if (showings.Count > 0 && !TheaterTime.IsValidZone(theater.TimeZone))
                {
                    <p class="small muted">Times are UTC.</p>
                }
            </section>
        </div>

        <div class="col-md-4">
            <section class="card card-body mb-4" aria-labelledby="find-us-heading">
                <h2 class="h6" id="find-us-heading">Find us</h2>
                <address class="mb-2">
                    @if (!string.IsNullOrWhiteSpace(theater.AddressLine1)) { @theater.AddressLine1<br /> }
                    @if (!string.IsNullOrWhiteSpace(theater.AddressLine2)) { @theater.AddressLine2<br /> }
                    @string.Join(" ", new[] { Index.Location(theater), theater.PostalCode }.Where(s => !string.IsNullOrWhiteSpace(s)))
                </address>
                @if (!string.IsNullOrWhiteSpace(theater.Phone))
                {
                    <div>Phone: <a href="@($"tel:{theater.Phone}")">@theater.Phone</a></div>
                }
                @if (Uri.TryCreate(theater.Website, UriKind.Absolute, out var site) && (site.Scheme == "https" || site.Scheme == "http"))
                {
                    <div><a href="@site.ToString()" target="_blank" rel="noopener">@site.Host</a></div>
                }
                @if (!staff)
                {
                    <div class="mt-3"><a href="@($"messages/new?theater={Uri.EscapeDataString(theater.Slug)}")" class="btn btn-outline-primary">Message the theater</a></div>
                }
            </section>

            @if (theater.GiftCardsEnabled)
            {
                <section class="card card-body mb-4" aria-labelledby="gift-cards-heading">
                    <h2 class="h6" id="gift-cards-heading">Gift cards</h2>
                    <p class="muted mb-2">Give a night at the drive-in. It pays toward tickets, and the rest stays on the card.</p>
                    <div><a href="@($"theaters/{theater.Slug}/giftcards")" class="btn btn-outline-primary">Buy a gift card</a></div>
                </section>
            }

            <section class="card card-body" aria-labelledby="screens-heading">
                <h2 class="h6" id="screens-heading">Screens</h2>
                @if (theater.Screens.Count == 0)
                {
                    <p class="muted mb-0">No screens listed.</p>
                }
                else
                {
                    <table class="table table-dense mb-0">
                        <thead><tr><th>Screen</th><th class="text-end">Spots</th></tr></thead>
                        <tbody>
                            @foreach (var s in theater.Screens)
                            {
                                <tr><td>@s.Name</td><td class="text-end">@s.SpotCount</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private Theater? theater;
    private bool staff;
    private bool signedIn;
    private List<PostCard> news = [];
    private int newsTotal;
    private List<ShowtimeView> showings = [];
    private Task<ShowingForecasts> weather = Task.FromResult(ShowingForecasts.None);

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        theater = await Theaters.GetBySlugAsync(user, Slug);
        signedIn = user.Identity?.IsAuthenticated == true;
        // The owner and employees answer the theater's messages rather than send them.
        staff = theater is not null && user.GetUserId() is string userId
            && (theater.OwnerId == userId || user.GetEmployeeTheaterId() == theater.Id);
        showings = theater is null ? [] : (await Sales.ListOnSaleAsync(user, Slug)).Showings;
        (news, newsTotal) = theater is null ? ([], 0) : await Content.ListLivePostsAsync(user, theater);
        // Started last, once nothing else uses the page's services; each showing's StreamedWeatherLine waits for it, and
        // the rest of the page is sent without waiting.
        weather = theater is null ? Task.FromResult(ShowingForecasts.None) : ForecastAsync(user, theater, showings);
        if (theater is null && HttpContext is { Response.HasStarted: false })
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }

    // The forecast is a nicety: if it fails, the showings are shown without it. It stops when the visitor goes away.
    private async Task<ShowingForecasts> ForecastAsync(System.Security.Claims.ClaimsPrincipal user, Theater forTheater, List<ShowtimeView> forShowings)
    {
        var aborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            return await Weather.ForShowingsAsync(user, forTheater, forShowings, aborted);
        }
        catch (OperationCanceledException) when (aborted.IsCancellationRequested)
        {
            return ShowingForecasts.None;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Couldn't get the forecast for theater {TheaterId}", forTheater.Id);
            return ShowingForecasts.None;
        }
    }
}
