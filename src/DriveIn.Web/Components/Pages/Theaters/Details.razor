@page "/theaters/{Slug}"
@attribute [Authorize]
@inject TheaterService Theaters
@inject TicketSalesService Sales

@if (theater is null)
{
    <PageTitle>Theater not found · Drive-In Online</PageTitle>
    <h1>Theater not found</h1>
    <p><a href="theaters">Back to all theaters</a></p>
}
else
{
    <PageTitle>@theater.Name · Drive-In Online</PageTitle>

    <p><a href="theaters">&larr; All theaters</a></p>
    <div class="d-flex align-items-center gap-3 mb-2">
        @if (theater.LogoUrl is not null)
        {
            <img src="@theater.LogoUrl" alt="@theater.Name logo" style="max-height: 6rem; max-width: 12rem; object-fit: contain" />
        }
        <h1 class="mb-0">@theater.Name</h1>
    </div>
    @if (theater.SeasonOpensOn is not null || theater.SeasonClosesOn is not null)
    {
        <p class="text-muted">Season: @Seasons.Describe(theater)</p>
    }

    <div class="row g-4">
        <div class="col-md-7">
            @if (!string.IsNullOrWhiteSpace(theater.Description))
            {
                <p style="white-space: pre-line">@theater.Description</p>
            }

            <h2 class="h5 mt-4">Showings</h2>
            @if (showings.Count == 0)
            {
                <p class="text-muted">No upcoming showings are scheduled.</p>
            }
            @foreach (var day in showings.GroupBy(s => s.StartsLocal.Date))
            {
                <h3 class="h6 mt-3">@day.Key.ToString("dddd, MMMM d")</h3>
                <ul class="list-group mb-2">
                    @foreach (var s in day)
                    {
                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex gap-2">
                                @foreach (var f in s.Features.Where(f => f.PosterUrl is not null))
                                {
                                    <img src="@f.PosterUrl" alt="Poster for @f.Title" width="60" height="90" style="object-fit: cover" loading="lazy" />
                                }
                            <div>
                                <strong>@s.StartsLocal.ToString("h:mm tt")</strong> · @s.Title
                                @foreach (var f in s.Features.Where(f => f.Directors is not null || f.Cast is not null || f.Year is not null || f.Genres is not null || f.Overview is not null))
                                {
                                    <div class="small">
                                        @if (s.IsMultiFeature) { <span class="fw-semibold">@f.Title</span> }
                                        @if (f.Year is not null) { <span class="text-muted">(@f.Year)</span> }
                                        @if (f.Genres is not null) { <span class="text-muted"> · @f.Genres</span> }
                                        @if (f.Directors is not null) { <div class="text-muted">Directed by @f.Directors</div> }
                                        @if (f.Cast is not null) { <div class="text-muted">Starring @f.Cast</div> }
                                        @if (f.Overview is not null) { <div class="mt-1" style="white-space: pre-line">@f.Overview</div> }
                                    </div>
                                }
                                <div class="small text-muted">
                                    @s.ScreenName
                                    @if (s.IsMultiFeature)
                                    {
                                        @($" · {s.Features.Count} films, {s.IntermissionMinutes} min intermission")
                                    }
                                    @foreach (var f in s.Features.Where(f => !string.IsNullOrWhiteSpace(f.Rating)))
                                    {
                                        @($" · {f.Title} ({f.Rating})")
                                    }
                                    · ends @s.EndsLocal.ToString("h:mm tt")
                                </div>
                            </div>
                            </div>
                            <a class="btn btn-sm btn-primary" href="theaters/@theater.Slug/showings/@s.Id">Choose a spot</a>
                        </li>
                    }
                </ul>
            }
            @if (showings.Count > 0 && !TheaterTime.IsValidZone(theater.TimeZone))
            {
                <p class="small text-muted">Times are UTC.</p>
            }
            <h2 class="h5 mt-4">Screens</h2>
            @if (theater.Screens.Count == 0)
            {
                <p class="text-muted">No screens listed.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Screen</th><th class="text-end">Spots</th></tr></thead>
                    <tbody>
                        @foreach (var s in theater.Screens)
                        {
                            <tr><td>@s.Name</td><td class="text-end">@s.SpotCount</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="col-md-5">
            <address>
                @if (!string.IsNullOrWhiteSpace(theater.AddressLine1)) { @theater.AddressLine1<br /> }
                @if (!string.IsNullOrWhiteSpace(theater.AddressLine2)) { @theater.AddressLine2<br /> }
                @string.Join(" ", new[] { Index.Location(theater), theater.PostalCode }.Where(s => !string.IsNullOrWhiteSpace(s)))
            </address>
            @if (!string.IsNullOrWhiteSpace(theater.Phone))
            {
                <p>Phone: <a href="tel:@theater.Phone">@theater.Phone</a></p>
            }
            @if (Uri.TryCreate(theater.Website, UriKind.Absolute, out var site) && (site.Scheme == "https" || site.Scheme == "http"))
            {
                <p><a href="@site" target="_blank" rel="noopener">@site.Host</a></p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Theater? theater;
    private List<ShowtimeView> showings = [];

    protected override async Task OnParametersSetAsync()
    {
        theater = await Theaters.GetBySlugAsync((await AuthState).User, Slug);
        showings = theater is null ? [] : (await Sales.ListOnSaleAsync((await AuthState).User, Slug)).Showings;
    }
}
