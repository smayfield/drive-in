@page "/theaters"
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@* Public: anyone can list the live theaters and search near a place or their location, signed in or not (members also see
   their demo theaters). Statically rendered: the search is a GET form, so results can be linked to, Back works, and it
   works without JavaScript; "Use my location" (wwwroot/geo.js) needs it and stays hidden without it. *@
@inherits AppComponentBase
@inject TheaterService Theaters

<PageTitle>Theaters · Drive-In Online</PageTitle>
<HeadContent><meta name="description" content="Find a drive-in theater near you: showings, spots and tickets." /></HeadContent>

<h1 class="mb-4">Drive-in theaters</h1>

<form class="near-search mb-3" role="search" method="get" action="theaters">
    <div class="near-search-place">
        <label class="form-label" for="near">ZIP code or city</label>
        <input class="form-control" id="near" name="near" type="search" value="@(UsingPosition ? null : Near)" maxlength="200"
               placeholder="e.g. 78701 or Austin, TX" autocomplete="postal-code" />
    </div>
    <div class="near-search-radius">
        <label class="form-label" for="radius">Within</label>
        <select class="form-control" id="radius" name="radius">
            @foreach (var r in RadiusChoices)
            {
                <option value="@r" selected="@(r == Radius)">@(r == AnyDistance ? "Any distance" : $"{r} miles")</option>
            }
        </select>
    </div>
    <div class="near-search-actions">
        <button type="submit" class="btn btn-primary">Search</button>
        @* Shown by geo.js, which asks the browser for its location and opens ?lat=&lon= with the chosen distance. *@
        <button type="button" class="btn btn-outline-primary" data-geo-locate hidden>Use my location</button>
    </div>
</form>
<p class="alert alert-danger" data-geo-error role="alert" hidden></p>

@if (!string.IsNullOrEmpty(Error))
{
    <p class="alert alert-danger" role="alert">@Error</p>
}

@if (Searching)
{
    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-3" role="status">
        <p class="mb-0">
            @if (placeNotFound)
            {
                @* The alert above says why. *@
            }
            else if (theaters.Count == 0)
            {
                @($"No theaters {RadiusText} {PlaceText}.")
                @if (Radius != AnyDistance) { <span> Try a larger distance.</span> }
            }
            else
            {
                @($"{theaters.Count} theater{(theaters.Count == 1 ? "" : "s")} {RadiusText} {PlaceText}, nearest first.")
            }
        </p>
        <a href="theaters">Show all theaters</a>
    </div>
}
else if (theaters.Count == 0)
{
    <p class="public-note">No theaters are open yet.</p>
}

<ul class="theater-cards list-unstyled">
    @foreach (var (t, miles) in theaters)
    {
        <li class="card theater-card" @key="t.Id">
            <div class="theater-card-sign">
                @if (t.LogoUrl is not null)
                {
                    <img src="@t.LogoUrl" alt="@t.Name logo" loading="lazy" />
                }
                <h2 class="theater-card-name"><a href="theaters/@t.Slug">@t.Name</a></h2>
            </div>
            <div class="theater-card-body">
                <p class="mb-0">
                    @Location(t)
                    @if (miles is double m)
                    {
                        <span class="theater-card-distance">@DistanceText(m)</span>
                    }
                </p>
                <p class="small muted mb-0">
                    @t.Screens.Count screen@(t.Screens.Count == 1 ? "" : "s") · @t.Screens.Sum(s => s.SpotCount) spots
                </p>
                @if (t.SeasonOpensOn is not null || t.SeasonClosesOn is not null)
                {
                    <p class="small muted mb-0">Season: @Seasons.Describe(t)</p>
                }
            </div>
            <div class="theater-card-action">
                <a href="@($"theaters/{t.Slug}")" class="btn btn-outline-primary w-100">Showings &amp; tickets<span class="visually-hidden"> at @t.Name</span></a>
            </div>
        </li>
    }
</ul>

@code {
    private const int AnyDistance = 0;
    private const int DefaultRadius = 100;
    private static readonly int[] RadiusChoices = [25, 50, 100, 250, AnyDistance];

    // The search lives in the query string, so results can be linked to and Back works.
    [SupplyParameterFromQuery(Name = "near")] public string? Near { get; set; }
    [SupplyParameterFromQuery(Name = "lat")] public double? Lat { get; set; }
    [SupplyParameterFromQuery(Name = "lon")] public double? Lon { get; set; }
    [SupplyParameterFromQuery(Name = "radius")] public int? RadiusParam { get; set; }

    private List<(Theater Theater, double? Miles)> theaters = [];
    private bool placeNotFound;

    private bool UsingPosition => Lat is not null && Lon is not null;
    // Only one of lat/lon: a truncated or hand-edited link, shown as an invalid location rather than ignored.
    private bool PartialPosition => (Lat is null) != (Lon is null);
    private bool Searching => UsingPosition || PartialPosition || !string.IsNullOrWhiteSpace(Near);
    private int Radius => RadiusParam is int r && RadiusChoices.Contains(r) ? r : DefaultRadius;
    private string RadiusText => Radius == AnyDistance ? "near" : $"within {Radius} miles of";
    private string PlaceText => UsingPosition ? "your location" : Near?.Trim() ?? "";

    protected override async Task LoadAsync()
    {
        theaters = [];
        placeNotFound = false;
        double? radius = Radius == AnyDistance ? null : Radius;
        try
        {
            if (PartialPosition)
            {
                throw new AppValidationException("That location isn't valid.");
            }
            if (UsingPosition)
            {
                theaters = Nearest(await Theaters.ListNearAsync(User, new GeoPoint(Lat!.Value, Lon!.Value), radius));
            }
            else if (!string.IsNullOrWhiteSpace(Near))
            {
                var from = await Theaters.FindPlaceAsync(User, Near)
                    ?? throw new AppValidationException($"We couldn't find \"{Near.Trim()}\". Try a ZIP code, or a city and state.");
                theaters = Nearest(await Theaters.ListNearAsync(User, from, radius));
            }
            else
            {
                theaters = (await Theaters.ListActiveAsync(User)).Select(t => (t, (double?)null)).ToList();
            }
        }
        catch (AppValidationException)
        {
            // A search that failed (a place that can't be found, a bad location in the link) shows its error (the base
            // class sets it); placeNotFound keeps the "no theaters" line from repeating it.
            placeNotFound = true;
            throw;
        }
    }

    private static List<(Theater, double?)> Nearest(List<(Theater Theater, double Miles)> found) =>
        found.Select(x => (x.Theater, (double?)x.Miles)).ToList();

    internal static string Location(Theater t) =>
        string.Join(", ", new[] { t.City, t.State }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private static string DistanceText(double miles) =>
        miles < 1 ? "under a mile away" : $"{miles:0} mile{(Math.Round(miles) == 1 ? "" : "s")} away";
}
