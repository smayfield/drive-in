@page "/theaters"
@attribute [Authorize]
@inject TheaterService Theaters

<PageTitle>Theaters · Drive-In Online</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" Class="mb-4">Drive-in theaters</MudText>

@if (theaters is null)
{
    <MudProgressCircular Indeterminate Size="Size.Small" aria-label="Loading theaters" />
}
else if (theaters.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No theaters are open yet.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var t in theaters)
        {
            <MudItem xs="12" sm="6" md="4" @key="t.Id">
                <MudPaper Outlined Class="theater-card">
                    <div class="theater-card-sign">
                        @if (t.LogoUrl is not null)
                        {
                            <img src="@t.LogoUrl" alt="@t.Name logo" loading="lazy" />
                        }
                        <h2 class="theater-card-name"><a href="theaters/@t.Slug">@t.Name</a></h2>
                    </div>
                    <div class="theater-card-body">
                        <MudText>@Location(t)</MudText>
                        <MudText Typo="Typo.body2" Class="muted">
                            @t.Screens.Count screen@(t.Screens.Count == 1 ? "" : "s") · @t.Screens.Sum(s => s.SpotCount) spots
                        </MudText>
                        @if (t.SeasonOpensOn is not null || t.SeasonClosesOn is not null)
                        {
                            <MudText Typo="Typo.body2" Class="muted">Season: @Seasons.Describe(t)</MudText>
                        }
                    </div>
                    <div class="pa-3 pt-0">
                        <MudButton Href="@($"theaters/{t.Slug}")" Variant="Variant.Outlined" Color="Color.Primary" FullWidth>Showings &amp; tickets</MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Theater>? theaters;

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync() => theaters = await Theaters.ListActiveAsync((await AuthState).User);

    internal static string Location(Theater t) =>
        string.Join(", ", new[] { t.City, t.State }.Where(s => !string.IsNullOrWhiteSpace(s)));
}
