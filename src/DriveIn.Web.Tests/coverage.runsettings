<?xml version="1.0" encoding="utf-8"?>
<!-- Picked up by `dotnet test` with the "XPlat Code Coverage" collector (see RunSettingsFilePath in the csproj).
     EF migrations are generated snapshots, not code we write or test, so they're left out of the report. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[DriveIn.Web]*</Include>
          <ExcludeByFile>**/Data/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
